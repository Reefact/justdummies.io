---
import Page from '../../layouts/Page.astro';
import { useTranslations } from '../../i18n/ui';
import { site } from '../../site';

/** The French twin of /404.html. See the note there. */
const t = useTranslations('fr');
---

<Page title={`${t('notfound.title')} — ${site.name}`} description={t('notfound.body')} noindex>
    <h2>{t('notfound.title')}</h2>
    <p class="body">{t('notfound.body')}</p>

    {/* Empty `alt` and intrinsic dimensions, for the reasons written out on the English
        twin. Same file: the mark belongs to the product, not to one language. */}
    <img class="crash" src="/404.png" alt="" width="1253" height="637" decoding="async" />

    <p><a href="/fr/">{t('notfound.home')}</a></p>
</Page>

<style>
    h2 {
        font-size: var(--jd-text-xl);
        line-height: var(--jd-line-tight);
        margin: 0 0 var(--jd-space-4);
    }

    .body {
        color: var(--jd-text-muted);
        max-width: 46rem;
    }

    /* See the English twin. */
    .crash {
        display: block;
        width: 100%;
        height: auto;
        margin: var(--jd-space-8) 0;
    }
</style>
