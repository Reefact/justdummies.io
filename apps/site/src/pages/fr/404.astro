---
import Page from '../../layouts/Page.astro';
import { useTranslations } from '../../i18n/ui';
import { site } from '../../site';

/** The French twin of /404.html. See the note there. */
const t = useTranslations('fr');
---

<Page title={`${t('notfound.title')} — ${site.name}`} description={t('notfound.body')} noindex tightBottom>
    {/* Empty `alt` and intrinsic dimensions, for the reasons written out on the English
        twin. Same file: the mark belongs to the product, not to one language. */}
    <img class="crash" data-dummy src="/dummy-404.webp" alt="" width="1253" height="626" decoding="async" />

    <p class="body">{t('notfound.body')} <a href="/fr/">{t('notfound.home')}</a></p>
</Page>

<style>
    .body {
        color: var(--jd-text-muted);
        font-style: italic;
        max-width: 46rem;
    }

    /* See the English twin. */
    .crash {
        display: block;
        width: 100%;
        height: auto;
        margin: var(--jd-space-4) 0;
    }
</style>
