---
/**
 * /fr/version — la même page, en français.
 *
 * Rien ne pointe vers elle aujourd'hui. C'est un fait sur la navigation du site, pas une
 * propriété de la page : elle déclare sa canonique et sa traduction comme n'importe quelle
 * autre, donc le jour où quelque chose y mènera, rien ici n'aura à changer.
 */
import VersionContent from '../../components/VersionContent.astro';
import Page from '../../layouts/Page.astro';
import { useTranslations } from '../../i18n/ui';
import { site } from '../../site';

const t = useTranslations('fr');
---

<Page title={`${t('version.heading')} — ${site.name}`} description={t('version.meta.description')}>
    <VersionContent />
</Page>
