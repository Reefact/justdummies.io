---
/**
 * One `/docs` topic. Routes come from `docsNav.ts` (see the section index page's own
 * comment) rather than a file per topic, and `apps/site/src/i18n/routing.ts` carries the
 * same list.
 */
import { getCollection, render } from 'astro:content';
import DocsTopicBody from '../../../components/DocsTopicBody.astro';
import DocsPage from '../../../layouts/DocsPage.astro';
import { useTranslations } from '../../../i18n/ui';
import type { DocsSection } from '../../../docsNav';
import { site } from '../../../site';

const locale = 'en';

export async function getStaticPaths() {
    const entries = await getCollection('docs', (entry) => entry.data.locale === 'en');

    return entries.map((entry) => {
        const siblings = entries
            .filter((sibling) => sibling.data.section === entry.data.section)
            .sort((left, right) => left.data.order - right.data.order);
        const position = siblings.findIndex((sibling) => sibling.data.slug === entry.data.slug);

        return {
            params: { section: entry.data.section, slug: entry.data.slug },
            props: {
                entry,
                topics: siblings.map((sibling) => ({ slug: sibling.data.slug, title: sibling.data.title })),
                previous: position > 0 ? siblings[position - 1] : null,
                next: position < siblings.length - 1 ? siblings[position + 1] : null,
            },
        };
    });
}

interface Props {
    entry: Awaited<ReturnType<typeof getCollection<'docs'>>>[number];
    topics: ReadonlyArray<{ slug: string; title: string }>;
    previous: { data: { slug: string; title: string } } | null;
    next: { data: { slug: string; title: string } } | null;
}

const { entry, topics, previous, next } = Astro.props;
const { Content } = await render(entry);
const t = useTranslations(locale);
const section = entry.data.section as DocsSection;
---

<DocsPage
    title={`${entry.data.title} — ${t(`docs.section.${section}.label`)} — ${site.name}`}
    description={entry.data.title}
    activeSection={section}
    activeSlug={entry.data.slug}
    topics={topics}
>
    <h2>{entry.data.title}</h2>
    <DocsTopicBody
        locale={locale}
        section={section}
        sourceUrl={entry.data.sourceUrl}
        ref={entry.data.ref}
        previous={previous !== null ? previous.data : null}
        next={next !== null ? next.data : null}
    >
        <Content />
    </DocsTopicBody>
</DocsPage>
