---
import DownloadContent from '../../components/DownloadContent.astro';
import Page from '../../layouts/Page.astro';
import { DOWNLOAD_TRAIN_LABEL_KEY } from '../../download';
import { useTranslations } from '../../i18n/ui';
import { site } from '../../site';

const t = useTranslations('en');
const label = t(DOWNLOAD_TRAIN_LABEL_KEY.cli);
---

<Page
    title={`${label} — ${t('download.heading')} — ${site.name}`}
    description={`${label} — ${t('download.meta.description')}`}
>
    <DownloadContent locale="en" active="cli" />
</Page>
