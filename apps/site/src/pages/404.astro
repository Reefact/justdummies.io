---
import Base from '../layouts/Base.astro';
import { useTranslations } from '../i18n/ui';
import { site } from '../site';

/**
 * Served by Workers for any request matching no asset (`not_found_handling:
 * "404-page"`). The locale is fixed rather than derived from the URL: this page
 * answers under an address that does not exist, so the path proves nothing about
 * what the visitor reads. `/fr/404.html` is the French twin, and Cloudflare
 * serves the *nearest* one, so a mistyped French URL lands on it.
 */
const t = useTranslations('en');
---

<Base title={`${t('notfound.title')} — ${site.name}`} description={t('notfound.body')} noindex>
    <main class="shell">
        <h1>{t('notfound.title')}</h1>
        <p class="body">{t('notfound.body')}</p>

        {/*
          `alt=""`, on purpose. The picture says what the heading and the sentence above it
          have already said, as a joke rather than in words — and the "404" it draws is a
          status code the response already carries. A screen reader announcing it would be
          reading the same page a third time.

          The width and height are the file's own, so the box is reserved before the image
          lands and the link below does not jump out from under a pointer on its way in. Not
          lazily loaded: here it is above the fold, and deferring it would only move the jump
          later.
        */}
        <img class="crash" src="/404.png" alt="" width="1253" height="637" decoding="async" />

        <p><a href="/">{t('notfound.home')}</a></p>
    </main>
</Base>

<style>
    .shell {
        max-width: 60rem;
        margin: 0 auto;
        padding: var(--jd-space-16) var(--jd-space-4);
    }

    h1 {
        font-size: var(--jd-text-xl);
        line-height: var(--jd-line-tight);
        margin: 0 0 var(--jd-space-4);
    }

    .body {
        color: var(--jd-text-muted);
        max-width: 46rem;
    }

    /* Narrower than the prose it sits under: it is the page's joke, not the page's subject,
       and at its own 1253 pixels it would be the only thing on the screen. `height: auto`
       with the intrinsic attributes above keeps the reserved box the right shape at every
       width. */
    .crash {
        display: block;
        width: 100%;
        max-width: 36rem;
        height: auto;
        margin: var(--jd-space-8) 0;
    }
</style>
