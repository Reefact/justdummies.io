---
/**
 * One release, as a reader reads it: what names it, when it shipped, why it happened, and
 * every rubric of bullets under that.
 *
 * TWO SECTIONS RENDER RELEASES AND NEITHER OWNS THIS. `/release-notes/{train}/v{major}`
 * shows the library's, mirrored from another repository (ADR-0019); `/version` shows this
 * site's own newest one. They agree on what a release looks like and on nothing else, which
 * is why what varies between them arrives as a prop rather than as a second component: two
 * cards would drift, and the drift would be a bullet indented one way here and another way
 * there.
 *
 * WHAT VARIES IS THE DECORATION, and all of it is optional. A library version carries a
 * maturity — `preview`, `stable` — because its semver says so; a release tag of this site is
 * a timestamp and says nothing of the kind. A library release links to the GitHub release
 * that published it; this site's page has nothing to link that would still be there. An
 * anchor exists where a table of contents points at one, and nowhere else. Absent, each is
 * simply not drawn — never drawn empty.
 *
 * THE PROSE IS ITS SOURCE'S, ALREADY TRANSLATED, and arrives as HTML: rubric labels come
 * through in the reader's own locale, emoji included, so nothing here maps a category to a
 * key. The emoji is also what tells one rubric from another at a glance, which is why no
 * label is coloured — a transcript in six colours starts to look composed (base.css's own
 * words). The only thing this component translates is the "view on GitHub" affordance,
 * which is the site's own word rather than the release's — and the new-tab note below, for
 * the same reason: the generator knows which links leave the site, this knows the words.
 */
import { formatReleaseDate } from '../i18n/dates';
import { useTranslations, type Locale } from '../i18n/ui';

/**
 * Says out loud, to a reader who cannot see it, that a link opens elsewhere.
 *
 * The 79 outbound links the rest of this site draws all carry this note, written into the
 * markup beside them. The ones inside a release's prose could not: they arrive as finished
 * HTML from a build script that has no locale, so within a single card a screen reader
 * announced the tag link and stayed silent on the five links in the bullets above it.
 *
 * Regex over HTML, deliberately and narrowly. This is not parsing the web's HTML — it is
 * matching the output of one function, `inlineHtml` in scripts/lib/release-notes-markdown.mjs,
 * which emits `target="_blank"` on outbound links and nothing else, escapes every `<` and `"`
 * in the text it wraps, and cannot nest one anchor inside another. The shape is known because
 * the same repository writes it.
 */
function announceNewTabs(html: string, note: string): string {
    return html.replace(
        /(<a [^>]*target="_blank"[^>]*>)(.*?)(<\/a>)/g,
        (_match, open: string, text: string, close: string) =>
            `${open}${text}<span class="visually-hidden"> ${note}</span>${close}`,
    );
}

/** A `### Rubric` block — `✨ New`, `🐛 Fixes` — with the bullets written under it. */
export interface Rubric {
    readonly label: string;
    /** Where a table of contents points, when one does. */
    readonly anchor?: string | null;
    /** One entry per fact worth a line. Every string is ready-to-display HTML. */
    readonly items: readonly string[];
}

interface Props {
    locale: Locale;
    /** What names this release in its own heading: a semver for the library, a `release/*`
     *  tag for this site. Set in mono either way — both are identifiers, not prose. */
    name: string;
    /** ISO. Spelled for the reader by `formatReleaseDate`, never stored per language. */
    date: string;
    /** The release's own "why", when it wrote one — each entry one paragraph of HTML. */
    summaryHtml: readonly string[];
    sections: readonly Rubric[];
    /** `preview`, `stable` — a semver's own word for itself, where the version has one. */
    maturity?: string | null;
    anchor?: string | null;
    /** Where this exact release lives on GitHub, for a page that has one to point at. */
    tagUrl?: string | null;
}

const { locale, name, date, summaryHtml, sections, maturity = null, anchor = null, tagUrl = null } = Astro.props;
const t = useTranslations(locale);
---

<article class="release" id={anchor ?? undefined}>
    <div class="release-head">
        <h3 class="version">{name}</h3>
        {maturity !== null && <span class="pill">{maturity}</span>}
        <span class="release-date">
            <time datetime={date}>{formatReleaseDate(date, locale)}</time>
        </span>
    </div>

    {
        summaryHtml.length > 0 && (
            <div class="summary">
                {summaryHtml.map((paragraph) => (
                    <p set:html={announceNewTabs(paragraph, t('state.newTab'))} />
                ))}
            </div>
        )
    }

    {
        sections.map((section) => (
            <section class="rubric" id={section.anchor ?? undefined}>
                <h4 class="rubric-label">{section.label}</h4>
                <ul class="bullets">
                    {section.items.map((item) => (
                        <li set:html={announceNewTabs(item, t('state.newTab'))} />
                    ))}
                </ul>
            </section>
        ))
    }

    {
        tagUrl !== null && (
            <div class="release-foot">
                <a href={tagUrl} target="_blank" rel="noopener noreferrer">
                    {t('releaseNotes.viewOnGithub')}
                    <svg class="arrow" viewBox="0 0 12 12" width="10" height="10" aria-hidden="true" focusable="false">
                        <path d="M3 9L9 3M4.5 3H9v4.5" />
                    </svg>
                    {/* One of these per release, so a page with two of them offers the same four words
                        twice behind two different tags. The version is what tells them apart, and it is
                        in the card's heading rather than in the link. */}
                    <span class="visually-hidden"> — {name}</span>
                    <span class="visually-hidden"> {t('state.newTab')}</span>
                </a>
            </div>
        )
    }
</article>

<style>
    .release {
        background: var(--jd-surface-raised);
        border: 1px solid var(--jd-border);
        border-radius: var(--jd-radius-lg);
        padding: var(--jd-space-6);
        /* So a jump from the table of contents lands with air above it rather than flush
           against the viewport's top edge. */
        scroll-margin-top: var(--jd-space-4);
    }

    .release-head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: var(--jd-space-1) var(--jd-space-3);
        margin-bottom: var(--jd-space-4);
    }

    .version {
        font-family: var(--jd-font-mono);
        font-size: var(--jd-text-lg);
        font-weight: 600;
        margin: 0;
        /* A `release/*` tag is a timestamp with nowhere to break, and it is a heading rather
           than a table cell here — the same hazard VersionContent.astro's commit column has,
           in the one place a phone is narrowest. */
        overflow-wrap: anywhere;
    }

    .pill {
        font-size: var(--jd-text-sm);
        color: var(--jd-text-muted);
        border: 1px solid var(--jd-border);
        border-radius: 999px;
        padding: 0.1em 0.65em;
        white-space: nowrap;
    }

    .release-date {
        margin-left: auto;
        font-family: var(--jd-font-mono);
        font-size: var(--jd-text-sm);
        color: var(--jd-text-muted);
        white-space: nowrap;
    }

    .summary {
        color: var(--jd-text-muted);
        margin-bottom: var(--jd-space-6);
    }

    .summary p {
        margin: 0 0 var(--jd-space-3);
    }

    .summary p:last-child {
        margin-bottom: 0;
    }

    .summary :global(strong) {
        color: var(--jd-text-primary);
        font-weight: 600;
    }

    .rubric {
        margin-bottom: var(--jd-space-6);
        scroll-margin-top: var(--jd-space-4);
    }

    .rubric:last-of-type {
        margin-bottom: 0;
    }

    .rubric-label {
        margin: 0 0 var(--jd-space-3);
        font-size: var(--jd-text-base);
        font-weight: 600;
        color: var(--jd-text-primary);
    }

    .bullets {
        margin: 0;
        padding: 0;
        list-style: none;
        display: grid;
        gap: var(--jd-space-3);
    }

    /* THE INDENT IS THE RUBRIC LABEL'S OWN, and it is in `em` rather than a space token
       because it is measured from a glyph: every label opens with an emoji whose advance
       is 1.248em followed by a space, so its first letter lands at 1.595em — in both
       locales, at every width the fluid --jd-text-base takes. A rem would hold that
       alignment at one size and lose it at the other. Dots at left: 0 sat under the
       emoji, which read as the icon column and the text column fighting over one edge;
       at 1.6em they hang below the words instead, and the icons keep the margin. */
    .bullets li {
        padding-left: 2.5em;
        position: relative;
        /* A bullet's longest word is a method name — `WithLengthBetween`, `IPoolInspection<T>`
           — with nowhere to break, and the list of cards is a grid, whose items do not shrink
           below their content's min-content width. So that longest token plus this padding is
           a floor under the whole card, and at 320px the card was already standing on it: the
           release notes pages went 34px sideways before this change and 55px after it, since
           the indent is part of the sum. `anywhere` rather than `break-word` on purpose —
           only `anywhere` lowers the min-content width, which is the number doing the damage
           (VersionContent.astro's commit hash, §11.7's source chips). */
        overflow-wrap: anywhere;
    }

    /* The dot takes the colour of the words beside it. On --jd-border it was three points
       of luminosity off the card it was drawn on — present in the markup, invisible on
       the screen — and six pixels rather than five is the same correction: at this size a
       marker reads as a speck long before it reads as loud.

       `0.8em` is half a line box (--jd-line-body is 1.6) and the 3px is half the dot, so
       it centres on the first line whatever size that line is set at. */
    .bullets li::before {
        content: '';
        position: absolute;
        left: 1.6em;
        top: calc(0.8em - 3px);
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--jd-text-primary);
    }

    /*
     * FORCED COLOURS REWRITE BACKGROUNDS, AND A MARKER PAINTED ONLY IN BACKGROUND DISAPPEARS.
     *
     * The dot is a 6px box whose whole appearance is its `background`. In a High Contrast theme
     * that resolves to the same colour as the card behind it — measured at 1.00:1 — and
     * `list-style: none` has already removed the native marker that would otherwise show
     * through, so the bullets lose their bullets and the text hangs at a 2.5em indent over an
     * empty margin. `CanvasText` is the system keyword for whatever that theme uses for text,
     * which is exactly what a marker beside text should be, and it is a keyword rather than a
     * value so the no-raw-colours rule holds. Nothing changes in the normal theme.
     */
    @media (forced-colors: active) {
        .bullets li::before {
            background: CanvasText;
        }
    }

    .bullets :global(strong) {
        color: var(--jd-text-primary);
        font-weight: 600;
    }

    .bullets :global(code) {
        font-family: var(--jd-font-mono);
        font-size: 0.9em;
        background: var(--jd-surface-sunken);
        border: 1px solid var(--jd-border);
        border-radius: var(--jd-radius-sm);
        padding: 0.05em 0.35em;
    }

    .release-foot {
        margin-top: var(--jd-space-6);
        padding-top: var(--jd-space-4);
        border-top: 1px solid var(--jd-border);
        font-size: var(--jd-text-sm);
    }

    .release-foot a {
        display: inline-flex;
        align-items: center;
        gap: var(--jd-space-1);
        color: var(--jd-text-muted);
    }

    .release-foot a:hover {
        color: var(--jd-accent);
    }

    .arrow {
        fill: none;
        stroke: currentColor;
        stroke-width: 1.5;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    /* .visually-hidden is declared once, globally, in base.css. */
</style>
