---
/**
 * What the site measures, in the three lanes §15 asks for (ADR-0012, ADR-0015).
 *
 * LANE ONE is Cloudflare Web Analytics: how many people come, and whether pages
 * load quickly (§15.1). It has no quota of any kind, so it is the half that cannot
 * stop. It sets no cookie and identifies nobody.
 *
 * LANE TWO is the dimensioned event §15.2 asks for, sent to this site's own
 * collector. It exists because lane one cannot carry it — Web Analytics has no
 * custom-event API — and because "people copy the install command" is not the
 * question the page was built to answer. "Which moment convinced them" is.
 *
 * LANE THREE is Google Analytics, and it answers the question neither of the others
 * can: not how many arrived or how many copied, but the path between the two — which
 * scene was reached, where a reader stopped, what they compared first. It is the only
 * lane that can recognise a returning browser, which is exactly why it is the only
 * lane that has to ask.
 *
 * THE THREE ARE INDEPENDENT ON PURPOSE, and the independence runs in both
 * directions. Lanes one and two ask nobody's permission and measure everyone, so a
 * refusal costs no audience figure and no conversion count; lane three is refused by
 * default and starts only on an explicit yes. Nothing a visitor does depends on any
 * of them. Lanes two and three are also two separate scripts below rather than one,
 * so that a fault in the newest lane cannot take the oldest one down with it.
 *
 * EACH LANE APPEARS ONLY WITH SOMEWHERE TO REPORT. Without a beacon token the
 * audience tag is not rendered; without a measurement id neither the analytics tag
 * nor the banner asking about it is. That is ADR-0004's rule applied to something
 * invisible: a preview build measures nothing rather than measuring into the wrong
 * account, and a build with the analytics lane switched off does not ask a question
 * it could not act on.
 */
import ConsentBanner from './ConsentBanner.astro';
import GoogleAnalytics from './GoogleAnalytics.astro';
import { googleAnalyticsId } from '../measurement';

/**
 * PUBLIC_ because it genuinely is. The token is rendered into every page's HTML and
 * is meant to be read; naming it as a secret would send the next maintainer to put
 * it in a secret store, where it would be masked in build logs for no reason.
 */
const beaconToken: string | undefined = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

{
    beaconToken && (
        <script
            is:inline
            defer
            src="https://static.cloudflareinsights.com/beacon.min.js"
            data-cf-beacon={JSON.stringify({ token: beaconToken })}
        />
    )
}

{googleAnalyticsId && <GoogleAnalytics id={googleAnalyticsId} />}
{googleAnalyticsId && <ConsentBanner />}

<script>
    /**
     * Forwards the copy event to the collector.
     *
     * IT LISTENS RATHER THAN BEING CALLED. `CopyableCommand` dispatches a DOM event
     * and deliberately knows nothing about who is listening, so the component stays
     * a component and this file is the only place that knows a collector exists.
     * Removing this file removes the measurement and breaks nothing else.
     *
     * IT IS FIRE-AND-FORGET, and that is what keeps §15 from ever costing a visitor
     * anything. `sendBeacon` hands the request to the browser and returns; there is
     * no await, no retry, no queue that could grow, and no branch that reads the
     * response — because by the time this runs, the command is already on the
     * clipboard and the visitor is already gone.
     */
    const ENDPOINT = '/_event';

    interface Copied {
        placement?: string;
        variant?: string;
    }

    /**
     * The ordinal §15.3 permits as a secondary field, and nothing more than that.
     *
     * It is derived here rather than carried in the event, so that no component has
     * to know its own position and no identifier can quietly become position-shaped.
     * The collector stores it among the measured numbers rather than the grouping
     * dimensions, which is where §15.3's prohibition actually lives: the page has
     * gone from eleven scenes to fourteen once already, and an event keyed on
     * position would have made the two periods incomparable.
     *
     * -1 when the block cannot be found, which reads as "unknown" rather than as
     * "first" — the value a plain `findIndex` miss would otherwise be mistaken for.
     */
    function ordinalOf(placement: string): number {
        const blocks: HTMLElement[] = Array.from(document.querySelectorAll<HTMLElement>('[data-install-tabs]'));

        return blocks.findIndex((block: HTMLElement) =>
            Array.from(block.querySelectorAll<HTMLElement>('[data-placement]')).some(
                (marked: HTMLElement) => marked.dataset.placement === placement,
            ),
        );
    }

    document.addEventListener('jd:install-command-copied', (event: Event) => {
        const detail: Copied = (event as CustomEvent<Copied>).detail ?? {};
        const placement: string | undefined = detail.placement;
        const variant: string | undefined = detail.variant;

        if (placement === undefined || variant === undefined) {
            return;
        }

        const body: string = JSON.stringify({
            event: 'install-command-copied',
            placement,
            variant,
            // The document's own language, which is the locale the reader chose. Two
            // letters, never a region: what a dashboard needs to know is which half of
            // the site convinced somebody, not where they were sitting.
            locale: document.documentElement.lang,
            ordinal: ordinalOf(placement),
        });

        // A Blob rather than a bare string, so the request carries a JSON content type
        // and the collector can parse it without guessing. Same origin, so none of this
        // involves CORS.
        navigator.sendBeacon(ENDPOINT, new Blob([body], { type: 'application/json' }));
    });
</script>

<script>
    /**
     * The consent gate, and the journey events that run behind it (lane three).
     *
     * NOTHING HERE REACHES GOOGLE UNTIL SOMEBODY SAYS YES. The tag's bootstrap
     * declares every consent signal denied and loads no Google script; this file is
     * the only caller of the function that starts it. That is "basic" consent mode
     * rather than the advanced one, and the difference is not cosmetic: advanced mode
     * would send cookieless pings before an answer, which is still a transfer to
     * Google without a legal basis for it.
     *
     * THE ADVERTISING SIGNALS ARE NEVER TOUCHED. Only `analytics_storage` is ever
     * updated. Since June 2026 `ad_storage` is the sole thing keeping tag data out of
     * Google Ads, so it stays denied for everyone, including a visitor who accepts.
     *
     * IT RUNS ON EVERY PAGE, INCLUDING PAGES WITH NO BANNER. Builds with the
     * analytics lane switched off render neither the tag nor the banner, and this
     * script then finds nothing to wire and does nothing — which is why it carries no
     * Google host of its own and can be bundled unconditionally.
     */
    const STORAGE_KEY = 'jd:analytics-consent';

    /**
     * Six months, after which the banner asks again. It is the retention the CNIL
     * recommends for a consent record, and it doubles as the answer to the one thing
     * local storage cannot do: it has no expiry of its own, so the expiry has to be
     * part of the value and checked on the way out.
     */
    const REMEMBER_FOR_MS = 15778800000;

    /**
     * How far into the future a stored `at` is still trusted. A clock a few minutes fast
     * when a choice was written is ordinary drift; a record dated further out than that has
     * no genuine claim to being current, and untrusted is what keeps it from making the
     * six-month retention effectively permanent — `Date.now() - at` would otherwise stay
     * negative, and therefore under the retention window, for as long as `at` stays ahead.
     */
    const CLOCK_SKEW_TOLERANCE_MS = 300000;

    /**
     * How often a granted session re-checks the retention window on its own, so a tab that
     * never triggers a custom report and never goes hidden then visible still catches an
     * expiry. Not the retention window itself: `setTimeout` overflows its own 32-bit delay
     * long before six months, so this reschedules itself instead of trying to wait the whole
     * span in one call. A day is far tighter than the six-month window needs.
     */
    const EXPIRY_CHECK_MS = 86400000;

    /**
     * How long a scene must hold the middle of the viewport before it counts as read.
     * Without it, one flick of the wheel reports all sixteen scenes and the funnel
     * says every reader read everything — which is the same as measuring nothing.
     */
    const DWELL_MS = 1000;

    /**
     * Where the reading band starts and ends, as a fraction of the viewport from each edge.
     * It mirrors the `-45%` root margin `Scene.astro` gives its observer, and mirroring it is
     * the point: that component decides when a scene has arrived and this file decides whether
     * it is still there, so the two asking about different regions loses exactly the scenes a
     * reader came to rest on. Changing one without the other is the defect, and the number
     * lives here under a name so that the next person to move it sees there are two ends to it.
     */
    const BAND_EDGE = 0.45;

    type Answer = 'granted' | 'denied';

    interface Remembered {
        v: number;
        choice: Answer;
        at: number;
    }

    interface SceneEntered {
        scene?: string;
        act?: string;
    }

    interface Copied {
        placement?: string;
        variant?: string;
    }

    /**
     * The two globals the inline bootstrap publishes. Typed here rather than declared
     * on `Window`, because a `declare global` needs a module and this script is not
     * one — and because naming them at their single point of use says plainly that
     * this file and `GoogleAnalytics.astro` are the two halves of one mechanism.
     */
    const tag = window as unknown as {
        jdAnalyticsStart?: () => void;
        jdAnalyticsStop?: () => void;
        gtag?: (...args: unknown[]) => void;
    };

    const banner = document.querySelector<HTMLElement>('[data-consent]');
    const status = document.querySelector<HTMLElement>('[data-consent-status]');
    const reopen = document.querySelector<HTMLElement>('[data-consent-reopen]');

    let reporting = false;
    let returnFocusTo: HTMLElement | null = null;
    let expiryCheck: number | undefined;

    /**
     * Whether the banner is up because the visitor asked for it, rather than because nothing
     * has been answered yet.
     *
     * The two are indistinguishable from the stored answer alone — a visitor reopening the
     * question from the privacy page has an answer on record by definition — so without this,
     * every reconciliation wants to close the dialogue they just opened. Those are not rare
     * events: coming back to the tab is one, and so is the periodic re-check. The question
     * would vanish mid-thought, with nothing announced and focus dropped to the body, and the
     * visitor would have to notice and press the control again.
     */
    let asking = false;

    /**
     * Every binding `start()` can reach, declared up here rather than beside the journey
     * tracking it belongs to.
     *
     * `start()` can run as early as this document's first synchronous pass, from
     * `applyDecision()` reading a grant already on record, and it reaches from there into the
     * journey code through `reportHeldScene()`. A `let` or `const` declared after that point is
     * still in its temporal dead zone; reading one throws, and the throw lands inside the
     * consent setup — so everything registered after it, the storage listener above all, never
     * exists. The tag is already loaded and reporting by then, which makes the cost a
     * withdrawal that can no longer arrive rather than a measurement that goes missing.
     *
     * THE SET IS WHAT `start()` REACHES TRANSITIVELY, and getting that wrong is what this
     * comment is really for. It first named only `scenes` and the two sets, which was the whole
     * reachable set on the day it was written — `reportHeldScene()` called `reportScene()`
     * directly. Making it respect the dwell delay pointed it at `armDwell()` instead, one
     * review round later, and `armDwell()`'s first statement reads `dwelling`. The hazard was
     * understood and written down, and the fix for something else walked straight back into it.
     */
    const scenes: HTMLElement[] = Array.from(document.querySelectorAll<HTMLElement>('[data-scene]'));
    const seenScenes = new Set<string>();
    const seenActs = new Set<string>();
    let dwelling: number | undefined;

    /**
     * What `remembered()` falls back to when storage itself is the thing that failed.
     *
     * A browser that throws on `setItem` throws on `getItem` too, so without this a
     * choice `remember()` just made could not survive the page's own next read: the
     * following `visibilitychange` would find nothing, stop an accepted session mid-page,
     * and reopen a banner that was already answered. Storage is still consulted first
     * everywhere below — this is only reached when it has nothing to say.
     */
    let inMemoryAnswer: Answer | undefined;

    /**
     * Whether the last write attempt failed — set by `remember()`, read by `remembered()`.
     *
     * A failed write leaves the stored record stale rather than absent, and a stale record
     * still reads back successfully: without this, `remembered()` would trust it over the
     * fresher in-memory answer just because the read itself worked, letting a withdrawal
     * be undone by the grant still on disk. It has to be a flag rather than "prefer memory
     * whenever it is set": once storage is working again, a genuinely empty read — another
     * tab's `localStorage.clear()`, most notably — has to mean unanswered, not "fall back
     * to whatever this tab decided earlier."
     */
    let storageIsUnreliable = false;

    /**
     * Every read and every write is guarded. This is the first persistent state this
     * site has ever written, and local storage throws rather than returning null in a
     * browser configured to refuse it — so an unguarded read would take the banner
     * down with it and leave the page with a question nobody can answer.
     */
    function remembered(): Answer | undefined {
        try {
            const raw: string | null = window.localStorage.getItem(STORAGE_KEY);

            if (raw === null) {
                return storageIsUnreliable ? inMemoryAnswer : undefined;
            }

            const parsed: Remembered = JSON.parse(raw) as Remembered;

            if (
                parsed.v !== 1 ||
                (parsed.choice !== 'granted' && parsed.choice !== 'denied') ||
                !Number.isFinite(parsed.at) ||
                parsed.at > Date.now() + CLOCK_SKEW_TOLERANCE_MS
            ) {
                // A timestamp that fails to parse is not "very old" — `Date.now() - NaN` is
                // `NaN`, and `NaN > REMEMBER_FOR_MS` is false, so the retention check below
                // would wave a corrupted record through as a live grant. A timestamp dated
                // into the future has the same effect from the other side: the subtraction
                // stays negative, and therefore under the retention window, for as long as it
                // does — making the six-month re-prompt postponable by however far it is
                // dated out. Both are treated the same as any other malformed record: not a
                // valid answer at all.
                return inMemoryAnswer;
            }

            if (storageIsUnreliable) {
                return inMemoryAnswer;
            }

            // An answer older than the retention reads as no answer, so the banner
            // returns rather than a decade-old yes standing in for a live one.
            return Date.now() - parsed.at > REMEMBER_FOR_MS ? undefined : parsed.choice;
        } catch {
            return inMemoryAnswer;
        }
    }

    function remember(choice: Answer): void {
        inMemoryAnswer = choice;

        try {
            const value: Remembered = { v: 1, choice, at: Date.now() };

            window.localStorage.setItem(STORAGE_KEY, JSON.stringify(value));
            storageIsUnreliable = false;
        } catch {
            // Storage refused the write; the in-memory fallback above keeps the choice
            // for this page, and the banner will simply ask again next time.
            storageIsUnreliable = true;

            if (choice === 'denied') {
                // The in-memory fallback does not survive navigation — a fresh page starts
                // with none of it — so a grant already on record would otherwise still be
                // there to read, undoing this withdrawal the moment the visitor moves on.
                // Removing costs no quota the way writing does, so it succeeds even when the
                // write that prompted it could not; a granted choice has no such record to
                // strip, since the fail-closed default is already "not reporting".
                try {
                    window.localStorage.removeItem(STORAGE_KEY);
                } catch {
                    // Nothing more storage can do; this page's in-memory answer still holds.
                }
            }
        }
    }

    /**
     * Re-arms the periodic expiry re-check, on every call rather than only the first.
     *
     * Called from `start()` before its own guard, deliberately: that guard exists to stop
     * the tag being started twice, and reusing it here would also stop the schedule being
     * renewed twice — which is the one thing that has to happen every time, including on
     * the very call this function's own timeout makes back into `start()` once reporting is
     * already `true`. Without the split, the chain would fire once and never re-arm itself.
     */
    function scheduleExpiryCheck(): void {
        window.clearTimeout(expiryCheck);
        // Wrapped rather than passed by name, so the schedule cannot start supplying arguments
        // to a function that now reads its first one.
        expiryCheck = window.setTimeout(() => applyDecision(), EXPIRY_CHECK_MS);
    }

    function start(): void {
        if (tag.jdAnalyticsStart === undefined) {
            return;
        }

        scheduleExpiryCheck();

        if (reporting) {
            return;
        }

        reporting = true;
        tag.jdAnalyticsStart();
        reportHeldScene();
    }

    /**
     * Withdrawal, which has to reach the loaded tag and not merely this file.
     *
     * Silencing `track` is the easy half. The hard half is that by the time somebody
     * withdraws, Google's own script may be loaded — and revoking the consent signal
     * alone does not stop it, it puts it into cookieless-ping mode, which is the one
     * behaviour ADR-0015 rejects by name. `jdAnalyticsStop` raises Google's documented
     * opt-out flag, which the tag reads before sending anything at all.
     */
    function stop(): void {
        reporting = false;
        window.clearTimeout(expiryCheck);
        tag.jdAnalyticsStop?.();
    }

    /**
     * Reports one event, and says whether it actually went.
     *
     * The return value exists for the dedup sets: a caller that marks something reported has to
     * know that it was, and both refusals below are reachable long after the caller last
     * checked. Returning nothing let a lapsed grant spend a scene on a report that was never
     * sent — and the scene stayed spent after the visitor accepted again.
     */
    function track(name: string, parameters: Record<string, unknown>): boolean {
        // Gated on the answer rather than on the tag's presence, so that an event
        // fired between a refusal and the next page load cannot queue up waiting for
        // a `config` that is never coming.
        if (!reporting || tag.gtag === undefined) {
            return false;
        }

        // Re-read rather than trusted from whenever start() last ran. The six-month
        // retention is otherwise only ever rechecked on a storage event or on becoming
        // visible again — nothing revisits it for a tab that simply never goes anywhere,
        // and scheduling a timer for six months out isn't reliable either: that delay
        // overflows setTimeout's own 32-bit limit long before it would fire. This is the
        // one place every report already passes through, so it costs nothing extra to ask.
        if (remembered() !== 'granted') {
            applyDecision();

            return false;
        }

        tag.gtag('event', name, { ...parameters, content_locale: document.documentElement.lang });

        return true;
    }

    function show(): void {
        if (banner === null) {
            return;
        }

        asking = true;
        returnFocusTo = document.activeElement instanceof HTMLElement ? document.activeElement : null;
        banner.hidden = false;
        banner.focus();
    }

    function answer(choice: Answer, announcement: string): void {
        asking = false;
        remember(choice);

        if (banner !== null) {
            banner.hidden = true;
        }

        if (status !== null) {
            status.textContent = announcement;
        }

        if (reopen !== null) {
            returnFocusTo = reopen;
        }

        if (returnFocusTo !== null) {
            returnFocusTo.focus();
            returnFocusTo = null;
        }

        if (choice === 'granted') {
            start();
        } else {
            stop();
        }
    }

    /**
     * Brings this document into line with the stored answer — the reporting and the
     * banner together, because they are two halves of one state and drifted apart twice.
     *
     * READ RATHER THAN REMEMBERED, and re-read rather than read once. The answer can
     * change without this document doing anything: another tab can write one, and the
     * six-month lifetime can expire under a tab that simply stayed open. A decision
     * consulted only at startup left this page reporting under a grant that had run out,
     * and left a second tab measuring while its own banner still asked the question.
     *
     * Called from the three moments where the stored answer and this page can disagree:
     * startup, another document writing, and this one coming back into view — plus a fourth
     * that this function arms for itself, since none of the first three are guaranteed to
     * happen again before six months are up.
     *
     * GRANTING WAITS FOR A VISIBLE TAB; WITHDRAWING NEVER DOES. `storage` reaches every
     * open document at once — accepting with three tabs open would start three tags in
     * the same instant, and two of them would fire `config`'s page_view from a document
     * nobody was reading. `visibilitychange` already calls this again on the tab that
     * deferred, so nothing is lost, only held until there is a page to attribute it to.
     *
     * THE PERIODIC RE-ARM LIVES IN `start()` AND `stop()`, NOT HERE, even though this
     * function is what the schedule calls back into. Enhanced measurement's `scroll` — left
     * on by the measurement plan on every route but the narrative — is Google's own script
     * watching the page, answering to nothing this file calls; only the `ga-disable` flag
     * `stop()` raises actually silences it, so the schedule has to survive a tab that
     * outlives its own grant without anything else happening to call this function again.
     * It was tried here first, and missed the ordinary path entirely: a first visitor
     * clicking Accept calls `start()` directly, never through this function, and would have
     * gone unscheduled — the most common way a session ever begins.
     */
    function applyDecision(elsewhere: boolean = false): void {
        const decided: Answer | undefined = remembered();

        if (decided === 'granted' && document.visibilityState === 'visible') {
            start();
        } else if (decided !== 'granted') {
            stop();
        }

        if (banner === null) {
            return;
        }

        if (decided === undefined) {
            // Guarded on `hidden` so that a repeat call does not take focus a second time.
            if (banner.hidden) {
                show();
            }
        } else if (!asking || elsewhere) {
            // A question the visitor opened themselves is theirs to close, so the reconciliation
            // leaves it alone — except when the answer arrived from another document, which is
            // what `elsewhere` says. That one is not this tab overruling them: they have just
            // answered the same question somewhere else, and leaving it up here would ask twice.
            asking = false;
            banner.hidden = true;
        }
    }

    if (banner !== null) {
        const accept = banner.querySelector<HTMLElement>('[data-consent-accept]');
        const refuse = banner.querySelector<HTMLElement>('[data-consent-refuse]');
        const accepted: string = accept?.dataset.announce ?? '';
        const refused: string = refuse?.dataset.announce ?? '';

        accept?.addEventListener('click', () => answer('granted', accepted));
        refuse?.addEventListener('click', () => answer('denied', refused));

        // Escape refuses rather than dismissing without an answer. Dismissing would
        // leave the question open and bring the banner back on the next page, which
        // reads as nagging; recording the refusal is what makes "no" as cheap as
        // "yes", which is the whole of the parity rule.
        banner.addEventListener('keydown', (event: KeyboardEvent) => {
            if (event.key === 'Escape') {
                answer('denied', refused);
            }
        });

        applyDecision();

        // The privacy page's way back in. Hidden in the markup for the same reason the
        // banner is: a button that reopens a dialogue is dead without scripting.
        if (reopen !== null) {
            reopen.hidden = false;
            reopen.addEventListener('click', show);
        }
    }

    /**
     * The same answer, applied in every other tab the visitor has open.
     *
     * `localStorage` is shared across an origin's documents but changing it notifies
     * nobody by itself — the `storage` event does, and it fires in every document except
     * the one that wrote. Without this, a visitor with the site open twice who withdraws
     * in one tab leaves the other still reporting, with Google still holding a granted
     * signal. The privacy page promises that refusing stops the collection; it does not
     * say "in this tab", and it should not have to.
     *
     * Symmetric on purpose: accepting elsewhere starts this tab too, so the two never
     * disagree in either direction. A cleared key reads as no consent, which stops —
     * and `key === null` is also a clear, the one `localStorage.clear()` sends instead of
     * naming this key on its own. A tab already reporting would otherwise never learn
     * everything was wiped, and would simply keep going.
     */
    window.addEventListener('storage', (event: StorageEvent) => {
        if (event.key !== STORAGE_KEY && event.key !== null) {
            return;
        }

        // This event firing at all is proof a write just succeeded somewhere, whatever
        // this tab's own history of failed ones says — and without lowering the flag here,
        // a tab that once failed to write would keep preferring its own stale in-memory
        // answer over a value it can now read fresh and successfully, discarding exactly
        // the update this listener exists to react to.
        storageIsUnreliable = false;

        // The one caller that passes `elsewhere`: this answer came from another document, so a
        // banner the visitor had open here is closing because they answered, not despite it.
        applyDecision(true);
    });

    /**
     * And when this document comes back into view, because that is the moment a tab that
     * has been sitting for months is worth re-asking about. It is also the cheapest place
     * to notice an expiry: no timer to schedule, no cost while nobody is looking.
     */
    document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') {
            applyDecision();
        }
    });

    /**
     * The journey, keyed on the stable scene name and never on its position (§15.3).
     * The ordinal travels as a measured number, which is where GA4 will keep it if it
     * is registered as a metric rather than a dimension — the same separation the
     * collector makes by writing it among its doubles.
     *
     * Its one piece of state, `dwelling`, is declared with the rest of what `start()` reaches,
     * far above — see the comment there for why it cannot live down here.
     */
    function sceneOrdinal(name: string | undefined): number {
        return name === undefined ? -1 : scenes.findIndex((scene: HTMLElement) => scene.dataset.scene === name);
    }

    /**
     * Whether the scene is still in the band, asked at the moment the dwell expires.
     *
     * MEASURED RATHER THAN REMEMBERED, and the difference is the whole check. `Scene.astro`
     * reports arrivals only, and its `data-current` is sticky — it is cleared when another
     * scene takes over and at no other time. So a reader who reaches the last scene and
     * scrolls on into the footer leaves nothing behind that says they left: the attribute
     * stays set, no further arrival cancels the timer, and a dwell that never happened
     * would be reported as a read. Asking the geometry sidesteps both.
     *
     * THE SAME BAND `Scene.astro` WATCHES, and it has to be. That component's observer uses a
     * root margin of -45%, so it announces a scene the moment it touches the middle tenth of
     * the viewport; this asked the narrower question of whether the scene covered the exact
     * middle line. A scene resting in the 5% between the two was announced and then never
     * reported — and lost twice, because arming for it had already cancelled whatever was
     * pending and an observer announces a scene once. It landed precisely on readers who
     * stopped, which is the whole population the event was built to find.
     */
    function holdsTheBand(name: string): boolean {
        const scene: HTMLElement | undefined = scenes.find((candidate: HTMLElement) => candidate.dataset.scene === name);

        if (scene === undefined) {
            return false;
        }

        const box: DOMRect = scene.getBoundingClientRect();
        const height: number = window.innerHeight;

        return box.top < height * (1 - BAND_EDGE) && box.bottom > height * BAND_EDGE;
    }

    /**
     * Reports a scene, and the act it belongs to if this is the act's first — marking each seen
     * only once it has actually gone.
     *
     * The order is the point. `armDwell` already refuses to consume a scene while nothing is
     * being measured, for the reader who scrolls first and accepts afterwards; `track()` is a
     * second gate behind that one, and it can decline long after the first was passed — a grant
     * that lapses between arriving at a scene and the dwell expiring is exactly that. Marking
     * first spent the scene on a report nobody received, and spent it permanently: accepting
     * again could not bring it back, because `reportHeldScene()` skips what is already seen.
     * The act was worse, being shared — every later scene of it reported normally while
     * `act_reached` never fired, which reads as scenes belonging to an act nobody entered.
     */
    function reportScene(name: string, act: string | undefined): void {
        if (!track('scene_view', { scene_name: name, act: act ?? '', scene_ordinal: sceneOrdinal(name) })) {
            return;
        }

        seenScenes.add(name);

        if (act !== undefined && !seenActs.has(act) && track('act_reached', { act })) {
            seenActs.add(act);
        }
    }

    /**
     * One timer for the page, not one per scene: scrolling past ten scenes should arm the
     * eleventh, not report the first ten a second late.
     */
    function armDwell(name: string, act: string | undefined): void {
        window.clearTimeout(dwelling);
        dwelling = window.setTimeout(() => {
            if (!holdsTheBand(name)) {
                return;
            }

            // Nothing is consumed while nothing is measured. `track` would discard the
            // event anyway, but marking the scene seen before that would spend it: a
            // reader who scrolls first and accepts afterwards would have those scenes
            // silently struck off, and the acts with them.
            if (!reporting) {
                return;
            }

            reportScene(name, act);
        }, DWELL_MS);
    }

    /**
     * The scene a visitor was already reading when reporting starts, which the dwell timer
     * cannot report a second time: it already fired while unanswered, found nothing to
     * report, and consumed nothing — and `Scene.astro` dispatches `jd:scene-entered` only on
     * a fresh arrival, not because a script elsewhere started caring. Without this, a reader
     * who dwells on the first scene while deciding, then accepts without scrolling, never has
     * that scene enter `scene_view` at all — the scene likeliest to still be on screen the
     * moment the banner is answered.
     *
     * Arms the same dwell timer a fresh arrival would, rather than reporting on the spot: a
     * grant already on record starts analytics as early as this document's first synchronous
     * pass, and reporting immediately there would count a scene visible for a single instant —
     * exactly the flicker `DWELL_MS` exists to exclude everywhere else.
     *
     * Geometry rather than `data-current`, for the same reason `holdsTheBand` already is: the
     * act is derived the same way `Scene.astro` derives it for the event this stands in for.
     */
    function reportHeldScene(): void {
        const held: HTMLElement | undefined = scenes.find(
            (scene: HTMLElement) =>
                scene.dataset.scene !== undefined && !seenScenes.has(scene.dataset.scene) && holdsTheBand(scene.dataset.scene),
        );

        if (held === undefined) {
            return;
        }

        armDwell(held.dataset.scene as string, held.closest<HTMLElement>('.act')?.id);
    }

    document.addEventListener('jd:scene-entered', (event: Event) => {
        const detail: SceneEntered = (event as CustomEvent<SceneEntered>).detail ?? {};
        const scene: string | undefined = detail.scene;

        if (scene === undefined || seenScenes.has(scene)) {
            return;
        }

        armDwell(scene, detail.act);
    });

    // The same event lane two listens to, read a second time rather than re-emitted.
    document.addEventListener('jd:install-command-copied', (event: Event) => {
        const detail: Copied = (event as CustomEvent<Copied>).detail ?? {};

        if (detail.placement === undefined || detail.variant === undefined) {
            return;
        }

        // Found by walking the marked elements rather than by building a selector out of
        // the event's own payload: this listener is fed by a DOM event, and a DOM event is
        // something any script on the page can dispatch.
        const marked: HTMLElement | undefined = Array.from(
            document.querySelectorAll<HTMLElement>('[data-placement]'),
        ).find((candidate: HTMLElement) => candidate.dataset.placement === detail.placement);

        track('install_command_copied', {
            placement: detail.placement,
            variant: detail.variant,
            scene_ordinal: sceneOrdinal(marked?.closest<HTMLElement>('[data-scene]')?.dataset.scene),
        });
    });

    /**
     * One delegated listener for the three things a reader clicks on the way out.
     *
     * Delegation rather than a listener per element because two of these are rendered
     * five times over and the third does not exist on most pages — and because a
     * listener bound at load would miss nothing here but would have to be rebound the
     * day any of this becomes conditional.
     */
    document.addEventListener('click', (event: Event) => {
        // `Element` and not `HTMLElement`: the NuGet links carry an inline arrow, and a
        // click landing on the SVG or on its path has an `SVGElement` target. Narrowing to
        // HTMLElement returned early on exactly the clicks that follow the link, so the
        // event was missing for the visitors most decided about following it.
        const target: Element | null = event.target instanceof Element ? event.target : null;

        if (target === null) {
            return;
        }

        const nuget: HTMLAnchorElement | null = target.closest<HTMLAnchorElement>('a.nuget');

        if (nuget !== null) {
            // These carry a placement and a variant already, and have since they were
            // written; nothing has ever read them.
            track('nuget_link_clicked', {
                placement: nuget.dataset.placement ?? '',
                variant: nuget.dataset.variant ?? '',
                link_url: nuget.href,
            });

            return;
        }

        if (target.closest('[data-hero-run]') !== null) {
            // The strongest signal on the page: this is the click that agrees to
            // download a megabyte and a half to try the library in the browser.
            track('playground_started', {});
        }
    });

    // Emitted by the tab widget from its own state transition, so keyboard switches count
    // and re-selecting the current tab does not.
    document.addEventListener('jd:install-variant-switched', (event: Event) => {
        const detail: Copied = (event as CustomEvent<Copied>).detail ?? {};

        track('install_variant_switched', {
            placement: detail.placement ?? '',
            variant: detail.variant ?? '',
        });
    });

    document.querySelector<HTMLSelectElement>('[data-compare-select]')?.addEventListener('change', (event: Event) => {
        track('comparison_narrowed', { competitor: (event.target as HTMLSelectElement).value });
    });

    /**
     * The API search, reported once the typing settles rather than on every keystroke.
     * `view_search_results` is GA4's own name for this, which is what makes it show up
     * in the site-search report instead of as one more custom event nobody opens.
     */
    const search = document.querySelector<HTMLInputElement>('#api-search-input');

    if (search !== null) {
        const SETTLE_MS = 600;

        let settling: number | undefined;
        let pending = '';

        /** Reports the settled term, once. Emptying `pending` makes a second call a no-op. */
        function reportSearch(): void {
            if (pending === '') {
                return;
            }

            const term: string = pending;

            pending = '';
            track('view_search_results', { search_term: term });
        }

        search.addEventListener('input', () => {
            pending = search.value.trim();
            window.clearTimeout(settling);
            settling = window.setTimeout(reportSearch, SETTLE_MS);
        });

        /**
         * Sent before the page goes away, because the settle delay would otherwise swallow
         * the searches that worked.
         *
         * The results render as the visitor types, so the ones who find what they wanted
         * click a result well inside the settle window and navigate before the timer fires.
         * Those are precisely the successful searches — leaving only the slow and the
         * abandoned ones in the report, which is the opposite of what the measurement plan
         * says it wants to learn.
         *
         * Firing twice costs nothing: `reportSearch` empties the term.
         */
        function flushSearch(): void {
            window.clearTimeout(settling);
            reportSearch();
        }

        window.addEventListener('pagehide', flushSearch);

        /**
         * A click on a result, not `visibilitychange`. `hidden` used to stand in here for the
         * same click — `pagehide` alone was found unreliable for it on mobile — but `hidden`
         * fires on far more than a departure: a tab switch, a locked screen, a backgrounded
         * app the visitor returns to a moment later, still on this page. Flushing on those
         * sent an unsettled term as though it were final, and a visitor who came back and kept
         * typing then sent the real one behind it — partial and duplicate terms in a report
         * that documents itself as one settled term per search. A click on a result is the
         * same signal the click-through was ever a proxy for, earlier and unambiguous.
         */
        document.getElementById('api-search-results')?.addEventListener('click', (event: Event) => {
            if (event.target instanceof Element && event.target.closest('a') !== null) {
                flushSearch();
            }
        });
    }
</script>
