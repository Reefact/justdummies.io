---
/**
 * The /docs section's own sidebar: the four sections, and — inside a section — the topics
 * it holds, in reading order. Sibling of `ApiCategoryNav.astro`, trimmed to what `/docs`
 * actually needs: no member search, because a topic page is prose, not a member catalogue.
 *
 * Same collapse behaviour as `ApiCategoryNav.astro`, for the same reason (ADR-0004): a
 * native <details>/<summary> works before any script runs, and the script only narrows the
 * default to collapsed on a phone-width screen.
 */
import { pathForLocale } from '../i18n/routing';
import { useTranslations, type Locale } from '../i18n/ui';
import { DOCS_SECTIONS, DOCS_TOPICS, type DocsSection } from '../docsNav';

interface Props {
    locale: Locale;
    activeSection: DocsSection;
    /** '' outside a topic page — the section's own index. */
    activeSlug: string;
    /** The active section's topics, titled in this page's own locale, in reading order. */
    topics: ReadonlyArray<{ slug: string; title: string }>;
}

const { locale, activeSection, activeSlug, topics } = Astro.props;
const t = useTranslations(locale);

function docsPath(section: string, slug: string = ''): string {
    return pathForLocale(slug === '' ? `/docs/${section}` : `/docs/${section}/${slug}`, locale);
}

const sectionLabel: Record<DocsSection, string> = {
    guides: t('docs.section.guides.label'),
    generators: t('docs.section.generators.label'),
    packages: t('docs.section.packages.label'),
    analyzers: t('docs.section.analyzers.label'),
};
---

<details class="docs-nav" open>
    <summary>
        {t('docs.nav.toggle')}
        <svg class="chev" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
    </summary>
    <ul class="docs-nav-list">
        {
            DOCS_SECTIONS.map((section) => (
                <li>
                    <a href={docsPath(section)} aria-current={section === activeSection && activeSlug === '' ? 'page' : undefined}>
                        {sectionLabel[section]}
                    </a>
                    {section === activeSection && (
                        <ul class="docs-nav-sublist">
                            {(section === activeSection ? topics : DOCS_TOPICS[section].map((slug) => ({ slug, title: slug }))).map((topic) => (
                                <li>
                                    <a href={docsPath(section, topic.slug)} aria-current={topic.slug === activeSlug ? 'page' : undefined}>
                                        {topic.title}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    )}
                </li>
            ))
        }
    </ul>
</details>

<script is:inline>
    (function manageNarrowScreenCollapse() {
        const details = document.currentScript.previousElementSibling;

        if (!(details instanceof HTMLDetailsElement)) {
            return;
        }

        const narrowScreen = window.matchMedia('(max-width: 56rem)');

        if (narrowScreen.matches) {
            details.open = false;
        }

        narrowScreen.addEventListener('change', (event) => {
            if (!event.matches) {
                details.open = true;
            }
        });
    })();
</script>

<style>
    .docs-nav {
        position: sticky;
        top: var(--jd-space-6);
        align-self: start;
        max-height: calc(100vh - 2 * var(--jd-space-6));
        overflow-y: auto;
        /*
         * `overflow-y: auto` is also a clip box, and these links sit flush against its left
         * edge — so a keyboard focus ring, drawn 2px outside the focused link
         * (`outline-offset: 2px` in base.css), loses its left side to the clip. Same thing
         * `ApiCategoryNav.astro` and `ReleaseNotesContents.astro` meet, same answer: push the
         * clip box out by the ring's width, pull the box back with a matching negative margin.
         */
        padding-left: 4px;
        margin-left: -4px;
    }

    /*
     * The disclosure is a phone control, not a heading. Past the breakpoint the sidebar is an
     * ordinary sticky column and "Documentation sections" is a label for a fold that cannot
     * happen — `ApiCategoryNav.astro` hides its own summary there for that reason, and this one
     * sat visible on every desktop /docs page announcing a control nobody could use.
     *
     * Hiding it is what makes the script's resize listener load-bearing rather than a nicety:
     * past the breakpoint the summary is the only thing that can reopen a closed `<details>`,
     * so a rotation or a resize that crosses it has to force `open` back on.
     */
    .docs-nav > summary {
        display: none;
    }

    .docs-nav .chev {
        width: 1rem;
        height: 1rem;
        transition: transform 0.15s ease;
    }

    .docs-nav[open] summary .chev {
        transform: rotate(180deg);
    }

    .docs-nav-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.125rem;
    }

    /* A sidebar is a list of destinations, and underlining all of them is the noise
       `ApiCategoryNav.astro` already avoids. Same box as its entries, too: the padding and the
       rail are what give the current page somewhere to be marked. */
    .docs-nav-list > li > a {
        display: block;
        padding: var(--jd-space-2) var(--jd-space-3);
        border-left: 2px solid transparent;
        border-radius: 0 var(--jd-radius-sm) var(--jd-radius-sm) 0;
        color: var(--jd-text-primary);
        font-weight: 600;
        text-decoration: none;
    }

    .docs-nav-list > li > a:hover {
        color: var(--jd-accent);
    }

    /*
     * WHERE THE READER IS STANDING, in `ApiCategoryNav.astro`'s own terms: a ground, an accent
     * rail, and the weight the entry already had. Two things are deliberate about it.
     *
     * `> li > a` rather than the plain descendant `.docs-nav-list a` this rule used to carry:
     * with Astro's scoping attribute added to every compound, the base rule above out-specified
     * it (0,4,2 against 0,4,1) and the current section drew like any other. Nothing showed it
     * while every entry was underlined anyway.
     *
     * AND THE RAIL IS WHAT SURVIVES A PALETTE IT DOES NOT CHOOSE. Every entry here is already
     * bold, so weight cannot separate one from the rest, and colour alone says nothing to a
     * reader who cannot part the two hues — nor under forced colours, which replaces the accent
     * and drops the ground entirely. A border does not drop: `transparent` is preserved there,
     * so the marked entry keeps a bar its neighbours do not have. `aria-current` carries the
     * same state to assistive technology.
     */
    .docs-nav-list > li > a[aria-current='page'] {
        border-color: var(--jd-accent);
        background: color-mix(in srgb, var(--jd-accent) 8%, transparent);
    }

    /* The active section's own topics — one level down, so they read as belonging to the
       section above them rather than as siblings in the same list. The indent is the entries'
       own padding rather than a rule down the side of the list: with each entry carrying the
       rail the current one needs, a second line beside them would be one line too many. */
    .docs-nav-sublist {
        list-style: none;
        margin: 0.125rem 0 var(--jd-space-2);
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.125rem;
    }

    .docs-nav-sublist a {
        display: block;
        padding: var(--jd-space-1) var(--jd-space-3) var(--jd-space-1) calc(var(--jd-space-3) + var(--jd-space-4));
        border-left: 2px solid transparent;
        border-radius: 0 var(--jd-radius-sm) var(--jd-radius-sm) 0;
        color: var(--jd-text-muted);
        font-size: var(--jd-text-sm);
        text-decoration: none;
    }

    .docs-nav-sublist a:hover {
        color: var(--jd-text-primary);
    }

    /* The same mark one level down, and here the weight joins it: these siblings are muted and
       set at 400, so 600 is a second cue the rail does not have to carry alone. */
    .docs-nav-sublist a[aria-current='page'] {
        color: var(--jd-text-primary);
        font-weight: 600;
        border-color: var(--jd-accent);
        background: color-mix(in srgb, var(--jd-accent) 8%, transparent);
    }

    @media (max-width: 56rem) {
        .docs-nav > summary {
            display: flex;
            align-items: center;
            gap: var(--jd-space-2);
            padding: var(--jd-space-3) 0;
            font-weight: 600;
            cursor: pointer;
            list-style: none;
        }

        .docs-nav > summary::-webkit-details-marker {
            display: none;
        }
    }
</style>
