---
/**
 * The install offer, behind tabs, wherever the page makes one.
 *
 * A TAB IS AN INSTALL METHOD, NOT A PACKAGE. A reader picks the tool they already use —
 * the .NET CLI, or the console in Visual Studio — and finds every command that offer
 * carries, in one place. Tabs per package would ask them to choose between things they
 * want all of, and would grow a tab every time the product does.
 *
 * NUGET IS NOT A TAB, and that is deliberate. A tab shows a panel; that one leaves the
 * site. Announcing it as "tab 3 of 3" and then navigating away is a small lie told to
 * exactly the people who can least afford it, so it stays a link, outside the tablist,
 * set apart by the arrow it carries.
 *
 * EACH LINK SITS BESIDE THE PACKAGE IT OPENS, which is why the same library link is
 * written into both panels rather than once above them. Grouped at the end of the tab
 * row they were a row of destinations with nothing saying which package each led to —
 * reported as exactly that. Beside a name, "View on NuGet" needs no explaining, and the
 * duplication is the price of that.
 *
 * WITHOUT SCRIPTING there are no tabs at all: the tablist is `hidden` in the markup and
 * the roles are attached by the script, so what a reader without JavaScript gets is the
 * stacked form — every command visible under its own heading — rather than a tab widget
 * that announces itself and does nothing (ADR-0004).
 *
 * `offer` NAMES A NARRATIVE MOMENT — how much of the product the reader has been shown
 * by the time this instance appears — which is exactly right for the home page's own
 * exits and wrong for a page whose whole point is one train's package on its own. The
 * `packages` prop is the escape hatch: given explicitly, it replaces the offer entirely
 * instead of layering on top of it, so a caller that knows exactly which package it means
 * — the download page, one train at a time — never has to reach for a narrative label
 * that would not describe it.
 */
import CopyableCommand from './CopyableCommand.astro';
import { localeFromPath } from '../i18n/routing';
import { useTranslations, type UiKey } from '../i18n/ui';
import { site } from '../site';

interface Props {
    /** Stable, position-independent identifier passed to every command in the row. */
    placement: string;
    /**
     * What this instance offers, which is what the visitor has been shown by the time
     * they reach it (§9.3). An exit that offers the tool before the tool has appeared
     * asks the reader to judge something they have no way to judge yet.
     */
    offer?: 'library' | 'library-and-adapter' | 'everything';
    /**
     * Given explicitly, this is the row: one entry per package, in this order, and
     * `offer` is not consulted at all. See the file header for why a caller would reach
     * for this instead of `offer`.
     */
    packages?: readonly PackageOffer[];
    /**
     * Whether to print the offer's own heading. The first screen needs one, because
     * nothing above it says what the block is for; an exit does not, because the step's
     * own title is already that heading.
     */
    heading?: boolean;
}

const { placement, offer = 'library', packages, heading = false } = Astro.props;

const t = useTranslations(localeFromPath(Astro.url.pathname));

const withTool: boolean = offer === 'everything';
// From the first exit onward. The snippets carry [Reproducible] from the moment the
// library draws a value, and an attribute a reader can see needs the package that
// provides it within reach — not two acts later.
const withAdapter: boolean = offer === 'library-and-adapter' || offer === 'everything';

interface Command {
    /** Names which package this command installs, and carries that package's own link. */
    label: UiKey;
    /** Where this package lives on NuGet. Beside its name, so "on NuGet" says which. */
    nuget: string;
    command?: string;
    /** Shown in place of a command where the method genuinely has none. */
    instead?: UiKey;
    /** Which door was taken, as reported by the command's own measurement event. */
    variant: string;
    /**
     * How the NuGet link reports itself. It names the package rather than the panel it
     * was clicked from, so the three names already recorded keep meaning what they meant
     * when the link appeared once per block.
     */
    nugetVariant: string;
}

interface Door {
    /** Part of the `id`s that wire a tab to its panel, so two blocks never collide. */
    key: string;
    label: UiKey;
    commands: Command[];
}

/** One package, method-agnostic — what `packages` carries instead of `offer`. */
interface PackageOffer {
    label: UiKey;
    nuget: string;
    installCommand: string;
    /** Left out for a package with no Package Manager Console equivalent — a global
     *  .NET tool, today. `instead` is what the panel says in its place. */
    packageManagerCommand?: string;
    instead?: UiKey;
}

let cli: Command[];
let packageManager: Command[];

if (packages !== undefined) {
    cli = packages.map((pkg: PackageOffer, index: number) => ({
        label: pkg.label,
        nuget: pkg.nuget,
        command: pkg.installCommand,
        variant: `cli-${index}`,
        nugetVariant: `nuget-${index}-link`,
    }));
    packageManager = packages.map((pkg: PackageOffer, index: number) => ({
        label: pkg.label,
        nuget: pkg.nuget,
        command: pkg.packageManagerCommand,
        instead: pkg.packageManagerCommand === undefined ? pkg.instead : undefined,
        variant: `pm-${index}`,
        nugetVariant: `nuget-${index}-link`,
    }));
} else {
    cli = [
        {
            label: 'install.library',
            nuget: site.library.nuget,
            command: site.library.installCommand,
            variant: 'dotnet-cli',
            nugetVariant: 'nuget-link',
        },
    ];
    packageManager = [
        {
            label: 'install.library',
            nuget: site.library.nuget,
            command: site.library.packageManagerCommand,
            variant: 'package-manager',
            nugetVariant: 'nuget-link',
        },
    ];

    if (withAdapter) {
        cli.push({
            label: 'install.adapter',
            nuget: site.xunit.nuget,
            command: site.xunit.installCommand,
            variant: 'xunit-adapter',
            nugetVariant: 'nuget-adapter-link',
        });
        packageManager.push({
            label: 'install.adapter',
            nuget: site.xunit.nuget,
            command: site.xunit.packageManagerCommand,
            variant: 'xunit-adapter-pm',
            nugetVariant: 'nuget-adapter-link',
        });
    }

    if (withTool) {
        cli.push({
            label: 'install.tool',
            nuget: site.cli.nuget,
            command: site.cli.installCommand,
            variant: 'dotnet-tool',
            nugetVariant: 'nuget-tool-link',
        });
        // No command, and none invented: a global .NET tool has no Package Manager Console
        // equivalent. Saying so is more use than an empty panel or a command that does not work.
        packageManager.push({
            label: 'install.tool',
            nuget: site.cli.nuget,
            instead: 'install.toolIsCliOnly',
            variant: 'dotnet-tool-unavailable',
            nugetVariant: 'nuget-tool-link',
        });
    }
}

const doors: Door[] = [
    { key: 'cli', label: 'install.cli', commands: cli },
    { key: 'pm', label: 'install.packageManager', commands: packageManager },
];

const labelId: string = `${placement}-install-label`;
---

<section class="install" aria-labelledby={heading ? labelId : undefined} data-install-tabs>
    {
        heading && (
            <h2 class="label" id={labelId}>
                {t('home.install.label')}
            </h2>
        )
    }

    {/*
      Labelled by the heading when there is one, and by its own name when there is
      not — a tablist with no accessible name is a set of controls a screen reader
      announces without saying what they switch between.
    */}
    <div
        class="tablist"
        role="tablist"
        aria-labelledby={heading ? labelId : undefined}
        aria-label={heading ? undefined : t('home.install.label')}
        hidden
        data-tablist
    >
        {
            doors.map((door: Door) => (
                <button
                    type="button"
                    class="tab"
                    id={`${placement}-${door.key}-tab`}
                    aria-controls={`${placement}-${door.key}-panel`}
                    data-tab={door.key}
                >
                    {t(door.label)}
                </button>
            ))
        }
    </div>

    {
        doors.map((door: Door) => (
            <div class="panel" id={`${placement}-${door.key}-panel`} data-panel={door.key}>
                {/*
                  What a reader without scripting needs to tell the panels apart, and
                  what a tab makes redundant — the script hides it when it takes over,
                  because by then the tab is the label.

                  A paragraph rather than a heading: the step's own title is the heading
                  here, and a sibling `h3` under it would claim to be its equal in the
                  document outline while being a caption for one panel.
                */}
                <p class="panel-label" data-panel-label>
                    {t(door.label)}
                </p>

                {door.commands.map((entry: Command) => (
                    <div class="package">
                        {/*
                          The package on the left, where it lives on the right.

                          `target="_blank"` because this is somebody else's page and a
                          reader following it has not finished with this one. `rel` closes
                          the hole that opens with it — an opened page can otherwise reach
                          back through `window.opener`.

                          The package name is repeated inside the link, out of sight: a
                          panel now holds two or three links reading "View on NuGet", and
                          a screen reader listing the links of a page reads them out of
                          the row that tells them apart.
                        */}
                        <div class="package-header">
                            <p class="package-label">{t(entry.label)}</p>

                            <a
                                class="nuget"
                                href={entry.nuget}
                                target="_blank"
                                rel="noopener noreferrer"
                                data-placement={placement}
                                data-variant={entry.nugetVariant}
                            >
                                {t('install.nuget')}
                                <span class="visually-hidden"> — {t(entry.label)}</span>
                                <svg
                                    class="arrow"
                                    viewBox="0 0 12 12"
                                    width="10"
                                    height="10"
                                    aria-hidden="true"
                                    focusable="false"
                                >
                                    <path d="M3 9L9 3M4.5 3H9v4.5" />
                                </svg>
                                <span class="visually-hidden">{t('state.newTab')}</span>
                            </a>
                        </div>

                        {entry.command !== undefined ? (
                            <CopyableCommand command={entry.command} placement={placement} variant={entry.variant} />
                        ) : (
                            <p class="unavailable">{t(entry.instead!)}</p>
                        )}
                    </div>
                ))}
            </div>
        ))
    }
</section>

<script>
    /**
     * Turns the stacked form into a tab widget, following the ARIA authoring practices'
     * automatic-activation pattern: the panels are already in the page, so selection
     * follows focus and there is nothing to wait for.
     *
     * The roles are attached here rather than written in the markup so that a page whose
     * scripting never arrives has no half-built widget in it.
     */
    for (const block of document.querySelectorAll<HTMLElement>('[data-install-tabs]')) {
        const tablist: HTMLElement | null = block.querySelector('[data-tablist]');
        const tabs: HTMLButtonElement[] = Array.from(block.querySelectorAll<HTMLButtonElement>('[data-tab]'));
        const panels: HTMLElement[] = Array.from(block.querySelectorAll<HTMLElement>('[data-panel]'));

        if (tablist === null || tabs.length === 0 || tabs.length !== panels.length) {
            continue;
        }

        /**
         * Which tab is selected. Starts at 0 because the stacked form already shows the
         * first panel, so the call that builds the widget selects what was on screen —
         * and is therefore not a switch.
         */
        let current = 0;

        function select(index: number, moveFocus: boolean): void {
            const changed: boolean = index !== current;

            current = index;

            tabs.forEach((tab: HTMLButtonElement, position: number) => {
                const selected: boolean = position === index;

                tab.setAttribute('aria-selected', String(selected));
                // Roving tabindex: one stop for the whole set, then the arrow keys.
                tab.tabIndex = selected ? 0 : -1;
                panels[position].hidden = !selected;
            });

            if (moveFocus) {
                tabs[index].focus();
            }

            /*
             * Said out loud from the state transition itself, and only when the state
             * really moved. This component does not know that anything is listening —
             * the same arrangement `CopyableCommand` has with the collector.
             *
             * Watching clicks from outside would be wrong twice over: ArrowLeft, ArrowRight,
             * Home and End switch panels through this function without ever producing a
             * click, so every keyboard switch would go unreported; and clicking the tab that
             * is already selected would report a switch that did not happen.
             */
            if (changed) {
                document.dispatchEvent(
                    new CustomEvent('jd:install-variant-switched', {
                        detail: {
                            placement: block.querySelector<HTMLElement>('[data-placement]')?.dataset.placement,
                            variant: tabs[index].dataset.tab,
                        },
                    }),
                );
            }
        }

        tabs.forEach((tab: HTMLButtonElement, position: number) => {
            tab.setAttribute('role', 'tab');

            const panel: HTMLElement = panels[position];

            panel.setAttribute('role', 'tabpanel');
            panel.setAttribute('aria-labelledby', tab.id);
            // NOT made focusable, which the authoring practices ask for only when a panel
            // holds nothing focusable of its own. This one holds the copy button, so a tab
            // stop here would announce the whole panel to somebody on their way to it.

            const panelLabel: HTMLElement | null = panel.querySelector('[data-panel-label]');

            if (panelLabel !== null) {
                panelLabel.hidden = true;
            }

            tab.addEventListener('click', () => select(position, false));

            tab.addEventListener('keydown', (event: KeyboardEvent) => {
                const last: number = tabs.length - 1;
                let next: number | undefined;

                if (event.key === 'ArrowRight') {
                    next = position === last ? 0 : position + 1;
                } else if (event.key === 'ArrowLeft') {
                    next = position === 0 ? last : position - 1;
                } else if (event.key === 'Home') {
                    next = 0;
                } else if (event.key === 'End') {
                    next = last;
                }

                if (next === undefined) {
                    return;
                }

                event.preventDefault();
                select(next, true);
            });
        });

        select(0, false);
        tablist.hidden = false;
    }
</script>

<style>
    .install {
        /* Explicit, because the implicit track would take its automatic minimum from the
           widest command it holds and grow the whole block past the viewport. */
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: var(--jd-space-3);
        max-width: 46rem;
    }

    /* The one heading on the first screen that is an offer rather than a claim, and the
       accent is what the page reserves for that. Exits do not print it: their step title
       is already the heading, and four of these would make the accent ordinary. */
    .label {
        margin: 0;
        font-size: var(--jd-text-sm);
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--jd-accent);
    }

    /* Wraps rather than scrolls: a row that scrolls sideways hides half of itself behind
       a gesture, and the French label for the package manager console is long enough that
       a phone would need it. Two lines cost nothing here. */
    .tablist {
        display: flex;
        flex-wrap: wrap;
        gap: var(--jd-space-2);
    }

    .tab {
        font: inherit;
        font-size: var(--jd-text-sm);
        color: var(--jd-text-muted);
        background: transparent;
        border: 1px solid var(--jd-border);
        border-radius: var(--jd-radius-sm);
        padding: var(--jd-space-1) var(--jd-space-3);
        cursor: pointer;
        transition:
            color var(--jd-duration-fast) var(--jd-ease),
            border-color var(--jd-duration-fast) var(--jd-ease);
    }

    .tab:hover {
        color: var(--jd-text-primary);
        border-color: var(--jd-accent);
    }

    .tab[aria-selected='true'] {
        color: var(--jd-accent);
        background: var(--jd-surface-raised);
        border-color: var(--jd-accent);
    }

    .tab:focus-visible {
        outline: 2px solid var(--jd-accent);
        outline-offset: 2px;
    }

    .arrow {
        fill: none;
        stroke: currentColor;
        stroke-width: 1.5;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .panel {
        display: grid;
        gap: var(--jd-space-3);
    }

    /* One package: its name, where it lives, and the line that installs it.

       `min-width: 0` is not cosmetic — without it the page scrolls sideways below about
       600 pixels, 28 of overflow at 560 and 104 at 480. A grid child keeps
       `min-width: auto`, so this wrapper refused to shrink under the command it holds and
       pushed the document wider instead of letting the command scroll inside itself. */
    .package {
        min-width: 0;
    }

    /* Name against edge, link against the other, and `baseline` rather than `center` so
       the two sit on the same line of text however the link's arrow measures.

       It wraps, and what it does when it wraps is put the link under the name, still on
       the left. Pinning it right on a second line would leave it stranded under nothing. */
    .package-header {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 0 var(--jd-space-4);
        margin-bottom: var(--jd-space-2);
    }

    .nuget {
        display: inline-flex;
        align-items: center;
        gap: var(--jd-space-1);
        font-size: var(--jd-text-sm);
        white-space: nowrap;
    }

    .panel-label {
        font-size: var(--jd-text-sm);
        font-weight: 400;
        color: var(--jd-text-muted);
        margin: 0 0 var(--jd-space-2);
    }

    /* No bottom margin of its own: the spacing belongs to the row it sits in. */
    .package-label {
        font-size: var(--jd-text-sm);
        font-weight: 400;
        color: var(--jd-text-muted);
        margin: 0;
    }

    .unavailable {
        margin: 0;
        font-size: var(--jd-text-sm);
        color: var(--jd-text-muted);
        font-style: italic;
    }

    /* A narrow screen is where this block costs the most, because that is where the tabs
       wrap onto a second line. What it takes back is air, never a door. */
    @media (max-width: 47.99rem) {
        .install {
            gap: var(--jd-space-2);
        }

        .tab {
            padding: 0 var(--jd-space-2);
        }
    }

    /* .visually-hidden is declared once, globally, in base.css. */
</style>
