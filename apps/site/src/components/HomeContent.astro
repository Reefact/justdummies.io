---
/**
 * The home page's body, written once and rendered in every locale.
 *
 * Prose comes from the translation system; facts — the package name, its version,
 * the install command — come from `site.ts` and are identical in every locale
 * (§28.2: only the narrative around the code is translated, never the code).
 */
import CodeSample from './CodeSample.astro';
import InstallBlock from './InstallBlock.astro';
import ActOne from './narrative/ActOne.astro';
import ActTwo from './narrative/ActTwo.astro';
import ActThree from './narrative/ActThree.astro';
import { localeFromPath } from '../i18n/routing';
import { useTranslations } from '../i18n/ui';
import { site } from '../site';

const t = useTranslations(localeFromPath(Astro.url.pathname));
---

<main class="shell">
    <header class="hero">
        <h1>{site.name}</h1>
        <p class="tagline">{t('brand.tagline')}</p>
        <p class="subtitle">{t('brand.subtitle')}</p>

        <CodeSample id="hero-expression" />

        <h2 class="install-label">{t('home.install.label')}</h2>
        <InstallBlock placement="hero" />

        <nav class="links" aria-label={t('nav.primary')}>
            {/*
              The one internal link that deliberately leaves the current locale.
              Internal links are supposed to stay in it (§25.1), but the playground is
              a single Blazor application served in English only (§8.3), and
              /fr/playground — a translated shell around that same application — is
              phase 4 work. Sending a French reader to a route that does not exist
              would be worse than sending them to one that does.
            */}
            <a href="/playground/">{t('nav.playground')}</a>
            {/* No NuGet link here: the install block above owns it, and the same link
                twice on one screen makes the reader wonder which is which. */}
            <a href={site.repository}>{t('nav.github')}</a>
        </nav>
    </header>

    {/* NOT BUILT: §7.4's reduced install block in the site header, which is what the
        visitor who already knows the product is supposed to reach for. Until it
        exists, the hero's block is the only one above the first act's exit. */}
    <ActOne />
    <ActTwo />
    <ActThree />

    <p class="note">{t('home.progress.note')}</p>
</main>

<style>
    /* Wider than the hero needs, because the acts are two columns and the right one
       holds code that does not wrap. The hero keeps its own measure below and stays
       left-aligned with the acts rather than being centred against them. */
    .shell {
        max-width: 72rem;
        margin: 0 auto;
        padding: var(--jd-space-8) var(--jd-space-4) var(--jd-space-16);
    }

    .hero {
        max-width: 56rem;
    }

    h1 {
        font-size: var(--jd-text-2xl);
        line-height: var(--jd-line-tight);
        margin: 0;
    }

    .tagline {
        font-size: var(--jd-text-lg);
        color: var(--jd-accent);
        margin: var(--jd-space-3) 0 0;
    }

    .subtitle {
        color: var(--jd-text-muted);
        margin: var(--jd-space-2) 0 var(--jd-space-8);
    }

    figure {
        margin: 0 0 var(--jd-space-8);
    }

    .install-label {
        font-size: var(--jd-text-sm);
        font-weight: 400;
        color: var(--jd-text-muted);
        margin: 0 0 var(--jd-space-2);
    }

    .command {
        background: var(--jd-surface);
        border: 1px solid var(--jd-border);
        border-radius: var(--jd-radius-md);
        padding: var(--jd-space-4);
        margin: 0;
        overflow-x: auto;
        font-size: var(--jd-text-sm);
    }

    .links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--jd-space-6);
        margin-top: var(--jd-space-6);
    }

    .note {
        margin-top: var(--jd-space-12);
        padding-top: var(--jd-space-4);
        border-top: 1px solid var(--jd-border);
        color: var(--jd-text-muted);
        max-width: 46rem;
    }
</style>
