---
/**
 * The home page's body, written once and rendered in every locale.
 *
 * Prose comes from the translation system; facts — the package name, its version,
 * the install command — come from `site.ts` and are identical in every locale
 * (§28.2: only the narrative around the code is translated, never the code).
 */
import InstallTabs from './InstallTabs.astro';
import LiveHero from './LiveHero.astro';
import ActOne from './narrative/ActOne.astro';
import ActTwo from './narrative/ActTwo.astro';
import ActThree from './narrative/ActThree.astro';
import { localeFromPath } from '../i18n/routing';
import { useTranslations } from '../i18n/ui';
import { site } from '../site';

const t = useTranslations(localeFromPath(Astro.url.pathname));
---

<main class="shell">
    <header class="hero">
        {/*
          The mark is `alt=""` on purpose. The heading it sits in already says JustDummies,
          and an icon that repeats the word beside it makes a screen reader say the name
          twice. Its size and its alignment are the script's job below; the width and height
          attributes are the file's own, so the box is reserved before the image lands and
          the heading does not jump.
        */}
        <h1><img class="mark" src="/favicon.png" alt="" width="512" height="512" decoding="async" />{site.name}</h1>
        <p class="tagline">{t('brand.tagline')}</p>
        <p class="subtitle">{t('brand.subtitle')}</p>

        <LiveHero />

        {/*
          §7.4's reduced form. This screen is not one of the narrative's reward moments —
          the reader has been given no reason yet — but the offer does not belong to the
          first act either, so it belongs here. Behind tabs rather than stacked, because
          what fits here is one row and the stacked form is three.

          The playground and the repository used to sit under it, and they are in the site
          header now: a link that is true on every page belongs in the bar that is on every
          page, and both of them were competing here with the one thing this screen asks
          for.
        */}
        <div class="offer">
            <InstallTabs placement="hero" />
        </div>

        {/*
          The invitation to go on, and a link rather than an ornament: a reader who cannot
          use a mouse wheel gets the same offer, and it goes exactly where it points.
          `aria-hidden` on the chevron itself, because "Read the first act" is the whole
          message and the drawing repeats it.
        */}
        <a class="cue" href="#act-one">
            <span class="cue-label">{t('hero.scrollCue')}</span>
            <svg class="chevrons" viewBox="0 0 24 26" width="24" height="26" aria-hidden="true" focusable="false">
                <path class="chevron chevron-first" d="M4 5l8 8 8-8" />
                <path class="chevron chevron-second" d="M4 13l8 8 8-8" />
            </svg>
        </a>
    </header>

    {/* NOT BUILT: §7.4's reduced install block in the site header, which is what the
        visitor who already knows the product is supposed to reach for. Until it
        exists, the hero's block is the only one above the first act's exit. */}
    <ActOne />
    <ActTwo />
    <ActThree />
</main>

<script>
    /**
     * Sizes the mark to the `J` beside it, exactly, on whatever face the platform gave
     * this heading.
     *
     * WHY NOT IN THE STYLESHEET. `1cap` states the cap height and nothing states a
     * descender, and the `J` has one — so CSS can put the mark's top on the cap line or
     * its bottom on the baseline, but not its bottom on the bottom of the `J`. The size of
     * that drop is a property of the resolved font, and the font stack here is
     * `ui-sans-serif, system-ui`: SF Pro on one machine, Segoe UI on another, something
     * else again on a third. A number written into the stylesheet would be right on the
     * machine it was measured on and wrong everywhere else.
     *
     * So it is measured where it is used. The stylesheet's `1cap` is what shows until this
     * runs and if it never runs — a mark on the cap line, ending on the baseline, which is
     * a normal-looking lockup rather than a broken one.
     */
    const HEADING = '.hero h1';

    const mark: HTMLImageElement | null = document.querySelector(`${HEADING} .mark`);
    const heading: HTMLElement | null = document.querySelector(HEADING);

    if (mark !== null && heading !== null) {
        const canvas: CanvasRenderingContext2D | null = document.createElement('canvas').getContext('2d');

        const align = (): void => {
            if (canvas === null) {
                return;
            }

            const style: CSSStyleDeclaration = getComputedStyle(heading);

            // The shorthand canvas accepts, which is not the one CSS reports: a line height
            // in it is either ignored or refused depending on the engine.
            canvas.font = `${style.fontStyle} ${style.fontWeight} ${style.fontSize} ${style.fontFamily}`;

            const metrics: TextMetrics = canvas.measureText('J');
            const above: number = metrics.actualBoundingBoxAscent;
            const below: number = metrics.actualBoundingBoxDescent;

            if (!Number.isFinite(above) || !Number.isFinite(below) || above <= 0) {
                return;
            }

            mark.style.height = `${above + below}px`;
            // Negative moves it down: `vertical-align` is measured up from the baseline, and
            // the mark's bottom has to land where the tail of the `J` lands.
            mark.style.verticalAlign = `${-below}px`;
        };

        align();

        // The heading is smaller on a short screen and on a phone, so the glyph it must
        // match changes with the viewport rather than only at load.
        let pending: number | undefined;
        window.addEventListener('resize', () => {
            if (pending !== undefined) {
                cancelAnimationFrame(pending);
            }
            pending = requestAnimationFrame(align);
        });

        // A face that arrives after first paint changes every number above. None is loaded
        // here today — the stack is the platform's own — and that is a fact about today.
        if (document.fonts !== undefined) {
            document.fonts.ready.then(align);
        }
    }
</script>

<style>
    /* Wider than the hero needs, because a scene's figure now takes the whole measure
       and the widest of them is a recorded terminal 130 characters across. The hero keeps
       its own measure below and stays left-aligned with the acts rather than being
       centred against them. */
    .shell {
        max-width: 72rem;
        margin: 0 auto;
        padding: var(--jd-space-8) var(--jd-space-4) var(--jd-space-16);
    }

    .hero {
        max-width: 56rem;
    }

    /*
     * The first screen is a scene of its own, and it holds the whole of it — so a reader
     * arriving has the brand, one real expression and one real value in front of them, and
     * nothing of the first act yet.
     *
     * The subtraction is the room the site header and this shell's own top padding take
     * above it. Without it the hero would be a viewport tall *starting below them*, and the
     * chevron meant to sit at the bottom edge would sit just under it.
     *
     * `100svh` rather than `100vh`: on a phone `vh` is the viewport with the browser's
     * chrome retracted, which is not the height anything is ever laid out at, so a hero
     * measured in `vh` is always a little taller than the screen showing it.
     *
     * THE INSTALL BLOCK IS NOT HERE, and its absence is what makes the rest fit. It was
     * 254 pixels of the 837 this screen had, which put the chevron below the fold on any
     * ordinary laptop — the one thing this screen exists to show. §7.4 places the block at
     * the narrative's reward moments and, in reduced form, in the site header; the hero was
     * never one of those, and it carried one only because no act had an exit yet. All three
     * do now.
     *
     * What that leaves undone is the visitor who already knows the product and wants the
     * command: until §7.4's header form exists, the nearest one is the first act's exit,
     * one screen down.
     */
    .hero {
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: calc(100svh - 7.5rem);
        /* So the chevron does not sit on the first act's rule, four pixels below it. */
        padding-bottom: var(--jd-space-8);
        gap: var(--jd-space-4);
    }

    /*
     * A short screen — a laptop at 700 logical pixels is ordinary — has room for the same
     * things but not the same air between them. Tightening here beats dropping one of them,
     * because every one of them is why this screen exists.
     */
    /*
     * A phone is not a short screen — it is a narrow one, and narrow is what makes its
     * figure taller: the same code wraps. So it gets the same treatment for a different
     * reason, and by its own query rather than by widening the height one, which would
     * strip the subtitle off an ordinary 900-pixel desktop that has room for it.
     */
    @media (max-width: 47.99rem) {
        .shell {
            padding-top: var(--jd-space-4);
        }

        .hero {
            gap: var(--jd-space-2);
            padding-bottom: var(--jd-space-4);
        }

        .subtitle {
            display: none;
        }

        .offer,
        .cue {
            padding-top: var(--jd-space-4);
        }
    }

    @media (max-height: 820px) {
        .shell {
            padding-top: var(--jd-space-4);
        }

        .hero {
            gap: var(--jd-space-2);
            padding-bottom: var(--jd-space-4);
        }

        .hero h1 {
            font-size: var(--jd-text-xl);
        }

        /* The tagline carries the claim; the subtitle restates it in plainer words. On a
           screen with no room for both, the one that repeats is the one that goes. */
        .subtitle {
            display: none;
        }

        .offer,
        .cue {
            padding-top: var(--jd-space-4);
        }
    }

    .cue {
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        gap: var(--jd-space-2);
        align-self: center;
        color: var(--jd-text-muted);
        font-size: var(--jd-text-sm);
        text-decoration: none;
    }

    /*
     * THE TWO GAPS ON THIS SCREEN ARE ONE GAP. Two `auto` margins in a flex column share
     * whatever space is left over *equally*, so the room above the offer and the room above
     * the chevron come out the same however tall the screen is. With the auto on the
     * chevron alone — which is what this was — every spare pixel went to the bottom and the
     * offer sat against the playground row, reported as exactly that.
     *
     * The padding is the floor under each of them, for the screen with no spare space to
     * share: enough to read as a break, not so much that it pushes the chevron off. It is
     * the same number on both, because a floor under one gap only is the asymmetry the auto
     * margins are here to remove.
     */
    .offer,
    .cue {
        margin-top: auto;
        padding-top: var(--jd-space-8);
    }

    .cue:hover {
        color: var(--jd-text-primary);
    }

    .chevrons {
        color: var(--jd-accent);
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    /*
     * The two strokes fade in turn, downward, which reads as a direction rather than as a
     * thing bouncing. Slow on purpose: a cue that insists is a cue that annoys on the
     * second visit.
     */
    .chevron {
        opacity: 0.25;
        animation: cue 2.4s ease-in-out infinite;
    }

    .chevron-second {
        animation-delay: 0.25s;
    }

    @keyframes cue {
        0%,
        60%,
        100% {
            opacity: 0.25;
        }

        30% {
            opacity: 1;
        }
    }

    /*
     * Asked for no movement, given none. The chevrons still point down, which is the half
     * of the message that does not need to move.
     */
    @media (prefers-reduced-motion: reduce) {
        .chevron {
            animation: none;
            opacity: 0.6;
        }
    }

    h1 {
        font-size: var(--jd-text-2xl);
        line-height: var(--jd-line-tight);
        margin: 0;
    }

    /*
     * ALIGNED TO THE J, WHICH IS NOT THE SAME AS SITTING ON THE BASELINE. The heading's
     * font stack resolves to whatever the platform's system face is, and in every one of
     * them the `J` drops below the baseline — 11 pixels of 50 here. So its ink box runs
     * from the cap line to below the line the rest of the word stands on, and matching it
     * means matching both edges, not one.
     *
     * These values are the fallback, and they are the closest CSS can state on its own:
     * `1cap` is exactly the cap height, and a baseline-aligned image ends on the baseline.
     * Top edge exact, bottom edge short by the descender. The script below measures the
     * real glyph and replaces both — see its own note for why that cannot be done here.
     */
    .mark {
        height: 1cap;
        width: auto;
        vertical-align: baseline;
        /* Optical, not metric: the file carries 28 pixels of transparent margin down its
           left side and 21 down its right, out of 512, so a gap set to the eye reads
           narrower than the number says. */
        margin-right: 0.18em;
    }

    .tagline {
        font-size: var(--jd-text-lg);
        color: var(--jd-accent);
        margin: var(--jd-space-3) 0 0;
    }

    .subtitle {
        color: var(--jd-text-muted);
        margin: var(--jd-space-2) 0 var(--jd-space-8);
    }

    figure {
        margin: 0 0 var(--jd-space-8);
    }

    .command {
        background: var(--jd-surface);
        border: 1px solid var(--jd-border);
        border-radius: var(--jd-radius-md);
        padding: var(--jd-space-4);
        margin: 0;
        overflow-x: auto;
        font-size: var(--jd-text-sm);
    }

</style>
