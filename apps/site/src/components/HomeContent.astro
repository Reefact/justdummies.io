---
/**
 * The home page's body, written once and rendered in every locale.
 *
 * Prose comes from the translation system; facts — the package name, its version,
 * the install command — come from `site.ts` and are identical in every locale
 * (§28.2: only the narrative around the code is translated, never the code).
 */
import InstallTabs from './InstallTabs.astro';
import LiveHero from './LiveHero.astro';
import { localeFromPath } from '../i18n/routing';
import { useTranslations } from '../i18n/ui';

const t = useTranslations(localeFromPath(Astro.url.pathname));
---

<header class="hero">
    <p class="subtitle">{t('brand.subtitle')}</p>

    <LiveHero />

    {/*
      §7.4's reduced form. This screen is not one of the narrative's reward moments —
      the reader has been given no reason yet — but the offer does not belong to the
      first act either, so it belongs here. Behind tabs rather than stacked, because
      what fits here is one row and the stacked form is three.

      The playground and the repository used to sit under it, and they are in the site
      header now: a link that is true on every page belongs in the bar that is on every
      page, and both of them were competing here with the one thing this screen asks
      for.
    */}
    <div class="offer">
        <InstallTabs placement="hero" />

        {/*
          The dummy, on the windows tall enough to have room for one. Empty on purpose: it
          is drawn as a background, which is what keeps it off the wire on every screen that
          does not show it and out of a screen reader's way on the ones that do. The rule
          below carries the measurements and the reasoning.
        */}
        <div class="mascot" data-dummy></div>
    </div>

    {/*
      The invitation to go on, and a link rather than an ornament: a reader who cannot
      use a mouse wheel gets the same offer, and it goes exactly where it points.
      `aria-hidden` on the chevron itself, because "Read the first act" is the whole
      message and the drawing repeats it.
    */}
    <a class="cue" href="#act-one">
        <span class="cue-label">{t('hero.scrollCue')}</span>
        <svg class="chevrons" viewBox="0 0 24 26" width="24" height="26" aria-hidden="true" focusable="false">
            <path class="chevron chevron-first" d="M4 5l8 8 8-8" />
            <path class="chevron chevron-second" d="M4 13l8 8 8-8" />
        </svg>
    </a>
</header>

<style>
    /*
     * The first screen is a scene of its own, and it holds the whole of it — so a reader
     * arriving has the brand, one real expression and one real value in front of them, and
     * nothing of the first act yet.
     *
     * IT NO LONGER MEASURES A VIEWPORT. The layout's shell is the one screen tall block —
     * brand included — and this fills whatever the brand leaves of it. That is what stops
     * the brand moving from page to page: it used to be centred inside this box, so it sat
     * at y=94 on a 900-pixel window and y=78 on an 800-pixel one, while every other page
     * held it still.
     *
     * THE INSTALL BLOCK IS NOT HERE, and its absence is what makes the rest fit. It was
     * 254 pixels of the 837 this screen had, which put the chevron below the fold on any
     * ordinary laptop — the one thing this screen exists to show. §7.4 places the block at
     * the narrative's reward moments and, in reduced form, in the site header; the hero was
     * never one of those, and it carried one only because no act had an exit yet. All three
     * do now.
     *
     * What that leaves undone is the visitor who already knows the product and wants the
     * command: until §7.4's header form exists, the nearest one is the first act's exit,
     * one screen down.
     */
    .hero {
        display: flex;
        flex-direction: column;
        flex: 1;
        /* So the chevron does not sit on the first act's rule, four pixels below it. */
        padding-bottom: var(--jd-space-8);
        gap: var(--jd-space-4);
    }

    /*
     * A short screen — a laptop at 700 logical pixels is ordinary — has room for the same
     * things but not the same air between them. Tightening here beats dropping one of them,
     * because every one of them is why this screen exists.
     */
    /*
     * A phone is not a short screen — it is a narrow one, and narrow is what makes its
     * figure taller: the same code wraps. So it gets the same treatment for a different
     * reason, and by its own query rather than by widening the height one, which would
     * strip the subtitle off an ordinary 900-pixel desktop that has room for it.
     */
    @media (max-width: 47.99rem) {
        .hero {
            gap: var(--jd-space-2);
            padding-bottom: var(--jd-space-4);
        }

        .subtitle {
            display: none;
        }

        .offer,
        .cue {
            padding-top: var(--jd-space-4);
        }
    }

    @media (max-height: 820px) {
        .hero {
            gap: var(--jd-space-2);
            padding-bottom: var(--jd-space-4);
        }

        /* The tagline carries the claim; the subtitle restates it in plainer words. On a
           screen with no room for both, the one that repeats is the one that goes. */
        .subtitle {
            display: none;
        }

        .offer,
        .cue {
            padding-top: var(--jd-space-4);
        }
    }

    .cue {
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        gap: var(--jd-space-2);
        align-self: center;
        color: var(--jd-text-muted);
        font-size: var(--jd-text-sm);
        text-decoration: none;
    }

    /*
     * THE TWO GAPS ON THIS SCREEN ARE ONE GAP. Two `auto` margins in a flex column share
     * whatever space is left over *equally*, so the room above the offer and the room above
     * the chevron come out the same however tall the screen is. With the auto on the
     * chevron alone — which is what this was — every spare pixel went to the bottom and the
     * offer sat against the playground row, reported as exactly that.
     *
     * The padding is the floor under each of them, for the screen with no spare space to
     * share: enough to read as a break, not so much that it pushes the chevron off. It is
     * the same number on both, because a floor under one gap only is the asymmetry the auto
     * margins are here to remove.
     */
    .offer,
    .cue {
        margin-top: auto;
        padding-top: var(--jd-space-8);
    }

    /*
     * THE DUMMY ON THE FIRST SCREEN, and the only decoration §5.2 leaves room for here: it
     * carries no part of the demonstration, so it appears only where the page has nothing
     * else to put, and never where it would take the screen's one focal point (§5.4).
     *
     * WHAT IT STANDS IN. The gap the rule above shares out stops being air and becomes a
     * hole once the window is tall: 240 pixels of nothing at 1080, and half of every pixel
     * of window above that. Sideways, the free room is the column between the install
     * block's own 46rem cap and the shell's 72rem edge — 384 pixels, whatever the window
     * does, once it is wide enough for the shell to reach that cap. The dummy stands in
     * that column with its feet on the block's bottom line, which is what makes it read as
     * standing beside the offer rather than floating near it.
     *
     * A BACKGROUND, NOT AN `<img>`. An image element is fetched even when the rule that
     * hides it is `display: none`, so every phone would pay 50 KiB for a drawing it is
     * never shown; declared inside the query, the file is requested by the windows that
     * draw it and by nobody else. It settles the other question by construction too —
     * there is no element for a screen reader to announce, which is the right answer for a
     * drawing that says nothing the page has not already said.
     *
     * ONE SIZE, AND IT NEVER CHANGES. The figure used to take the box's growth with it,
     * between 208 and 352 pixels, and that was one behaviour too many: a drawing whose
     * size depends on the window is a drawing whose size nobody knows. It is 300 pixels
     * on every window that draws it at all, and on the ones that cannot hold 300 it is
     * absent rather than smaller.
     *
     * WHERE THE THRESHOLD COMES FROM, measured on the built page in both locales:
     *
     *     window height    1200    1280    1306    1440
     *     free box          300     340     353     420
     *
     * the box being the gap plus the 165-pixel block under it, and growing by exactly one
     * pixel for every two of window past 1000. At 1200 the figure would touch the card;
     * 1280 is where 40 pixels of air open above its head, and that is the cliff. Nothing
     * between the two states exists, which is the point.
     *
     * THOSE 40 PIXELS ARE ALSO THE CARD'S ROOM TO GROW after the first paint: pressing Run
     * replaces the static figure with the live one, and the library's refusal is a line
     * taller than a value. A refusal at the threshold leaves the head some 15 pixels of
     * air rather than none — narrow, and never negative, which is what matters.
     *
     * IN PIXELS RATHER THAN REM, alone on this screen. Every number above came off a
     * viewport measured in pixels. In `rem` the figure would grow with the reader's font
     * while the box holding it shrank — the one direction in which a decoration ends up
     * over the code.
     *
     * AND IF THAT REASONING IS EVER WRONG, `z-index: -1` is what keeps the mistake cheap:
     * the drawing slides behind the card and behind the install block, both of which paint
     * their own ground. A dummy with its head hidden, never a dummy over the expression.
     */
    .offer {
        position: relative;
    }

    .mascot {
        display: none;
    }

    @media (min-width: 75rem) and (min-height: 1280px) {
        .mascot {
            display: block;
            position: absolute;
            right: 0;
            bottom: 0;
            z-index: -1;
            height: 300px;
            aspect-ratio: 518 / 717;
            background: url('/dummy-look-at-this.webp') no-repeat center bottom / contain;
            pointer-events: none;
        }
    }

    .cue:hover {
        color: var(--jd-text-primary);
    }

    .chevrons {
        color: var(--jd-accent);
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    /*
     * The two strokes fade in turn, downward, which reads as a direction rather than as a
     * thing bouncing. Slow on purpose: a cue that insists is a cue that annoys on the
     * second visit.
     */
    .chevron {
        opacity: 0.25;
        animation: cue 2.4s ease-in-out infinite;
    }

    .chevron-second {
        animation-delay: 0.25s;
    }

    @keyframes cue {
        0%,
        60%,
        100% {
            opacity: 0.25;
        }

        30% {
            opacity: 1;
        }
    }

    /*
     * Asked for no movement, given none. The chevrons still point down, which is the half
     * of the message that does not need to move.
     */
    @media (prefers-reduced-motion: reduce) {
        .chevron {
            animation: none;
            opacity: 0.6;
        }
    }

    /* Narrower than the measure, and alone in being so: the subtitle is prose, which reads
       best short of line, while the expression and the offer below it are the first of the
       code and install blocks the narrative repeats in every act, and take the whole 72rem
       shell like the rest — same as a scene's figure. */
    .subtitle {
        max-width: 56rem;
        color: var(--jd-text-muted);
        margin: var(--jd-space-2) 0 var(--jd-space-8);
    }

    figure {
        margin: 0 0 var(--jd-space-8);
    }

    .command {
        background: var(--jd-surface);
        border: 1px solid var(--jd-border);
        border-radius: var(--jd-radius-md);
        padding: var(--jd-space-4);
        margin: 0;
        overflow-x: auto;
        font-size: var(--jd-text-sm);
    }

</style>
