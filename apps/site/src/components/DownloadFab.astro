---
/**
 * The one destination offered from every page rather than from the page that happens to
 * be telling that part of the story: the install commands, reachable without scrolling
 * back up to the header and without knowing which train to ask for first.
 *
 * HIDDEN ON /download ITSELF. A control that leads to the page already on screen cannot
 * act (ADR-0004's own test applied to navigation rather than to a widget) — the reader is
 * already where it goes.
 *
 * SHARES THE CONSENT BANNER'S STACKING, NOT ITS SPACE. `--jd-consent-height` is published
 * live by the consent script (see `base.css`'s own comment on `body`'s padding) and reused
 * here rather than duplicated: when the banner is up, this floats above it instead of
 * behind it, and when it is gone the offset collapses back to nothing on its own. The
 * banner still owns the single highest claim on the stack — this sits one layer under it.
 *
 * AND THE KEYBOARD IS SCROLLED CLEAR OF IT, which `base.css` states rather than this file:
 * what answers it is `html`'s own scroll padding, and this control's band is added there to
 * the one the consent banner already claims. The measurement that made it necessary is
 * written beside that rule.
 *
 * IT REPORTS WHERE IT WAS CLICKED FROM, which is the only thing about it that varies. It is
 * an exit like the NuGet links are, except that it stands on every page rather than in one
 * scene — so its placement is the page's own section, and it carries no variant, because
 * there is one door behind it and never two (ADR-0023). `Measurement.astro` is what listens;
 * this file names the placement and knows nothing else about who reads it.
 */
import { pathForLocale, routeWithoutLocale, localeFromPath } from '../i18n/routing';
import { useTranslations } from '../i18n/ui';

/**
 * The route's own section, which is the granularity the question is decided at: a floating
 * control is kept or dropped across `/api/`, never on `/api/collections/` alone. The finer
 * answer belongs to lane three, which attaches the exact address to everything it reports;
 * the collector has no page dimension at all, so this is what carries the "where" into the
 * lane that counts everybody.
 *
 * §15.3 FORBIDS A DIGIT IN A PLACEMENT, and the section is what keeps every route outside
 * that: a release notes major is `v1`, and collapsing the route to its section reports every
 * major under `release-notes` rather than under its number. One route is left — `/404/` names
 * a status code — and it is named below rather than falling back to something, so that any
 * *other* digit-bearing section fails `verify-output.sh` instead of quietly reporting as a
 * page it is not.
 */
const SECTION_NAMES: Record<string, string> = { '404': 'not-found' };

function placementOf(route: string): string {
    const section: string | undefined = route.split('/').filter(Boolean)[0];

    // The home page is the one route with no section of its own to name.
    if (section === undefined) {
        return 'home';
    }

    return SECTION_NAMES[section] ?? section;
}

const pathname: string = Astro.url.pathname;
const locale = localeFromPath(pathname);
const t = useTranslations(locale);
const route: string = routeWithoutLocale(pathname);
const onDownloadPage: boolean = route.startsWith('/download/');
---

{
    !onDownloadPage && (
        <a
            class="download-fab"
            href={pathForLocale('/download/', locale)}
            aria-label={t('download.cta')}
            data-placement={placementOf(route)}
        >
            <svg class="icon" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false">
                <path d="M10 3v10m0 0l-4-4m4 4l4-4M4 15v1.5a1.5 1.5 0 0 0 1.5 1.5h9a1.5 1.5 0 0 0 1.5-1.5V15" />
            </svg>
            {/* `aria-label` above already names the link; this is decoration a sighted
                reader gets and a narrow screen below can drop without losing anything a
                screen reader relies on. */}
            <span class="label" aria-hidden="true">{t('download.cta')}</span>
        </a>
    )
}

<style>
    .download-fab {
        position: fixed;
        right: var(--jd-space-6);
        bottom: calc(var(--jd-space-6) + var(--jd-consent-height, 0px));
        z-index: 5;
        display: flex;
        align-items: center;
        gap: var(--jd-space-2);
        color: var(--jd-text-primary);
        background: var(--jd-surface-raised);
        border: 1px solid var(--jd-border);
        border-radius: 999px;
        padding: var(--jd-space-3) var(--jd-space-4);
        font-size: var(--jd-text-sm);
        font-weight: 600;
        text-decoration: none;
        box-shadow: var(--jd-shadow-raised);
        transition:
            border-color var(--jd-duration-fast) var(--jd-ease),
            bottom var(--jd-duration-fast) var(--jd-ease);
    }

    .download-fab:hover {
        border-color: var(--jd-accent);
        color: var(--jd-accent);
    }

    .download-fab:focus-visible {
        outline: 2px solid var(--jd-accent);
        outline-offset: 2px;
    }

    .icon {
        flex: none;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.5;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    /* The label goes first, on a screen narrow enough that the two together would crowd
       the corner they float in — the icon alone still says what the control does, and
       `aria-label` says it to a screen reader either way. */
    @media (max-width: 26rem) {
        .label {
            display: none;
        }

        .download-fab {
            padding: var(--jd-space-3);
        }
    }
</style>
