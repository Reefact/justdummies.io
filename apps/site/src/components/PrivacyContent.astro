---
/**
 * What this site measures about a visitor, and what it doesn't (§15).
 *
 * Each section is an `<h3>`/`<p>` pair rather than a bold lead phrase inside a
 * paragraph — `ui.ts` never carries markup, and a real heading serves §13.4's
 * hierarchy requirement better than a bolded run of text would.
 *
 * One of them is conditional: the analytics section, and the control that withdraws
 * consent to it, appear only on builds that carry the tag. A page describing a
 * measurement the artefact does not perform would be worse than saying nothing.
 */
import { localeFromPath } from '../i18n/routing';
import { useTranslations } from '../i18n/ui';
import { googleAnalyticsId } from '../measurement';

const t = useTranslations(localeFromPath(Astro.url.pathname));
---

<section class="privacy" aria-labelledby="privacy-heading">
    <h2 id="privacy-heading">{t('privacy.heading')}</h2>

    {/* Two of these paragraphs describe the analytics lane — one by promising something
        asks first, one by pointing at a control "above". On a build with the lane switched
        off there is no question and no control, so each has a counterpart that says what
        that artefact actually does. */}
    <div class="entry">
        <h3>{t('privacy.tracking.label')}</h3>
        <p>{t(googleAnalyticsId ? 'privacy.tracking.body' : 'privacy.tracking.bodyWithoutAnalytics')}</p>
    </div>
    <div class="entry">
        <h3>{t('privacy.analytics.label')}</h3>
        <p>{t('privacy.analytics.body')}</p>
    </div>
    {
        googleAnalyticsId && (
            <div class="entry">
                <h3>{t('privacy.consent.label')}</h3>
                <p>{t('privacy.consent.body')}</p>
                {/* Hidden until the script that can act on it is running (ADR-0004). */}
                <button type="button" class="change" hidden data-consent-reopen>
                    {t('privacy.consent.change')}
                </button>
            </div>
        )
    }
    <div class="entry">
        <h3>{t('privacy.playground.label')}</h3>
        <p>{t('privacy.playground.body')}</p>
    </div>
    <div class="entry">
        <h3>{t('privacy.hosting.label')}</h3>
        <p>{t('privacy.hosting.body')}</p>
    </div>
    <div class="entry">
        <h3>{t('privacy.controller.label')}</h3>
        <p>{t('privacy.controller.body')}</p>
    </div>
    <div class="entry">
        <h3>{t('privacy.rights.label')}</h3>
        <p>{t(googleAnalyticsId ? 'privacy.rights.body' : 'privacy.rights.bodyWithoutAnalytics')}</p>
    </div>

    <p class="updated">{t('privacy.updated')}</p>
</section>

<style>
    .privacy {
        max-width: 56rem;
    }

    h2 {
        font-size: var(--jd-text-xl);
        line-height: var(--jd-line-tight);
        margin: 0 0 var(--jd-space-6);
    }

    .entry {
        margin: 0 0 var(--jd-space-6);
    }

    h3 {
        font-size: var(--jd-text-lg);
        line-height: var(--jd-line-tight);
        margin: 0 0 var(--jd-space-2);
    }

    .entry p {
        margin: 0;
    }

    .change {
        margin: var(--jd-space-3) 0 0;
        font: inherit;
        font-size: var(--jd-text-sm);
        color: var(--jd-text-primary);
        background: var(--jd-surface-raised);
        border: 1px solid var(--jd-border);
        border-radius: var(--jd-radius-sm);
        padding: var(--jd-space-2) var(--jd-space-4);
        cursor: pointer;
        transition: border-color var(--jd-duration-fast) var(--jd-ease);
    }

    .change:hover {
        border-color: var(--jd-accent);
    }

    .change:focus-visible {
        outline: 2px solid var(--jd-accent);
        outline-offset: 2px;
    }

    .updated {
        margin: var(--jd-space-8) 0 0;
        padding-top: var(--jd-space-4);
        border-top: 1px solid var(--jd-border);
        color: var(--jd-text-muted);
        font-size: var(--jd-text-sm);
    }
</style>
