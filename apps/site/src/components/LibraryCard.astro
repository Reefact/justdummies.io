---
/**
 * One competitor's card (§11.6): a one-line description close to how its own authors
 * would put it, a link to its official repository, and — "the most important part of
 * the page" — when to choose it instead of JustDummies. That last line is mandatory,
 * never empty, never ironic; there is no branch here that can render the card without it.
 */
import { localeFromPath } from '../i18n/routing';
import { useTranslations } from '../i18n/ui';
import type { Competitor } from '../comparison';

interface Props {
    entry: Competitor;
}

const { entry } = Astro.props;

const t = useTranslations(localeFromPath(Astro.url.pathname));

const name: string = entry.nameKey ? t(entry.nameKey) : (entry.name as string);
---

<article class="card">
    <h3>{name}</h3>
    <p class="description">{t(entry.descriptionKey)}</p>

    {
        entry.repo && (
            <a class="repo" href={entry.repo} target="_blank" rel="noopener noreferrer">
                {t('why.library.repoLink')}
                <span class="visually-hidden"> {t('state.newTab')}</span>
            </a>
        )
    }

    <h4>{t('why.library.chooseHeading')}</h4>
    <p class="choose">{t(entry.chooseInsteadKey)}</p>
</article>

<style>
    .card {
        border: 1px solid var(--jd-border);
        border-radius: var(--jd-radius-md);
        background: var(--jd-surface);
        padding: var(--jd-space-4);
    }

    h3 {
        font-size: var(--jd-text-base);
        font-weight: 600;
        margin: 0 0 var(--jd-space-2);
    }

    .description {
        margin: 0 0 var(--jd-space-3);
        color: var(--jd-text-muted);
    }

    .repo {
        display: inline-block;
        font-size: var(--jd-text-sm);
        margin: 0 0 var(--jd-space-4);
    }

    h4 {
        font-size: var(--jd-text-sm);
        font-weight: 600;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        color: var(--jd-text-muted);
        margin: 0 0 var(--jd-space-2);
    }

    .choose {
        margin: 0;
    }

    /* .visually-hidden is declared once, globally, in base.css. */
</style>
