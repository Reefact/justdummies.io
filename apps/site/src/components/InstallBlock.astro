---
/**
 * The install block, instantiated wherever the narrative earns one.
 *
 * It is built as a **row of slots**, not as a fixed composition of three things.
 * Its content will grow — a documentation link, the tool's own command — and
 * redrawing the row then costs more than designing it at its final width now. The
 * documentation slot is therefore already here, with no target.
 *
 * That empty slot follows the rule that nothing visible leads nowhere without its
 * state being said. It is **not** given a `disabled` attribute: a disabled control
 * leaves the tab order, so its explanation becomes unreachable by keyboard and
 * invisible to a screen reader. It stays focusable, carries `aria-disabled`, and
 * shows its state **in plain text beside the label** — there is no hover on a
 * phone.
 */
import CopyableCommand from './CopyableCommand.astro';
import { localeFromPath } from '../i18n/routing';
import { useTranslations } from '../i18n/ui';
import { site } from '../site';

interface Props {
    /** Stable, position-independent identifier passed to every command in the row. */
    placement: string;
    /**
     * What this instance offers, which is what the visitor has been shown by the time
     * they reach it (§9.3). An exit that offers the tool before the tool has appeared
     * asks the reader to judge something they have no way to judge yet, and reads as
     * noise rather than as a door.
     */
    offer?: 'library' | 'library-and-tool' | 'everything';
    /**
     * `compact` is §7.4's reduced form: one command and one link, for a place that owes the
     * visitor the offer without owing them the whole row. The full form belongs at the
     * narrative's reward moments, where a reader has just been given a reason to want it and
     * the screen is theirs to spend.
     */
    variant?: 'full' | 'compact';
}

const { placement, offer = 'library', variant = 'full' } = Astro.props;
const compact: boolean = variant === 'compact';

const t = useTranslations(localeFromPath(Astro.url.pathname));

const documentationPending: boolean = site.documentation.status === 'pending';
const withTool: boolean = offer === 'library-and-tool' || offer === 'everything';
const withAdapter: boolean = offer === 'everything';
---

<div class="install" data-compact={compact ? '' : undefined}>
    <div class="slot">
        {!compact && <h3>{t('install.cli')}</h3>}
        <CopyableCommand command={site.library.installCommand} placement={placement} variant="dotnet-cli" />
    </div>

    <div class="slot" hidden={compact}>
        <h3>{t('install.packageManager')}</h3>
        <CopyableCommand
            command={site.library.packageManagerCommand}
            placement={placement}
            variant="package-manager"
        />
    </div>

    {
        withTool && (
            <div class="slot">
                <h3>{t('install.tool')}</h3>
                <CopyableCommand command={site.cli.installCommand} placement={placement} variant="dotnet-tool" />
            </div>
        )
    }

    {
        withAdapter && (
            <div class="slot">
                <h3>{t('install.adapter')}</h3>
                <CopyableCommand command={site.xunit.installCommand} placement={placement} variant="xunit-adapter" />
            </div>
        )
    }

    <nav class="links" aria-label={t('install.nuget')}>
        <a href={site.library.nuget} data-placement={placement} data-variant="nuget-link">
            {t('install.nuget')}
        </a>

        {
            withTool && (
                <a href={site.cli.nuget} data-placement={placement} data-variant="nuget-tool-link">
                    {t('install.nugetTool')}
                </a>
            )
        }

        {
            withAdapter && (
                <a href={site.xunit.nuget} data-placement={placement} data-variant="nuget-adapter-link">
                    {t('install.nugetAdapter')}
                </a>
            )
        }

        {
            compact ? null : documentationPending ? (
                <span class="pending" role="link" aria-disabled="true" tabindex="0">
                    {t('install.documentation')}
                    <span class="state"> · {t('state.comingSoon')}</span>
                </span>
            ) : (
                <a href={site.documentation.url ?? '#'} data-placement={placement} data-variant="documentation">
                    {t('install.documentation')}
                </a>
            )
        }
    </nav>
</div>

<style>
    .install {
        display: grid;
        /* Explicit, because the implicit track would take its automatic minimum from
           the widest command it holds and grow the whole row past the viewport. */
        grid-template-columns: minmax(0, 1fr);
        gap: var(--jd-space-4);
        max-width: 46rem;
    }

    .slot h3 {
        font-size: var(--jd-text-sm);
        font-weight: 400;
        color: var(--jd-text-muted);
        margin: 0 0 var(--jd-space-2);
    }

    .links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--jd-space-6);
        font-size: var(--jd-text-sm);
    }

    /* Reachable by keyboard, and saying why it leads nowhere. The colour is the
       neutral tone reserved for pending state — distinct from the accent and from
       the error colour, because this is neither. */
    .pending {
        color: var(--jd-text-muted);
        cursor: default;
    }

    .pending:focus-visible {
        outline: 2px solid var(--jd-accent);
        outline-offset: 2px;
    }

    .state {
        font-style: italic;
    }
</style>
