---
/**
 * An expression and what the build recorded about it.
 *
 * The component takes an identifier and a choice of *which* record to show, and
 * nothing else. That is deliberate: there is no prop through which a page could pass
 * code of its own, a value of its own, or a message of its own. Displaying an
 * expression that was never compiled, a value nobody drew, or a refusal that never
 * happened is not something a page is able to do.
 */
import { highlight } from '../highlight';
import { localeFromPath } from '../i18n/routing';
import { useTranslations } from '../i18n/ui';
import { refusal, sampleValue, sampleValues, snippet, testRun, toolWritten } from '../samples';

interface Props {
    /** The identifier marked in the validated C# source. */
    id: string;
    /**
     * Which record the build holds for this expression:
     *
     * - `value`    — one drawn value, the ordinary case;
     * - `sequence` — several draws of the same chain, which is how "arbitrary" is
     *                shown rather than asserted;
     * - `refusal`  — what the domain answered when it rejected the expression;
     * - `none`     — nothing was run. Code the site quotes rather than executes,
     *                such as a test body or a set of guard clauses.
     */
    outcome?: 'value' | 'sequence' | 'refusal' | 'none';
    /**
     * A second validated snippet, shown in the same box under a blank line.
     *
     * For the beat that has to show a test and the thing that makes it read at once:
     * two boxes put a border and a gap through the middle of one argument, and read as
     * two subjects. The source stays where it belongs — the two regions live in the
     * files and namespaces that make them compile — and only the display joins them.
     */
    also?: string;
    /**
     * A recorded test run to print under the code, by identifier.
     *
     * For the scene where the point is what running it does: the seed was read off a
     * failure two scenes earlier, and the claim is that pasting it brings that same failure
     * back. A reader should not have to take the second half on trust when the build has
     * the output — it is the same recording, which is exactly what makes it evidence.
     */
    ran?: string;
    /**
     * Where the code comes from: a marked region of the snippet project, or a whole file the
     * tool wrote and the build recorded. Both are compiled with the analyzers on, and neither
     * can be typed into a page.
     */
    from?: 'snippet' | 'tool';
}

const { id, outcome = 'value', also, ran, from = 'snippet' } = Astro.props;

const t = useTranslations(localeFromPath(Astro.url.pathname));
const source: string = from === 'tool' ? toolWritten(id) : snippet(id);
const code: string = also === undefined ? source : `${source}\n\n${snippet(also)}`;

/**
 * Long enough that the block is worth folding. The one figure that reaches it is the file
 * the tool writes, at a hundred and one lines — two screens of code in the middle of a
 * scene, which buries the words underneath it.
 */
const FOLDS_ABOVE: number = 40;
const folds: boolean = code.split('\n').length > FOLDS_ABOVE;

const drawn: string[] = outcome === 'sequence' ? sampleValues(id) : outcome === 'value' ? [sampleValue(id)] : [];
const rejected: string = outcome === 'refusal' ? refusal(id) : '';
const printed: string = ran === undefined ? '' : testRun(ran);
---

{/*
  `set:html` and not a template expression, because the colouring is markup. What it inserts
  is what `highlight` produced, and that function escapes every character it was given before
  wrapping any of it — it also reads its own output back and throws if a single character was
  lost, so a page cannot publish code that differs from what compiled.
*/}
<figure class="sample" data-outcome={outcome} data-folds={folds ? '' : undefined}>
    <pre data-code><code set:html={highlight(code, 'csharp')} /></pre>

    {/*
      The control is `hidden` in the markup and the script unhides it, which is the same rule
      the copy button and the install tabs follow (ADR-0004): a reader whose scripting never
      arrives gets the whole file, unfolded, rather than a clipped block no button can open.
      The clipping is applied by the script for exactly that reason.
    */}
    {
        folds && (
            <button
                type="button"
                class="fold"
                hidden
                data-fold
                data-open={t('sample.showWholeFile')}
                data-close={t('sample.fold')}
                data-lines={`${code.split('\n').length} ${t('sample.lines')}`}
            >
                <span data-fold-label />
            </button>
        )
    }

    {
        drawn.length > 0 && (
            <figcaption>
                <span class="arrow" aria-hidden="true">
                    →
                </span>
                <span class="label">{outcome === 'sequence' ? t('sample.producedEachRun') : t('sample.produced')}</span>
                <span class="values">
                    {drawn.map((value) => (
                        <output class="value">{value}</output>
                    ))}
                </span>
            </figcaption>
        )
    }

    {
        printed !== '' && (
            <figcaption class="ran">
                <span class="label">{t('sample.whenItRuns')}</span>
                <pre class="printed" set:html={highlight(printed, 'output')} />
            </figcaption>
        )
    }

    {
        rejected !== '' && (
            <figcaption class="refused">
                <span class="arrow" aria-hidden="true">
                    →
                </span>
                <span class="label">{t('sample.refused')}</span>
                <output class="message">{rejected}</output>
            </figcaption>
        )
    }
</figure>

<script>
    /**
     * Folds a figure that is too tall to sit inside a scene, and gives it a button.
     *
     * IT FOLDS HERE RATHER THAN IN THE STYLESHEET, and that is the whole design. A block
     * clipped by CSS is clipped for everyone, including a reader whose scripting never
     * arrives — and for them the button that reopens it does not exist. So the markup ships
     * the file whole, and only a page that can open it again is allowed to close it.
     *
     * The height is a `max-height`, not a `height`: the fade at the bottom is drawn by the
     * figure and would otherwise hang under a block that has nothing left to hide.
     */
    const CLIPPED = '32rem';

    for (const figure of document.querySelectorAll<HTMLElement>('.sample[data-folds]')) {
        const code: HTMLElement | null = figure.querySelector('[data-code]');
        const button: HTMLButtonElement | null = figure.querySelector('[data-fold]');
        const label: HTMLElement | null = figure.querySelector('[data-fold-label]');

        if (code === null || button === null || label === null) {
            continue;
        }

        const lines: string = button.dataset.lines ?? '';

        const fold = (closed: boolean): void => {
            code.style.maxHeight = closed ? CLIPPED : '';

            // `delete`, not an assignment of `undefined`. Assigning it writes the *string*
            // "undefined" into the attribute, so `data-folded` was still set on an open
            // figure: the CSS that draws the fade kept matching, and the click handler's
            // `=== undefined` was never true again — the button opened the file once and
            // then did nothing for the rest of the page's life.
            if (closed) {
                figure.dataset.folded = '';
            } else {
                delete figure.dataset.folded;
            }

            button.setAttribute('aria-expanded', String(!closed));
            // The count belongs on the opening label alone: "Fold (101 lines)" says nothing
            // a reader looking at the open file cannot already see.
            label.textContent = closed ? `${button.dataset.open} (${lines})` : String(button.dataset.close);
        };

        fold(true);
        button.hidden = false;

        button.addEventListener('click', () => {
            const closing: boolean = figure.dataset.folded === undefined;

            /*
             * KEEP THE READER WHERE THEY WERE READING.
             *
             * Closing takes about sixteen hundred pixels out of the document, and the browser
             * keeps `scrollY` exactly as it was — so everything below the block rises by that
             * much and the reader, who was at the end of the file with their hand on this
             * button, is thrown that far down the page. Measured before this existed: the
             * button jumped from 337px down the viewport to -1304, a drift of 1641px, while
             * scrollY did not move at all.
             *
             * So the button is pinned. Its position is read before and after, and the page is
             * scrolled by the difference — which puts it back under the eye that just pressed
             * it, with the folded block above it and the rest of the page where it belongs.
             *
             * The transition is suspended for that one relayout, because a `max-height` that
             * animates has not moved yet when the second measurement is taken: the correction
             * would be computed from the height the block is leaving rather than the one it is
             * going to, which is a correction of zero. Closing is therefore instant and exact.
             * Opening keeps its animation, and needs no correction — it grows downwards, below
             * a reader who is looking at the top of the block.
             */
            const before: number = button.getBoundingClientRect().top;

            if (closing) {
                code.style.transition = 'none';
            }

            fold(closing);

            if (closing) {
                // Reading a geometric property is what forces the new height to be laid out
                // now rather than at the next paint.
                void code.offsetHeight;
                window.scrollBy(0, button.getBoundingClientRect().top - before);
                code.style.transition = '';
            }
        });
    }
</script>

<style>
    .sample {
        margin: 0;
        background: var(--jd-surface);
        border: 1px solid var(--jd-border);
        border-radius: var(--jd-radius-md);
        overflow: hidden;
    }

    pre {
        margin: 0;
        padding: var(--jd-space-4);
        overflow-x: auto;
        font-family: var(--jd-font-mono);
        font-size: var(--jd-text-sm);
        line-height: 1.5;
    }

    figcaption {
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
        gap: var(--jd-space-2);
        padding: var(--jd-space-3) var(--jd-space-4);
        border-top: 1px solid var(--jd-border);
        background: var(--jd-surface-raised);
        font-size: var(--jd-text-sm);
    }

    .arrow,
    .label {
        color: var(--jd-text-muted);
    }

    .values {
        display: flex;
        flex-wrap: wrap;
        gap: var(--jd-space-1) var(--jd-space-4);
    }

    .value {
        font-family: var(--jd-font-mono);
        color: var(--jd-generated);
    }

    /* The refusal is stated, not dramatised: it is the domain doing its job, and the
       scene it belongs to is about the rules, not about a failure. Hence the error
       colour on the message alone, and no border, background or icon around it. */
    .message {
        font-family: var(--jd-font-mono);
        color: var(--jd-error);
    }

    /* The run stacks rather than sitting on one line: it is four lines of output, not a
       value. Everything else about it is the caption strip the drawn values already use, so
       the two read as the same kind of thing — what the build saw. */
    .ran {
        flex-direction: column;
        align-items: stretch;
        gap: var(--jd-space-2);
    }

    /* Clipped by the script, never here — see its note. The transition is on the property the
       script sets, so opening and closing both read as the block growing rather than jumping.

       `overflow-anchor: none` turns off the browser's own scroll anchoring for this block —
       the heuristic that already tries to keep a reader's position stable when content above
       them resizes, which is exactly what the click handler's `scrollBy` does on purpose and
       by an exact amount. Left on, the two correct the same shrink independently, and which
       one's layout pass lands first is a race: the button read this repository's own browser
       suite anywhere from 0 to several hundred pixels off, on no schedule a retry could rely
       on. One correction, the deliberate one, is what a reader should get. */
    [data-code] {
        overflow-y: hidden;
        overflow-anchor: none;
        transition: max-height var(--jd-duration-base) var(--jd-ease);
    }

    /* The fade says the block continues, and it sits above the button rather than under it.
       `pointer-events: none` so it never eats a selection drag over the last visible line. */
    .sample[data-folded] [data-code] {
        mask-image: linear-gradient(to bottom, black calc(100% - 4rem), transparent);
    }

    .fold {
        width: 100%;
        font: inherit;
        font-size: var(--jd-text-sm);
        color: var(--jd-text-muted);
        background: var(--jd-surface-raised);
        border: 0;
        border-top: 1px solid var(--jd-border);
        padding: var(--jd-space-3) var(--jd-space-4);
        text-align: left;
        cursor: pointer;
    }

    .fold:hover {
        color: var(--jd-text-primary);
    }

    .fold:focus-visible {
        outline: 2px solid var(--jd-accent);
        outline-offset: -2px;
    }

    @media (prefers-reduced-motion: reduce) {
        [data-code] {
            transition: none;
        }
    }

    .printed {
        margin: 0;
        overflow-x: auto;
        font-size: 0.75rem;
        line-height: 1.5;
        color: var(--jd-text-muted);
    }
</style>
