---
/**
 * An expression and what the build recorded about it.
 *
 * The component takes an identifier and a choice of *which* record to show, and
 * nothing else. That is deliberate: there is no prop through which a page could pass
 * code of its own, a value of its own, or a message of its own. Displaying an
 * expression that was never compiled, a value nobody drew, or a refusal that never
 * happened is not something a page is able to do.
 */
import { highlight } from '../highlight';
import { localeFromPath } from '../i18n/routing';
import { useTranslations } from '../i18n/ui';
import { refusal, sampleValue, sampleValues, snippet, testRun } from '../samples';

interface Props {
    /** The identifier marked in the validated C# source. */
    id: string;
    /**
     * Which record the build holds for this expression:
     *
     * - `value`    — one drawn value, the ordinary case;
     * - `sequence` — several draws of the same chain, which is how "arbitrary" is
     *                shown rather than asserted;
     * - `refusal`  — what the domain answered when it rejected the expression;
     * - `none`     — nothing was run. Code the site quotes rather than executes,
     *                such as a test body or a set of guard clauses.
     */
    outcome?: 'value' | 'sequence' | 'refusal' | 'none';
    /**
     * A second validated snippet, shown in the same box under a blank line.
     *
     * For the beat that has to show a test and the thing that makes it read at once:
     * two boxes put a border and a gap through the middle of one argument, and read as
     * two subjects. The source stays where it belongs — the two regions live in the
     * files and namespaces that make them compile — and only the display joins them.
     */
    also?: string;
    /**
     * A recorded test run to print under the code, by identifier.
     *
     * For the scene where the point is what running it does: the seed was read off a
     * failure two scenes earlier, and the claim is that pasting it brings that same failure
     * back. A reader should not have to take the second half on trust when the build has
     * the output — it is the same recording, which is exactly what makes it evidence.
     */
    ran?: string;
}

const { id, outcome = 'value', also, ran } = Astro.props;

const t = useTranslations(localeFromPath(Astro.url.pathname));
const code: string = also === undefined ? snippet(id) : `${snippet(id)}\n\n${snippet(also)}`;

const drawn: string[] = outcome === 'sequence' ? sampleValues(id) : outcome === 'value' ? [sampleValue(id)] : [];
const rejected: string = outcome === 'refusal' ? refusal(id) : '';
const printed: string = ran === undefined ? '' : testRun(ran);
---

{/*
  `set:html` and not a template expression, because the colouring is markup. What it inserts
  is what `highlight` produced, and that function escapes every character it was given before
  wrapping any of it — it also reads its own output back and throws if a single character was
  lost, so a page cannot publish code that differs from what compiled.
*/}
<figure class="sample" data-outcome={outcome}>
    <pre><code set:html={highlight(code, 'csharp')} /></pre>

    {
        drawn.length > 0 && (
            <figcaption>
                <span class="arrow" aria-hidden="true">
                    →
                </span>
                <span class="label">{outcome === 'sequence' ? t('sample.producedEachRun') : t('sample.produced')}</span>
                <span class="values">
                    {drawn.map((value) => (
                        <output class="value">{value}</output>
                    ))}
                </span>
            </figcaption>
        )
    }

    {
        rejected !== '' && (
            <figcaption class="refused">
                <span class="arrow" aria-hidden="true">
                    →
                </span>
                <span class="label">{t('sample.refused')}</span>
                <output class="message">{rejected}</output>
            </figcaption>
        )
    }
</figure>

<style>
    .sample {
        margin: 0;
        background: var(--jd-surface);
        border: 1px solid var(--jd-border);
        border-radius: var(--jd-radius-md);
        overflow: hidden;
    }

    pre {
        margin: 0;
        padding: var(--jd-space-4);
        overflow-x: auto;
        font-family: var(--jd-font-mono);
        font-size: var(--jd-text-sm);
        line-height: 1.5;
    }

    figcaption {
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
        gap: var(--jd-space-2);
        padding: var(--jd-space-3) var(--jd-space-4);
        border-top: 1px solid var(--jd-border);
        background: var(--jd-surface-raised);
        font-size: var(--jd-text-sm);
    }

    .arrow,
    .label {
        color: var(--jd-text-muted);
    }

    .values {
        display: flex;
        flex-wrap: wrap;
        gap: var(--jd-space-1) var(--jd-space-4);
    }

    .value {
        font-family: var(--jd-font-mono);
        color: var(--jd-generated);
    }

    /* The refusal is stated, not dramatised: it is the domain doing its job, and the
       scene it belongs to is about the rules, not about a failure. Hence the error
       colour on the message alone, and no border, background or icon around it. */
    .message {
        font-family: var(--jd-font-mono);
        color: var(--jd-error);
    }
</style>
