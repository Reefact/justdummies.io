---
/**
 * An expression and what it produced, both of them generated.
 *
 * The component takes an identifier and nothing else, which is deliberate: there is
 * no prop through which a page could pass code of its own, or a value of its own.
 * Displaying an expression that was never compiled, or a value nobody drew, is not
 * something a page is able to do.
 */
import { localeFromPath } from '../i18n/routing';
import { useTranslations } from '../i18n/ui';
import { sampleValue, snippet } from '../samples';

interface Props {
    /** The identifier marked in the validated C# source. */
    id: string;
}

const { id } = Astro.props;

const t = useTranslations(localeFromPath(Astro.url.pathname));
const code: string = snippet(id);
const value: string = sampleValue(id);
---

<figure class="sample">
    <pre><code>{code}</code></pre>

    <figcaption>
        <span class="arrow" aria-hidden="true">→</span>
        <span class="label">{t('sample.produced')}</span>
        <output class="value">{value}</output>
    </figcaption>
</figure>

<style>
    .sample {
        margin: 0;
        background: var(--jd-surface);
        border: 1px solid var(--jd-border);
        border-radius: var(--jd-radius-md);
        overflow: hidden;
    }

    pre {
        margin: 0;
        padding: var(--jd-space-4);
        overflow-x: auto;
        font-family: var(--jd-font-mono);
        font-size: var(--jd-text-sm);
        line-height: 1.5;
    }

    figcaption {
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
        gap: var(--jd-space-2);
        padding: var(--jd-space-3) var(--jd-space-4);
        border-top: 1px solid var(--jd-border);
        background: var(--jd-surface-raised);
        font-size: var(--jd-text-sm);
    }

    .arrow,
    .label {
        color: var(--jd-text-muted);
    }

    .value {
        font-family: var(--jd-font-mono);
        color: var(--jd-generated);
    }
</style>
