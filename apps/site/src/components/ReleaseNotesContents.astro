---
/**
 * The table of contents beside a major version's notes: the train's majors, the releases
 * inside the one being read, and each release's own rubrics.
 *
 * THREE LEVELS, ONLY ONE OF THEM EXPANDED. The major on screen shows its releases and their
 * rubrics as anchors into the column beside it; the others are a single line each, and a
 * link, because a different major is a different page (ADR-0020). That is what keeps this
 * list short as the library ages — a train at twelve majors adds eleven lines here, not
 * eleven histories.
 *
 * NO SCRIPT DECIDES ANYTHING. Every entry is an anchor or a link, so the whole control works
 * before any script runs, and the browser's own find works on the text it points at — which
 * it did not while a section folded its bullets past the third. The one script is the
 * narrow-screen collapse `ApiCategoryNav` already uses, and the `<details>` it drives is
 * open in the markup, so a reader with no scripting gets the full list rather than a closed
 * box with no way to open it.
 *
 * THE SCROLL-SPY BELOW ADDS, IT NEVER DECIDES. It only ever sets `data-current` and
 * `aria-current` on the entry for whichever section is in front of the reader, and CSS
 * uses the former to bold it exactly the way `.major-label.current` already is above —
 * the same weight-not-colour rule the links follow (see below). If it never runs, every
 * entry is exactly what it was: the same anchor, the same href, the same click. Modelled
 * on `Scene.astro`'s scroll-spy, including its band.
 *
 * Its focus ring is declared here rather than inherited: base.css scopes the site's ring to
 * `a:focus-visible` and `button:focus-visible`, and a `<summary>` is neither — it fell back to
 * the engine's own outline, the one control on this page that did. LanguageSelector.astro
 * declares its own for the same reason.
 *
 * THE LINKS ARE NOT ORANGE. Accent marks the package being read, once, in the switcher
 * above; a whole column of it would make a table of contents look like a call to action.
 * Here the affordance arrives on hover and the current major is held by weight and a rule,
 * never by colour — and `:focus-visible` stays exactly where base.css puts it, because
 * "visible on hover" cannot be allowed to mean "invisible to a keyboard".
 */
import { pathForLocale } from '../i18n/routing';
import { useTranslations, type Locale } from '../i18n/ui';
import { majorSlug, type MajorNotes, type Train } from '../release-notes';

interface Props {
    locale: Locale;
    train: Train;
    /** The major being read; every other one is a link out of this page. */
    notes: MajorNotes;
}

const { locale, train, notes } = Astro.props;
const t = useTranslations(locale);
---

<details class="contents" open data-release-contents>
    <summary>
        {t('releaseNotes.contents')}
        <svg class="chev" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
    </summary>
    <div class="contents-body">
        <nav aria-label={t('releaseNotes.contents')}>
            <ul class="majors">
                {
                    train.majors.map((major) =>
                        major.major === notes.major ? (
                            <li class="major">
                                <p class="major-label current" aria-current="true">
                                    <svg class="marker open" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                                        <path d="m6 4 4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                    {t('releaseNotes.majorLabel')} {major.major}
                                </p>
                                <ul class="releases">
                                    {notes.releases.map((release) => (
                                        <li>
                                            <a class="release-link" href={`#${release.anchor}`}>
                                                {t('releaseNotes.majorLabel')} {release.version}
                                            </a>
                                            {release.sections.length > 0 && (
                                                <ul class="rubrics">
                                                    {release.sections.map((section) => (
                                                        <li>
                                                            <a href={`#${section.anchor}`}>
                                                                {section.label}
                                                                {/* Every release publishes the same rubrics, so a
                                                                    page with two of them lists "✨ New" twice behind
                                                                    two different anchors. The release it belongs to
                                                                    is the sibling link above, outside this one. */}
                                                                <span class="visually-hidden"> — {t('releaseNotes.majorLabel')} {release.version}</span>
                                                            </a>
                                                        </li>
                                                    ))}
                                                </ul>
                                            )}
                                        </li>
                                    ))}
                                </ul>
                            </li>
                        ) : (
                            <li class="major">
                                <a class="major-label" href={pathForLocale(`/release-notes/${train.key}/${majorSlug(major.major)}/`, locale)}>
                                    <svg class="marker" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                                        <path d="m6 4 4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                    {t('releaseNotes.majorLabel')} {major.major}
                                </a>
                            </li>
                        ),
                    )
                }
            </ul>
        </nav>
    </div>
</details>

<script is:inline>
    (function manageNarrowScreenCollapse() {
        const details = document.currentScript.previousElementSibling;

        if (!(details instanceof HTMLDetailsElement)) {
            return;
        }

        const narrowScreen = window.matchMedia('(max-width: 56rem)');

        if (narrowScreen.matches) {
            details.open = false;
        }

        // Widening past the breakpoint hides `summary` (see the media query below), which is
        // the only control that can reopen a closed `<details>` — so a resize or a rotation
        // that crosses the breakpoint has to force `open` back on itself, or the whole table
        // of contents stays stranded closed with nothing left on the page able to reach it.
        narrowScreen.addEventListener('change', (event) => {
            if (!event.matches) {
                details.open = true;
            }
        });
    })();
</script>

<script>
    /**
     * Marks the entry for the section the reader is on, so the table of contents says
     * where they are.
     *
     * Additive by construction: it only ever sets `data-current`/`aria-current` on the
     * entry pointing at whichever target is in front of the reader, and only one entry at
     * a time, so the rest of the list is exactly as it was without it. Every entry is
     * still the anchor or link it always was — this changes what it looks like and what
     * assistive technology is told, never what it does.
     */
    const nav = document.querySelector<HTMLElement>('[data-release-contents] nav');
    const links = nav ? Array.from(nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')) : [];

    if (links.length > 0 && 'IntersectionObserver' in window) {
        const targets: { link: HTMLAnchorElement; el: HTMLElement }[] = [];

        for (const link of links) {
            const id = link.getAttribute('href')?.slice(1);
            const el = id ? document.getElementById(id) : null;

            if (el) {
                targets.push({ link, el });
            }
        }

        // Same band as Scene.astro's scroll-spy: a section is "current" while it is the
        // one in front of the reader, not while any part of it is merely on screen.
        const BAND = '-45% 0px -45% 0px';

        let current: HTMLAnchorElement | undefined;

        function setCurrent(link: HTMLAnchorElement | undefined): void {
            if (current === link) {
                return;
            }
            if (current !== undefined) {
                current.removeAttribute('data-current');
                current.removeAttribute('aria-current');
            }
            current = link;
            if (current !== undefined) {
                current.setAttribute('data-current', '');
                current.setAttribute('aria-current', 'true');
            }
        }

        // A release both is a target (for the heading and summary before its first
        // rubric) and contains its rubrics, each a finer slice of the same scroll — so
        // more than one target can be intersecting the band at once. Tracked here rather
        // than read off the callback's own entries, because the callback only reports
        // what changed, not everything currently true. The smallest of what is currently
        // intersecting wins: a rubric inside a release is never taller than the release
        // itself, so this reads as "prefer the more specific target" without needing to
        // know the nesting explicitly.
        const intersecting = new Set<HTMLElement>();

        // A jump — a click, a direct fragment URL, `history.back()` — names its target
        // precisely and outranks the band until the dust settles. Pinned rather than
        // applied once: `Base.astro`'s own anchor script animates the scroll over up to
        // 900ms with `history.pushState` (which fires no `hashchange` to catch here), and
        // a short rubric can land outside the band entirely — either of which would
        // otherwise have the very next intersection callback overwrite the jump with
        // whatever the band happens to see mid-flight or at rest.
        const PIN_MS = 1000;
        let pinnedUntil = 0;
        let pinTimer: ReturnType<typeof setTimeout> | undefined;

        // Reads whatever the band currently sees, independent of the pin above — called
        // both from the observer once nothing is pinned, and once the pin itself expires,
        // so a reader who scrolled on to a different section *during* that second is not
        // left stranded on the jump's original target for want of a further boundary
        // crossing to report it.
        function applyBandWinner(): void {
            let winner: { link: HTMLAnchorElement; height: number } | undefined;
            for (const target of targets) {
                if (!intersecting.has(target.el)) {
                    continue;
                }
                const height = target.el.getBoundingClientRect().height;
                if (winner === undefined || height < winner.height) {
                    winner = { link: target.link, height };
                }
            }

            // Leaves the last-known entry alone rather than clearing it: the band is a
            // 10% sliver, and a fast scroll can cross a gap between two targets with
            // neither one in it for a frame. That is not the reader having left every
            // section — it is the geometry blinking, and the entry from a moment ago is
            // still the better answer than none.
            if (winner !== undefined) {
                setCurrent(winner.link);
            }
        }

        function pin(link: HTMLAnchorElement): void {
            setCurrent(link);
            pinnedUntil = Date.now() + PIN_MS;
            clearTimeout(pinTimer);
            pinTimer = setTimeout(applyBandWinner, PIN_MS);
        }

        const observer = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    if (entry.isIntersecting) {
                        intersecting.add(entry.target as HTMLElement);
                    } else {
                        intersecting.delete(entry.target as HTMLElement);
                    }
                }

                if (Date.now() >= pinnedUntil) {
                    applyBandWinner();
                }
            },
            { rootMargin: BAND },
        );

        for (const { el } of targets) {
            observer.observe(el);
        }

        for (const { link } of targets) {
            // A modified click — the middle button, Ctrl/Cmd, opening the target in a new
            // tab — is exactly what `Base.astro`'s own anchor script leaves alone (same
            // checks, mirrored here): this document never scrolls, so this entry must not
            // pin as current either.
            link.addEventListener('click', (event) => {
                if (event.button !== 0 || event.metaKey || event.ctrlKey) {
                    return;
                }
                pin(link);
            });
        }

        function pinFromHash(): void {
            const id = decodeURIComponent(location.hash.slice(1));
            const target = targets.find((candidate) => candidate.el.id === id);
            if (target) {
                pin(target.link);
            }
        }

        window.addEventListener('hashchange', pinFromHash);
        pinFromHash();
    }
</script>

<style>
    /* Sticky lives on the `<details>` itself, not on a child of it. Chromium does not let a
       `position: sticky` descendant of an open `<details>` stick to the viewport — it renders
       the computed style as `sticky` but scrolls it as if it were `static`. Only the element
       carrying `open` is exempt from that, which is why the scroll clipping moved here too. */
    .contents {
        position: sticky;
        /* `overflow-y: auto` below forces `overflow-x` off `visible`, which turns this box into
           a clip box — and a focus ring is drawn OUTSIDE the element it belongs to. The outdented
           major link sits flush against this edge, so its ring lost its left side to the clip,
           and left-side overflow cannot be scrolled to in a left-to-right page. Four pixels of
           padding move the clip box out by exactly the ring's width; the negative margin puts the
           content back where it was, to the pixel, inside the layout's own inset. */
        padding-left: 4px;
        margin-left: -4px;
        top: var(--jd-space-4);
        /* A grid item stretches to its row by default, so this box was as tall as the page and
           then clamped to the viewport by the max-height below — 868px of box around 351px of
           links on lib/v1 at 1280x900. What that cost was the top of the list: scrolled to the
           foot of the document the box sat at -103px and `Version 1`, the release and the first
           rubric were above the viewport entirely, with no scrollbar to suggest they were there.
           The short pages lost them from halfway down. Sized to its own content instead, the box
           never has a top to lose. The trade-off is the rule at the end of this block: it now
           stops with the last entry rather than running the column's full height the way
           ApiCategoryNav.astro's does. */
        align-self: start;
        max-height: calc(100svh - 2 * var(--jd-space-4));
        overflow-y: auto;
        border-right: 1px solid var(--jd-border);
    }

    .contents > summary {
        display: none;
    }

    .contents-body {
        padding: 0 var(--jd-space-4) var(--jd-space-8) 0;
    }

    ul {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .majors > li + li {
        margin-top: var(--jd-space-1);
    }

    .major-label {
        display: flex;
        align-items: center;
        gap: var(--jd-space-2);
        margin: 0;
        padding: var(--jd-space-2) 0;
        font-size: var(--jd-text-sm);
        color: var(--jd-text-muted);
        text-decoration: none;
    }

    .major-label.current {
        color: var(--jd-text-primary);
        font-weight: 600;
    }

    .marker {
        width: 12px;
        height: 12px;
        flex: none;
        color: var(--jd-text-muted);
        transition: transform var(--jd-duration-fast) var(--jd-ease);
    }

    .marker.open {
        transform: rotate(90deg);
    }

    .releases {
        margin: var(--jd-space-1) 0 var(--jd-space-3);
        padding-left: var(--jd-space-4);
        border-left: 1px solid var(--jd-border);
    }

    .releases > li + li {
        margin-top: var(--jd-space-3);
    }

    .rubrics {
        margin-top: var(--jd-space-1);
        padding-left: var(--jd-space-3);
    }

    /* Plain text until it is pointed at: the affordance arrives on hover, in the page's own
       ink rather than in accent. */
    .contents a {
        display: block;
        padding: 0.15rem 0;
        font-size: var(--jd-text-sm);
        color: var(--jd-text-muted);
        text-decoration: none;
    }

    .contents a:hover {
        color: var(--jd-text-primary);
        text-decoration: underline;
        text-underline-offset: 0.2em;
    }

    /* Same rule as `.major-label.current`: weight and colour carry "you are here", never
       accent — a whole column of it would read as a call to action, not a table of contents. */
    .contents a[data-current] {
        color: var(--jd-text-primary);
        font-weight: 600;
    }

    .release-link {
        font-family: var(--jd-font-mono);
        color: var(--jd-text-primary);
    }

    .rubrics a {
        padding-left: var(--jd-space-1);
    }

    @media (max-width: 56rem) {
        /* The site's ring, on the one control base.css cannot reach — and above this breakpoint
           the summary is `display: none`, so on a phone it is the only keyboard target the
           table of contents has. */
        .contents > summary:focus-visible {
            outline: 2px solid var(--jd-accent);
            outline-offset: 2px;
        }

        .contents {
            position: static;
            max-height: none;
            overflow: visible;
            border-right: 0;
            border-bottom: 1px solid var(--jd-border);
            margin-bottom: var(--jd-space-6);
        }

        .contents > summary {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: var(--jd-space-2);
            padding: var(--jd-space-3) 0;
            font-weight: 600;
            cursor: pointer;
            list-style: none;
        }

        .contents > summary::-webkit-details-marker {
            display: none;
        }

        .contents > summary .chev {
            width: 14px;
            height: 14px;
            color: var(--jd-text-muted);
            transition: transform var(--jd-duration-base) var(--jd-ease);
        }

        .contents[open] > summary .chev {
            transform: rotate(180deg);
        }

        .contents-body {
            padding: 0 0 var(--jd-space-4);
        }
    }
</style>
