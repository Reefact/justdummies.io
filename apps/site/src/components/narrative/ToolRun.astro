---
/**
 * A command, and what running it printed.
 *
 * Same rule as every other figure on this site: the output is not transcribed. A script
 * runs the command against the same project the snippets compile in and records what came
 * back, so what a visitor reads is the tool speaking rather than a claim about the tool.
 *
 * That matters most where it is least visible. The recap this renders is the tool saying
 * which parameters it inferred and which guard it could not read — and a transcribed
 * version of that line would be exactly the sentence somebody would later be tempted to
 * tidy up.
 *
 * The command comes from the same central metadata the install block reads, so the command
 * shown and the command recorded cannot drift apart.
 */
import { testRun, toolOutput } from '../../samples';

interface Props {
    /** The recorded run, by identifier. */
    id: string;
    /**
     * The command line as the visitor should type it. Omitted for a recorded test run:
     * how a reader invokes their own suite is their business, and inventing a command
     * line for it would be the one line on this page nobody had run.
     */
    command?: string;
    /** Which recording to read: a command's output, or a test run's. */
    from?: 'tool' | 'test';
}

const { id, command, from = 'tool' } = Astro.props;

const output: string = from === 'tool' ? toolOutput(id) : testRun(id);
---

<figure class="run">
    {command !== undefined && <pre class="typed"><span class="prompt" aria-hidden="true">$</span> <code>{command}</code></pre>}
    <pre class="printed">{output}</pre>
</figure>

<style>
    .run {
        margin: 0;
        background: var(--jd-surface);
        border: 1px solid var(--jd-border);
        border-radius: var(--jd-radius-md);
        overflow: hidden;
    }

    pre {
        margin: 0;
        padding: var(--jd-space-4);
        overflow-x: auto;
        font-family: var(--jd-font-mono);
        line-height: 1.5;
    }

    .typed {
        font-size: var(--jd-text-sm);
        border-bottom: 1px solid var(--jd-border);
        background: var(--jd-surface-raised);
    }

    .prompt {
        color: var(--jd-accent);
        user-select: none;
    }

    /*
     * Smaller than the code blocks, and deliberately. The recap's widest line is 128
     * characters, and the words that make this scene worth showing — the ones naming the
     * guard the tool could not read — are at the far right of it. At the ordinary size
     * that line needs a sideways scroll on a desktop screen, which is the same as not
     * being there.
     */
    .printed {
        font-size: 0.75rem;
        color: var(--jd-text-muted);
    }
</style>
