---
/**
 * One beat of the narrative: a short claim, and the code that makes it.
 *
 * A scene names its prose by translation key rather than receiving the text, so a key
 * missing from a locale is a compile error here too, and no sentence can be typed into
 * a page. Its code is named by snippet identifier, for the same reason.
 *
 * THE FIGURE IS THE SCENE, AND IT IS FULL WIDTH. Two defects came from it not being:
 *
 *   A code block in half the measure needs a horizontal scrollbar for lines it should
 *   never have had to scroll. Every figure on this page is at most 78 characters, and
 *   the two recorded terminals 130 at a smaller size; all of them fit across the full
 *   measure and several of them do not fit across half of it.
 *
 *   And a figure beside its prose is a figure the reader has to pair up by eye. When
 *   several scenes are on screen at once — which a short scene guarantees — the pairing
 *   goes wrong: a heading reads next to code belonging to a scene three below it. Under
 *   its own heading, there is nothing left to pair.
 *
 * A SCENE HOLDS THE SCREEN, so scrolling advances the story rather than sliding a
 * document past. What that buys is the figure landing in roughly the same place from one
 * scene to the next, which is what makes the code read as transforming rather than as
 * being restated — §9.1's continuous transformation, obtained from the layout instead of
 * from a script.
 *
 * WHAT IT COSTS TO EXIST (§9.7). A scene is built four times — desktop, mobile, reduced
 * motion, and without JavaScript — and this one is the same build in all four. The
 * layout is CSS, the figure sits in the document under the heading it belongs to, and
 * the only thing script adds is the rail marker saying where the reader is. Without it
 * every marker stays hollow and not one word moves.
 */
import CodeSample from '../CodeSample.astro';
import { localeFromPath } from '../../i18n/routing';
import { useTranslations, type UiKey } from '../../i18n/ui';

interface Props {
    /**
     * Stable identifier for this beat: its anchor, and what a measurement would call
     * it. Never an ordinal — the scene count has changed before, and naming scenes by
     * position makes two measurement periods incomparable.
     */
    name: string;
    title: UiKey;
    body: UiKey;
    /**
     * The identifier marked in the validated C# source. Omitted when the scene supplies
     * its own figure through the slot — a recorded terminal, say, which is neither an
     * expression nor a value.
     */
    sample?: string;
    outcome?: 'value' | 'sequence' | 'refusal' | 'none';
}

const { name, title, body, sample, outcome = 'value' } = Astro.props;

const t = useTranslations(localeFromPath(Astro.url.pathname));

const ownFigure: boolean = Astro.slots.has('default');

if (!ownFigure && sample === undefined) {
    throw new Error(`Scene "${name}" has neither a sample nor a figure of its own, so it would render prose alone.`);
}
---

<section class="scene" id={name} data-scene={name} aria-labelledby={`${name}-title`}>
    <h3 id={`${name}-title`}>{t(title)}</h3>

    <div class="figure">
        {ownFigure ? <slot /> : <CodeSample id={sample!} outcome={outcome} />}
    </div>

    <p class="commentary">{t(body)}</p>
</section>

<script>
    /**
     * Marks the scene the reader is on, so the rail says where they are.
     *
     * Additive by construction: it only ever sets an attribute that CSS uses to fill a
     * marker. If this never runs — no scripting, an error above it, a browser without
     * IntersectionObserver — every marker stays hollow and every word stays where it
     * was. There is nothing here to un-hide.
     */
    const scenes: HTMLElement[] = Array.from(document.querySelectorAll<HTMLElement>('[data-scene]'));

    if (scenes.length > 0 && 'IntersectionObserver' in window) {
        // The band across the middle of the viewport. A scene is "current" while it is
        // the one the reader has in front of them, not while any part of it is visible.
        const BAND: string = '-45% 0px -45% 0px';

        let current: HTMLElement | undefined;

        const observer: IntersectionObserver = new IntersectionObserver(
            (entries: IntersectionObserverEntry[]) => {
                for (const entry of entries) {
                    if (!entry.isIntersecting) {
                        continue;
                    }

                    if (current !== undefined && current !== entry.target) {
                        delete current.dataset.current;
                    }

                    current = entry.target as HTMLElement;
                    current.dataset.current = '';
                }
            },
            { rootMargin: BAND },
        );

        for (const scene of scenes) {
            observer.observe(scene);
        }
    }
</script>

<style>
    .scene {
        display: flex;
        flex-direction: column;
        gap: var(--jd-space-4);
        padding-bottom: var(--jd-space-16);
    }

    h3 {
        font-size: var(--jd-text-lg);
        line-height: var(--jd-line-tight);
        margin: 0;
    }

    /*
     * The commentary keeps a reading measure while the figure takes the whole width. A
     * paragraph as wide as a code block is a paragraph nobody finishes: the eye loses the
     * start of the next line somewhere in the middle of this one.
     */
    .commentary {
        margin: 0;
        max-width: 42rem;
        color: var(--jd-text-muted);
    }

    @media (min-width: 48rem) {
        /*
         * A scene holds the screen, and what is in it is centred — so the figure lands in
         * roughly the same place from one scene to the next, and scrolling reads as the
         * same code changing rather than as a new block arriving.
         *
         * `min-height`, never `height`: a scene whose figure is taller than the viewport
         * grows rather than clipping, and the recorded terminals are the tallest things on
         * this page.
         */
        .scene {
            position: relative;
            min-height: 100vh;
            justify-content: center;
            gap: var(--jd-space-6);
            padding: var(--jd-space-16) 0 var(--jd-space-16) var(--jd-space-8);
        }

        /*
         * The rail. Drawn from the scene itself rather than from the act, so the segments
         * join without anything having to know how many scenes there are. Its marker sits
         * at the middle of the scene now that a scene is a screen — beside the figure,
         * which is what the reader is looking at.
         */
        .scene::before {
            content: '';
            position: absolute;
            left: 0.4375rem;
            top: 0;
            bottom: 0;
            width: 1px;
            background: var(--jd-border);
        }

        .scene::after {
            content: '';
            position: absolute;
            left: 0;
            top: 50%;
            width: 0.9375rem;
            height: 0.9375rem;
            border: 1px solid var(--jd-border);
            border-radius: 50%;
            background: var(--jd-background);
            transition:
                background-color var(--jd-duration-base) var(--jd-ease),
                border-color var(--jd-duration-base) var(--jd-ease);
        }

        .scene[data-current]::after {
            border-color: var(--jd-accent);
            background: var(--jd-accent);
        }
    }
</style>
