---
/**
 * One beat of the narrative: a short claim, and the code that makes it.
 *
 * A scene names its prose by translation key rather than receiving the text, so a key
 * missing from a locale is a compile error here too, and no sentence can be typed into
 * a page. Its code is named by snippet identifier, for the same reason.
 *
 * THE FIGURE IS THE SCENE, AND IT IS FULL WIDTH. Two defects came from it not being:
 *
 *   A code block in half the measure needs a horizontal scrollbar for lines it should
 *   never have had to scroll. Every figure on this page is at most 78 characters, and
 *   the two recorded terminals 130 at a smaller size; all of them fit across the full
 *   measure and several of them do not fit across half of it.
 *
 *   And a figure beside its prose is a figure the reader has to pair up by eye. When
 *   several scenes are on screen at once — which a short scene guarantees — the pairing
 *   goes wrong: a heading reads next to code belonging to a scene three below it. Under
 *   its own heading, there is nothing left to pair.
 *
 * A SCENE ARRIVES, it no longer holds the screen. It did — a full viewport each — and
 * that was ADR-0003's way of making scrolling feel like advancing rather than sliding a
 * document past. It bought the feeling with empty space, roughly a screen of it between
 * every code block, and the emptiness was reported before the feeling was. The reveal
 * below buys the same thing and costs no space at all, so the height goes. Decision:
 * ADR-0005, which supersedes that half of ADR-0003; the other half — a figure at full
 * width under its own heading — is untouched and is what the two defects above bought.
 *
 * WHAT IT COSTS TO EXIST (§9.7). A scene is built four times — desktop, mobile, reduced
 * motion, and without JavaScript — and this one is the same build in all four. What
 * changes between them is whether the scene fades in: reduced motion is handed the
 * finished state, and a page with no scripting is never given the unfinished one. Not
 * one word moves in either, and nothing is missing from either.
 */
import CodeSample from '../CodeSample.astro';
import { localeFromPath } from '../../i18n/routing';
import { useTranslations, type UiKey } from '../../i18n/ui';

interface Props {
    /**
     * Stable identifier for this beat: its anchor, and what a measurement would call
     * it. Never an ordinal — the scene count has changed before, and naming scenes by
     * position makes two measurement periods incomparable.
     */
    name: string;
    title: UiKey;
    body: UiKey;
    /**
     * The identifier marked in the validated C# source. Omitted when the scene supplies
     * its own figure through the slot — a recorded terminal, say, which is neither an
     * expression nor a value.
     */
    sample?: string;
    outcome?: 'value' | 'sequence' | 'refusal' | 'none';
    /**
     * One sentence between the title and the figure, for a scene whose figure is an offer
     * rather than an argument. The last exit needs it: "Envie d'essayer ?" is an invitation
     * and a row of install commands underneath is the answer, but nothing between them says
     * what a reader is agreeing to. Every other scene puts its words after the figure,
     * because there the figure is the evidence and the words are what it shows.
     */
    lead?: UiKey;
    /** A recorded run to print under the figure. Passed through to the sample. */
    ran?: string;
}

const { name, title, body, sample, outcome = 'value', lead, ran } = Astro.props;

const t = useTranslations(localeFromPath(Astro.url.pathname));

const ownFigure: boolean = Astro.slots.has('default');

if (!ownFigure && sample === undefined) {
    throw new Error(`Scene "${name}" has neither a sample nor a figure of its own, so it would render prose alone.`);
}
---

<section class="scene" id={name} data-scene={name} aria-labelledby={`${name}-title`}>
    {/*
      Three reveal groups rather than one on the section, so the heading, the figure and
      the words about it arrive in the order they are read. The section itself is not a
      group: a scene taller than the viewport would then be waiting on its own bottom edge.
    */}
    <h3 id={`${name}-title`} data-reveal>{t(title)}</h3>

    {lead !== undefined && <p class="lead" data-reveal>{t(lead)}</p>}

    <div class="figure" data-reveal data-reveal-delay="1">
        {ownFigure ? <slot /> : <CodeSample id={sample!} outcome={outcome} ran={ran} />}
    </div>

    <p class="commentary" data-reveal data-reveal-delay="2">{t(body)}</p>
</section>

<script>
    /**
     * Marks the scene the reader is on, so the rail says where they are.
     *
     * Additive by construction: it only ever sets an attribute that CSS uses to fill a
     * marker. If this never runs — no scripting, an error above it, a browser without
     * IntersectionObserver — every marker stays hollow and every word stays where it
     * was. There is nothing here to un-hide.
     */
    const scenes: HTMLElement[] = Array.from(document.querySelectorAll<HTMLElement>('[data-scene]'));

    if (scenes.length > 0 && 'IntersectionObserver' in window) {
        // The band across the middle of the viewport. A scene is "current" while it is
        // the one the reader has in front of them, not while any part of it is visible.
        const BAND: string = '-45% 0px -45% 0px';

        let current: HTMLElement | undefined;

        const observer: IntersectionObserver = new IntersectionObserver(
            (entries: IntersectionObserverEntry[]) => {
                for (const entry of entries) {
                    if (!entry.isIntersecting) {
                        continue;
                    }

                    if (current !== undefined && current !== entry.target) {
                        delete current.dataset.current;
                    }

                    current = entry.target as HTMLElement;
                    current.dataset.current = '';

                    // Said out loud, to whoever is listening. This component knows the
                    // reader has arrived at a beat; it deliberately does not know that
                    // anything measures them, which is the same arrangement
                    // `CopyableCommand` has with the collector. A second observer
                    // watching the same scroll would be the alternative, and this page
                    // already argues against paying for one twice.
                    document.dispatchEvent(
                        new CustomEvent('jd:scene-entered', {
                            detail: {
                                scene: current.dataset.scene,
                                act: current.closest<HTMLElement>('.act')?.id,
                            },
                        }),
                    );
                }
            },
            { rootMargin: BAND },
        );

        for (const scene of scenes) {
            observer.observe(scene);
        }
    }
</script>

<style>
    .scene {
        display: flex;
        flex-direction: column;
        gap: var(--jd-space-4);
        padding-bottom: var(--jd-space-12);
    }

    /*
     * A size up from the rest of the page's subheadings, because on this page a scene
     * title is not a subheading: it is the claim, and the code under it is the evidence.
     * At the old size it read as a caption for the block below it.
     */
    h3 {
        font-size: var(--jd-text-xl);
        line-height: var(--jd-line-tight);
        letter-spacing: -0.015em;
        margin: 0;
        text-wrap: balance;
    }

    /*
     * The commentary keeps a reading measure while the figure takes the whole width. A
     * paragraph as wide as a code block is a paragraph nobody finishes: the eye loses the
     * start of the next line somewhere in the middle of this one.
     */
    /* A scene may hold more than one figure — the beat that shows a test and the factory
       under it — so the holder is a stack rather than a single slot. */
    .figure {
        display: grid;
        gap: var(--jd-space-4);
    }

    /* A reading measure, not the figure's — a paragraph as wide as a code block is one
       nobody finishes. 42rem was chosen when the titles were narrow too, and left the
       commentary looking like a lost column once they took the page's width. */
    /* Above the figure, so it reads as the sentence that introduces it rather than as a
       caption for it. Same measure as the commentary; the two are the same kind of text. */
    .lead {
        margin: 0 0 var(--jd-space-4);
        max-width: 52rem;
        color: var(--jd-text-muted);
    }

    .commentary {
        margin: 0;
        max-width: 52rem;
        color: var(--jd-text-muted);
    }

    @media (min-width: 48rem) {
        /*
         * A scene holds the screen, and what is in it is centred — so the figure lands in
         * roughly the same place from one scene to the next, and scrolling reads as the
         * same code changing rather than as a new block arriving.
         *
         * `min-height`, never `height`: a scene whose figure is taller than the viewport
         * grows rather than clipping, and the recorded terminals are the tallest things on
         * this page.
         */
        /*
         * No `min-height` any more. What it was for — the figure landing in the same place
         * from one scene to the next, so the code read as transforming — is now the
         * reveal's job, and the reveal does it without a screen of emptiness between every
         * pair of blocks.
         */
        .scene {
            position: relative;
            gap: var(--jd-space-6);
            padding: var(--jd-space-12) 0 var(--jd-space-12) var(--jd-space-8);
        }

        /*
         * The rail. Drawn from the scene itself rather than from the act, so the segments
         * join without anything having to know how many scenes there are.
         */
        .scene::before {
            content: '';
            position: absolute;
            left: 0.4375rem;
            top: 0;
            bottom: 0;
            width: 1px;
            background: var(--jd-border);
        }

        /*
         * The marker belongs to the heading, not to the middle of the scene.
         *
         * Anchored to the scene it sat wherever the scene's midpoint fell, which since a
         * scene became a screen is beside the code block — where a small round mark reads
         * as a bullet pointing at nothing in particular. Against the heading it reads as
         * what it is: this scene, and you are on it.
         */
        h3 {
            position: relative;
        }

        h3::before {
            content: '';
            position: absolute;
            left: calc(-1 * var(--jd-space-8));
            top: 0.35em;
            width: 0.9375rem;
            height: 0.9375rem;
            border: 1px solid var(--jd-border);
            border-radius: 50%;
            background: var(--jd-act-ground, var(--jd-background));
            transition:
                background-color var(--jd-duration-base) var(--jd-ease),
                border-color var(--jd-duration-base) var(--jd-ease);
        }

        .scene[data-current] h3::before {
            border-color: var(--jd-accent);
            background: var(--jd-accent);
        }
    }
</style>
