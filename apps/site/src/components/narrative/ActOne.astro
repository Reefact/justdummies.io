---
/**
 * ACT I — validity.
 *
 * Five beats, following one factory as it stops lying:
 *
 *   the test everyone writes, with three values named for what they are not
 *     → the same test with the values behind factories, which reads and still lies
 *     → the library draws a genuinely arbitrary value, and the domain refuses it
 *     → the invariants of the value object, which say why
 *     → the constraints declared as a chain, inside the factory
 *
 * It is one transformation, not five slides (§9.2): the same test, the same factory,
 * followed from the literal in the first scene to the chain in the last. The snippet
 * source says the same thing — three namespaces holding three states of one class, so
 * the page shows a class evolving rather than three different classes.
 *
 * WHAT IS NOT HERE ANY MORE, and why (ADR-0006). The chain producing a domain object in
 * one link, and the four-argument arrangement that worked and said too much. The first
 * was a step the reader could not use yet; `.As(OrderReference.Create)` comes back in
 * the recipe the tool writes, where it arrives having been earned. The second restated
 * what the act had already shown.
 *
 * The act ends on the library alone, which is all it has demonstrated. The tool has
 * not appeared yet, so the exit does not offer it.
 */
import Act from './Act.astro';
import Scene from './Scene.astro';
import CodeSample from '../CodeSample.astro';
---

<Act
    name="act-one"
    title="act1.title"
    summary="act1.summary"
    ground="raised"
    exitTitle="act1.exit.title"
    exitBody="act1.exit.body"
>
    <Scene
        name="the-test"
        title="act1.test.title"
        body="act1.test.body"
        sample="literal-test"
        outcome="none"
    />

    {/* One box holding both, not two: the test that finally reads and, under a blank
        line, the factory that lets it read while still lying. They are one argument, and
        a border through the middle of it reads as two subjects. */}
    <Scene name="the-factories" title="act1.factories.title" body="act1.factories.body">
        <CodeSample id="factory-test" also="factory-handwritten" outcome="none" />
    </Scene>

    <Scene
        name="the-careless-value"
        title="act1.careless.title"
        body="act1.careless.body"
        sample="factory-careless"
        outcome="refusal"
    />

    <Scene
        name="the-invariants"
        title="act1.invariants.title"
        body="act1.invariants.body"
        sample="order-reference-invariants"
        outcome="none"
    />

    <Scene
        name="the-constraints"
        title="act1.constraints.title"
        body="act1.constraints.body"
        sample="factory-constrained"
        outcome="sequence"
    />
</Act>
