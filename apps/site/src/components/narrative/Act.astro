---
/**
 * An act: a label, the claim it is going to make, its scenes, and the door out.
 *
 * The door is the point (§9.3). A visitor convinced by the end of an act has no reason
 * to keep reading, and the page has to let them leave with the install command in hand
 * rather than holding them until the end.
 *
 * The exits are **graduated**: each one offers what the visitor has been shown by that
 * point, and nothing else. Offering the tool at the end of an act that has not
 * mentioned it is noise — it asks the reader to evaluate something they have no way to
 * judge yet.
 */
import InstallBlock from '../InstallBlock.astro';
import { localeFromPath } from '../../i18n/routing';
import { useTranslations, type UiKey } from '../../i18n/ui';

interface Props {
    /** Stable identifier, used for the anchor and by the exit's measurement. */
    name: string;
    label: UiKey;
    title: UiKey;
    summary: UiKey;
    exitTitle: UiKey;
    exitBody: UiKey;
    /** What this act has earned the right to offer. See InstallBlock's own note. */
    offer?: 'library' | 'library-and-tool' | 'everything';
    /**
     * The sentence that joins this act to the one before it. §9.4 makes it compulsory at
     * the opening of the third act — the test has just gone green and the page is about to
     * show it going red, and without a hinge the reader takes that for a second site glued
     * onto the first. Its wording is editorial; that it exists is a decision.
     */
    hinge?: UiKey;
}

const { name, label, title, summary, exitTitle, exitBody, offer = 'library', hinge } = Astro.props;

const t = useTranslations(localeFromPath(Astro.url.pathname));
---

<section class="act" id={name} aria-labelledby={`${name}-title`}>
    <header>
        {hinge !== undefined && <p class="hinge">{t(hinge)}</p>}
        <p class="label">{t(label)}</p>
        <h2 id={`${name}-title`}>{t(title)}</h2>
        <p class="summary">{t(summary)}</p>
    </header>

    <div class="scenes" data-scenes>
        <slot />
    </div>

    <footer class="exit">
        <h3>{t(exitTitle)}</h3>
        <p>{t(exitBody)}</p>
        <InstallBlock placement={`${name}-exit`} offer={offer} />
    </footer>
</section>

<script>
    /**
     * §9.1's cross-scene panel: one figure holds the viewport while the prose scrolls past
     * it, and its content is replaced scene by scene.
     *
     * IT IS BUILT, NEVER AUTHORED. The markup ships a figure inside each scene, in
     * document order, next to the prose it belongs to. That is the artefact three of the
     * four builds get (§9.7) and it is a complete document, not a fallback: a reader
     * without script, on a phone, or asking for reduced motion reads exactly what is
     * written. Only here, and only when all three conditions hold, are the figures lifted
     * into a shared stage.
     *
     * Authoring the panel directly in the markup was the alternative, and it is the reason
     * this is deferred until now: a column of figures detached from their prose is what a
     * reader the script never reaches would be left with.
     *
     * REDUCED MOTION IS A REFUSAL, NOT A SHORTER TRANSITION. What this adds is movement
     * whose only job is to explain (§5.3); a reader who has asked for none is better served
     * by the document that does not move at all.
     */
    const WIDE: string = '(min-width: 48rem)';
    const STILL: string = '(prefers-reduced-motion: reduce)';

    if (window.matchMedia(WIDE).matches && !window.matchMedia(STILL).matches) {
        for (const act of document.querySelectorAll<HTMLElement>('.act')) {
            stage(act);
        }
    }

    function stage(act: HTMLElement): void {
        const scenes: HTMLElement[] = Array.from(act.querySelectorAll<HTMLElement>('[data-scene]'));

        // An act with a wide scene is left alone, and that is a limitation rather than a
        // preference. A wide scene puts its figure under its prose across the whole measure,
        // so it interrupts the two columns the panel needs — and in both acts that have one,
        // it sits in the middle rather than at an end, where a single sticky column cannot
        // step around it. Making those acts stage too means either narrowing a figure that
        // was widened for a reason (a 128-character line of tool output) or splitting the
        // act into two panels, and neither is a decision to take at the end of this one.
        if (scenes.some((scene) => scene.dataset.wide !== undefined)) {
            return;
        }

        const staged: HTMLElement[] = scenes;

        if (staged.length < 2) {
            return;
        }

        const container: HTMLElement | null = act.querySelector('[data-scenes]');
        if (container === null) {
            return;
        }

        // Two elements, and both are needed. The outer one is the grid item and stretches to
        // the height of the scenes beside it; the inner one is what sticks, and it can only
        // travel as far as its container is tall. One element cannot be both — a sticky box
        // that is already the full height of its own containing block never moves, which is
        // exactly what the first version of this did.
        const stageElement: HTMLElement = document.createElement('div');
        stageElement.className = 'stage';
        stageElement.setAttribute('data-stage', '');

        const inner: HTMLElement = document.createElement('div');
        inner.className = 'stage-inner';
        stageElement.appendChild(inner);
        // The stage is decoration built from content that is already in the document: every
        // figure it shows exists in its scene, where a screen reader and the tab order still
        // find it. Announcing it again would read the page's code twice.
        stageElement.setAttribute('aria-hidden', 'true');

        const panes: Map<string, HTMLElement> = new Map();

        for (const scene of staged) {
            const figure: HTMLElement | null = scene.querySelector('.figure');
            const name: string | undefined = scene.dataset.scene;

            if (figure === null || name === undefined) {
                continue;
            }

            const pane: HTMLElement = document.createElement('div');
            pane.className = 'pane';
            pane.setAttribute('data-pane', name);
            // Cloned, not moved. Moving it would take the figure out of the section its
            // prose lives in, and the reading order a screen reader follows is the document
            // order — so the copy is what gets stacked and hidden, and the original stays
            // where it was, hidden from sight but not from the accessibility tree.
            pane.appendChild(figure.cloneNode(true));
            inner.appendChild(pane);
            panes.set(name, pane);
        }

        if (panes.size < 2) {
            return;
        }

        // The scenes move into a track of their own so the container has exactly two
        // children to lay out. Their order is preserved and they stay where they were on the
        // page; what changes is that a single column now holds all of them, which is what
        // gives the stage beside it a full-height area to stick inside.
        const track: HTMLElement = document.createElement('div');
        track.className = 'track';
        container.insertBefore(track, staged[0]!);
        for (const scene of staged) {
            track.appendChild(scene);
        }

        container.appendChild(stageElement);
        act.setAttribute('data-staged', '');

        // Measured while the panes are still in flow, because the tallest one decides how
        // much room the stage reserves. Without it the stage is as tall as whichever pane
        // happens to be showing, and the prose beside it jumps every time the figure
        // changes — movement that explains nothing, which is the one kind §5.3 rules out.
        const tallest: number = Math.max(...[...panes.values()].map((pane) => pane.offsetHeight));
        inner.style.minHeight = `${tallest}px`;
        stageElement.setAttribute('data-stacked', '');

        let showing: HTMLElement | undefined;

        function show(name: string | undefined): void {
            const pane: HTMLElement | undefined = name === undefined ? undefined : panes.get(name);

            if (pane === undefined || pane === showing) {
                return;
            }

            if (showing !== undefined) {
                delete showing.dataset.visible;
            }

            pane.dataset.visible = '';
            showing = pane;
        }

        show(staged[0]?.dataset.scene);

        act.addEventListener('jd:scene-current', (event: Event) => {
            show((event as CustomEvent<{ name?: string }>).detail?.name);
        });

        // The tallest pane changes with the width, because a code block that fitted on one
        // line wraps on a narrower one.
        let remeasuring: ReturnType<typeof setTimeout> | undefined;

        window.addEventListener('resize', () => {
            clearTimeout(remeasuring);
            remeasuring = setTimeout(() => {
                stageElement.removeAttribute('data-stacked');
                inner.style.minHeight = '';
                const measured: number = Math.max(...[...panes.values()].map((pane) => pane.offsetHeight));
                inner.style.minHeight = `${measured}px`;
                stageElement.setAttribute('data-stacked', '');
            }, 150);
        });
    }
</script>

<style>
    .act {
        padding: var(--jd-space-16) 0 var(--jd-space-12);
        border-top: 1px solid var(--jd-border);
    }

    header {
        margin-bottom: var(--jd-space-12);
        max-width: 40rem;
    }

    /* Set apart from the act's own opening, because it belongs to the seam rather than to
       either side of it: it is the last thing said about the act just finished and the first
       about the one starting. */
    .hinge {
        margin: 0 0 var(--jd-space-8);
        max-width: 34rem;
        font-size: var(--jd-text-lg);
        line-height: var(--jd-line-body);
        color: var(--jd-text-primary);
        border-left: 2px solid var(--jd-border);
        padding-left: var(--jd-space-4);
    }

    .label {
        margin: 0 0 var(--jd-space-2);
        font-size: var(--jd-text-sm);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--jd-accent);
    }

    h2 {
        font-size: var(--jd-text-xl);
        line-height: var(--jd-line-tight);
        margin: 0;
    }

    .summary {
        margin: var(--jd-space-3) 0 0;
        font-size: var(--jd-text-lg);
        color: var(--jd-text-muted);
    }

    .exit {
        max-width: 46rem;
        padding-top: var(--jd-space-8);
        border-top: 1px solid var(--jd-border);
    }

    .exit h3 {
        font-size: var(--jd-text-lg);
        line-height: var(--jd-line-tight);
        margin: 0 0 var(--jd-space-2);
    }

    .exit p {
        margin: 0 0 var(--jd-space-6);
        color: var(--jd-text-muted);
        max-width: 40rem;
    }

    @media (min-width: 48rem) {
        header,
        .exit {
            padding-left: var(--jd-space-8);
        }

        /*
         * The staged layout. Every scene goes in the left column and the stage occupies
         * the right one for the act's whole height, which is what lets it stay put while
         * the prose moves past it.
         *
         * `grid-row: 1 / -1` rather than a row count: the number of scenes is the act's
         * business and this should not have to be told when one is added.
         */
        .act[data-staged] .scenes {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 40rem);
            gap: var(--jd-space-8);
        }

        /*
         * :global on everything the script creates, and it is not optional. Astro scopes a
         * component's selectors by compiling them against an attribute it stamps on the
         * elements it renders; an element built by document.createElement never carries that
         * attribute, so a scoped rule matches nothing at all.
         *
         * The symptom is silent and reads like a CSS mistake anywhere else: the stage exists,
         * the panes exist, the measurement is right, and the computed position stays `static`
         * with no rule to be found. Measured rather than guessed — the browser reported
         * position: static on an element whose stylesheet plainly says sticky.
         *
         * Stretched, not started: the area has to be as tall as the scenes for the sticky box
         * inside it to have anywhere to travel.
         */
        .act[data-staged] :global(.stage) {
            align-self: stretch;
        }

        .act[data-staged] :global(.stage-inner) {
            position: sticky;
            top: var(--jd-space-8);
        }

        /*
         * Stacked only once the tallest pane has been measured. Before that they are in
         * flow, which is how the measurement is taken at all — and it also means that a
         * script interrupted between the two leaves a readable column of figures rather
         * than a pile of them on top of each other.
         */
        .act[data-staged] :global(.stage[data-stacked] .pane) {
            position: absolute;
            inset: 0 0 auto;
            opacity: 0;
            visibility: hidden;
            transition:
                opacity var(--jd-duration-base) var(--jd-ease),
                visibility var(--jd-duration-base) var(--jd-ease);
        }

        .act[data-staged] :global(.stage[data-stacked] .pane[data-visible]) {
            opacity: 1;
            visibility: visible;
        }

    }
</style>
