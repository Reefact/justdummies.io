---
/**
 * An act: a label, the claim it is going to make, its scenes, and the door out.
 *
 * The door is the point (§9.3). A visitor convinced by the end of an act has no reason
 * to keep reading, and the page has to let them leave with the install command in hand
 * rather than holding them until the end.
 *
 * The exits are **graduated**: each one offers what the visitor has been shown by that
 * point, and nothing else. Offering the tool at the end of an act that has not
 * mentioned it is noise — it asks the reader to evaluate something they have no way to
 * judge yet.
 */
import InstallBlock from '../InstallBlock.astro';
import { localeFromPath } from '../../i18n/routing';
import { useTranslations, type UiKey } from '../../i18n/ui';

interface Props {
    /** Stable identifier, used for the anchor and by the exit's measurement. */
    name: string;
    label: UiKey;
    title: UiKey;
    summary: UiKey;
    exitTitle: UiKey;
    exitBody: UiKey;
    /** What this act has earned the right to offer. See InstallBlock's own note. */
    offer?: 'library' | 'library-and-tool' | 'everything';
    /**
     * The sentence that joins this act to the one before it. §9.4 makes it compulsory at
     * the opening of the third act — the test has just gone green and the page is about to
     * show it going red, and without a hinge the reader takes that for a second site glued
     * onto the first. Its wording is editorial; that it exists is a decision.
     */
    hinge?: UiKey;
    /**
     * Which of the two grounds this act stands on.
     *
     * The change belongs to the seam between acts, never inside one: a ground that
     * changed under every scene would turn a continuous argument into a stack of
     * unrelated cards. Passed in rather than counted here, because an act does not know
     * how many came before it, and `:nth-of-type` cannot see across the components that
     * wrap them.
     */
    ground?: 'page' | 'raised';
}

const { name, label, title, summary, exitTitle, exitBody, offer = 'library', hinge, ground = 'page' } = Astro.props;

const t = useTranslations(localeFromPath(Astro.url.pathname));
---

<section class="act" id={name} data-ground={ground} aria-labelledby={`${name}-title`}>
    <header>
        {hinge !== undefined && <p class="hinge" data-reveal>{t(hinge)}</p>}
        {/* The label, the claim and its summary arrive together: they are one sentence
            broken across three lines, not three things. */}
        <div class="opening" data-reveal>
            <p class="label">{t(label)}</p>
            <h2 id={`${name}-title`}>{t(title)}</h2>
            <p class="summary">{t(summary)}</p>
        </div>
    </header>

    <div class="scenes" data-scenes>
        <slot />
    </div>

    <footer class="exit" data-reveal>
        <h3>{t(exitTitle)}</h3>
        <p>{t(exitBody)}</p>
        <InstallBlock placement={`${name}-exit`} offer={offer} />
    </footer>
</section>

<style>
    /*
     * THE GROUND CHANGES AT THE SEAM BETWEEN ACTS AND NOWHERE ELSE.
     *
     * Full-bleed rather than inset: the shell that holds this page is 72rem wide and
     * centred, so a ground painted inside it would be a wide stripe with the page showing
     * down both sides. The negative margin takes the panel out to the viewport edge and
     * the padding puts the content back where the shell had it.
     *
     * `--jd-act-ground` is declared here and read by the scene markers, which punch a hole
     * in the rail and have to be filled with whatever this act is standing on.
     */
    .act {
        --jd-act-ground: var(--jd-background);

        padding: var(--jd-space-16) 0 var(--jd-space-12);
        border-top: 1px solid var(--jd-border);
        background: var(--jd-act-ground);
    }

    .act[data-ground='raised'] {
        --jd-act-ground: var(--jd-surface-sunken);

        margin: 0 calc(50% - 50vw);
        padding-inline: max(var(--jd-space-4), calc(50vw - 36rem));
        /* The ground is the seam now; a rule on top of it would draw the same line twice. */
        border-top: 0;
    }

    header {
        margin-bottom: var(--jd-space-12);
        max-width: 40rem;
    }

    /* Set apart from the act's own opening, because it belongs to the seam rather than to
       either side of it: it is the last thing said about the act just finished and the first
       about the one starting. */
    .hinge {
        margin: 0 0 var(--jd-space-8);
        max-width: 34rem;
        font-size: var(--jd-text-lg);
        line-height: var(--jd-line-body);
        color: var(--jd-text-primary);
        border-left: 2px solid var(--jd-border);
        padding-left: var(--jd-space-4);
    }

    .label {
        margin: 0 0 var(--jd-space-2);
        font-size: var(--jd-text-sm);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--jd-accent);
    }

    /*
     * A step above the scene titles, which have just taken the size this one used to have.
     * Left alone the two would be identical, and an act would open on a heading no larger
     * than the six beats inside it — the chapter break stops reading as one.
     *
     * It matches the brand in the hero, and that is not a collision: the two are never on
     * the screen together, the hero being a full viewport the reader has already left.
     */
    h2 {
        font-size: var(--jd-text-2xl);
        line-height: var(--jd-line-tight);
        letter-spacing: -0.02em;
        margin: 0;
        text-wrap: balance;
    }

    .summary {
        margin: var(--jd-space-3) 0 0;
        font-size: var(--jd-text-lg);
        color: var(--jd-text-muted);
    }

    .exit {
        max-width: 46rem;
        padding-top: var(--jd-space-8);
        border-top: 1px solid var(--jd-border);
    }

    .exit h3 {
        font-size: var(--jd-text-lg);
        line-height: var(--jd-line-tight);
        margin: 0 0 var(--jd-space-2);
    }

    .exit p {
        margin: 0 0 var(--jd-space-6);
        color: var(--jd-text-muted);
        max-width: 40rem;
    }

    @media (min-width: 48rem) {
        header,
        .exit {
            padding-left: var(--jd-space-8);
        }






    }
</style>
