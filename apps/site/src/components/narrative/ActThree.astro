---
/**
 * ACT III — reproducibility.
 *
 * THE ANSWER COMES BEFORE THE FAILURE (ADR-0007). A reader arrives here with one question,
 * and it is not a neutral one: values that change on every run sound like tests that fail
 * on their own. The title, the summary, the hinge and the first scene all answer it before
 * anything on this page goes red — and what answers it is the attribute they have been
 * looking at since the second act without being told what it was for.
 *
 * That ordering is the change. The act used to open on a test failing two runs in three,
 * with the reassurance two scenes later, and the two scenes in between were exactly where a
 * reader deciding whether to trust this would stop reading.
 *
 * THE HINGE IS COMPULSORY (§9.4). This is the most delicate seam on the page, and without a
 * sentence joining what came before to what comes next, a reader takes the third act for a
 * second site glued onto the first. What the hinge says changed with the ordering; that it
 * exists did not.
 *
 * THE RED IS NOT DRAMATISED (§9.5). The intermittence is a statement about what an
 * arbitrary value does to a test that forgot to constrain it, not a failure the library
 * caused. The scenes state it; nothing here is styled as an alarm.
 *
 * WHAT IT DOES NOT PROMISE (§9.6). The seed replays the test case that reported it. That is
 * what the adapter does — a seed per test case, so a suite running in parallel still hands
 * back the seed of the case that failed — and the page says exactly that and no more.
 *
 * The exit is the complete offer, because by here the reader has seen all three pieces.
 */
import Act from './Act.astro';
import Scene from './Scene.astro';
import ToolRun from './ToolRun.astro';
---

<Act
    name="act-three"
    hinge="act3.hinge"
    title="act3.title"
    summary="act3.summary"
    ground="raised"
    exitTitle="act3.exit.title"
    exitLead="act3.exit.lead"
    exitBody="act3.exit.body"
    offer="everything"
>
    {/* The same test the second act ended on, shown a second time on purpose: the reader has
        walked past that attribute once already, and this is where it is named. Nothing has
        failed yet and nothing needs to have — what this scene says is that the values keep
        moving *and* stay recoverable, which is the whole of the reassurance. */}
    <Scene
        name="the-attribute"
        title="act3.attribute.title"
        body="act3.attribute.body"
        sample="concise-test"
        outcome="none"
    />

    <Scene
        name="the-forgotten-line"
        title="act3.forgotten.title"
        body="act3.forgotten.body"
        sample="intermittent-test"
        outcome="sequence"
    />

    <Scene name="the-seed" title="act3.seed.title" body="act3.seed.body">
        <ToolRun id="replayed-failure" from="test" />
    </Scene>

    {/* The recorded run goes under the code, and it is the same recording the scene above
        prints: the build reads that failure out of its own output, and pasting the seed puts
        it back on your machine. Showing it twice is the point — one place is where you read
        it, the other is where you reproduce it. */}
    <Scene
        name="the-replay"
        title="act3.replay.title"
        body="act3.replay.body"
        sample="replayed-test"
        outcome="none"
        ran="replayed-failure"
    />
</Act>
