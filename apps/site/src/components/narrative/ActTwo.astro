---
/**
 * ACT II — concision.
 *
 * Four beats: the arrangement a reader wishes they could write, the tool reading the type
 * and writing it, the one link it could not work out, and the test that results.
 *
 * It is the same test as the first act, word for word in its act and its assert. That is
 * the continuity rule (§9.2) doing its work: what changed is that the six scenes of
 * arrangement collapsed into one line, not that a new example was introduced.
 *
 * THE THIRD BEAT IS NOT A CONCESSION. `dum generate Order` reports the reference parameter
 * as `unread guards`: the domain rejects a string without an "ORD-" prefix, and a prefix
 * rule is not in the closed set of guard idioms the tool reads. So the tool emits the
 * neutral recipe, says where it stopped, and does not guess — which means the file it wrote
 * compiles and throws on every draw until one link is added.
 *
 * That link is the first act's chain, unchanged, and telling the act this way is both the
 * only honest reading and the stronger one: the tool writes what nobody wants to write and
 * stops where the reader already knows the answer. The alternative — a demonstration domain
 * whose every rule the tool happens to read — would be a page arranged to flatter the tool
 * rather than to show it.
 *
 * The exit is the complete offer: the library and the adapter were already earned by the
 * first act, and this one adds the tool.
 */
import Act from './Act.astro';
import Scene from './Scene.astro';
import ToolRun from './ToolRun.astro';
import CodeSample from '../CodeSample.astro';
import { site } from '../../site';
---

<Act
    name="act-two"
    title="act2.title"
    summary="act2.summary"
    ground="page"
    exitTitle="act2.exit.title"
    exitBody="act2.exit.body"
    offer="everything"
>
    {/* The act opens on what a reader wants, not on how to install the thing that provides
        it. It used to open on `dotnet tool install`, which answers a question nobody has
        asked yet — the command is in this act's exit, where a convinced reader looks for it. */}
    <Scene name="the-wanted-test" title="act2.wanted.title" body="act2.wanted.body" sample="wanted-test" outcome="none" />

    <Scene name="the-scaffold" title="act2.scaffold.title" body="act2.scaffold.body">
        <ToolRun id="generate-order" command={site.cli.example} />
    </Scene>

    {/* The whole file, exactly as the tool wrote it, and nothing beside it. A reader asked
        what `dum` produces; an excerpt answers a smaller question than the one they have.
        It folds — a hundred and one lines would bury the words under it — and it ships
        unfolded for a reader whose scripting never arrives. */}
    <Scene name="the-missing-link" title="act2.link.title" body="act2.link.body">
        <CodeSample id="any-order" from="tool" outcome="none" />
    </Scene>

    <Scene
        name="the-concise-test"
        title="act2.concise.title"
        body="act2.concise.body"
        sample="concise-test"
        outcome="none"
    />
</Act>
