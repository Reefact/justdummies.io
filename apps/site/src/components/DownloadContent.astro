---
/**
 * /download's own body: the section heading, the train switcher, and — directly beneath
 * it, no further click required — the one package that train offers, both install methods
 * shown at once (`DownloadPackage.astro`; see its file header for why this page never
 * reaches for `InstallTabs.astro`'s toggle).
 */
import DownloadPackage from './DownloadPackage.astro';
import DownloadTrains from './DownloadTrains.astro';
import { DOWNLOAD_PACKAGES, type DownloadTrainKey } from '../download';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
    locale: Locale;
    active: DownloadTrainKey;
}

const { locale, active } = Astro.props;
const t = useTranslations(locale);
---

<h2 id="download-heading">{t('download.heading')}</h2>
<p class="lead">{t('download.lead')}</p>
<DownloadTrains locale={locale} active={active} />
<DownloadPackage locale={locale} placement={`download-${active}`} offer={DOWNLOAD_PACKAGES[active]} />

<style>
    h2 {
        font-size: var(--jd-text-xl);
        line-height: var(--jd-line-tight);
        margin: 0 0 var(--jd-space-4);
    }

    .lead {
        color: var(--jd-text-muted);
        max-width: 46rem;
        margin: 0 0 var(--jd-space-6);
    }
</style>
