---
/**
 * One `/docs` topic's own chrome around its mirrored prose: the source link back to the
 * library (§7.5 — a defect in the content is corrected there, never here), and the
 * previous/next pair through the section's own reading order. The prose itself — the
 * rendered Markdown — is the default slot, passed in from the page so this component never
 * has to know how to render a content-collection entry.
 */
import { pathForLocale } from '../i18n/routing';
import { useTranslations, type Locale } from '../i18n/ui';
import type { DocsSection } from '../docsNav';

interface Props {
    locale: Locale;
    section: DocsSection;
    sourceUrl: string;
    ref: string;
    previous: { slug: string; title: string } | null;
    next: { slug: string; title: string } | null;
}

const { locale, section, sourceUrl, ref, previous, next } = Astro.props;
const t = useTranslations(locale);

function topicPath(slug: string): string {
    return pathForLocale(`/docs/${section}/${slug}`, locale);
}
---

<article class="docs-topic">
    <slot />
</article>

<p class="source">
    {/*
      The hidden half is not decoration: a link that replaces the window without warning
      is what `state.newTab` exists to announce, and every other outbound link on this
      site already carries it (AboutContent, VersionContent, InstallTabs, ReleaseNotesMajor).
    */}
    <a href={sourceUrl} target="_blank" rel="noopener noreferrer">
        {t('docs.sourceLink')}<span class="visually-hidden"> {t('state.newTab')}</span>
    </a>
    · {t('docs.pinnedAt')} <code>{ref}</code>
</p>

{
    (previous !== null || next !== null) && (
        <nav class="pager" aria-label={t('docs.nav.heading')}>
            {previous !== null ? (
                <a class="prev" href={topicPath(previous.slug)}>
                    ← {previous.title}
                </a>
            ) : (
                <span />
            )}
            {next !== null && (
                <a class="next" href={topicPath(next.slug)}>
                    {next.title} →
                </a>
            )}
        </nav>
    )
}

<style>
    .docs-topic {
        max-width: 44rem;
        line-height: var(--jd-line-body);
        /* The measure an alert takes back below, whatever it was written inside. */
        container-type: inline-size;
    }

    .docs-topic :global(h1) {
        display: none;
    }

    .docs-topic :global(h2) {
        margin-top: var(--jd-space-8);
    }

    .docs-topic :global(pre) {
        border: 1px solid var(--jd-border);
        border-radius: var(--jd-radius-md);
        padding: var(--jd-space-4);
        overflow-x: auto;
    }

    .docs-topic :global(code) {
        font-family: var(--jd-font-mono);
    }

    .docs-topic :global(:not(pre) > code) {
        background: var(--jd-code-inline-bg);
        padding: 0.1em 0.35em;
        border-radius: 0.3em;
    }

    /*
     * A GitHub alert, built by `rehypeRenderGithubAlerts` (astro.config.mjs) out of the
     * `> [!NOTE]` the library writes.
     *
     * Five kinds drawn in four hues, and deliberately: the palette holds no fifth colour that
     * clears 4.5:1 on this ground, and adding one to separate WARNING from IMPORTANT would
     * spend a token on a distinction the label already makes in words — the half of it every
     * reader receives, including the one who never sees the rail. Colour ranks the five here;
     * it does not name them.
     */
    .docs-topic :global(.jd-alert) {
        --jd-alert-colour: var(--jd-text-muted);
        margin-block: var(--jd-space-6);
        padding: var(--jd-space-4);
        border-left: 3px solid var(--jd-alert-colour);
        border-radius: var(--jd-radius-md);
        background: var(--jd-surface-raised);
        /*
         * SAME WIDTH AND SAME LEFT EDGE WHEREVER IT WAS WRITTEN. `src/docs-alerts.mjs` renders an
         * alert under a list item too — the author meant one — and a callout that then sat inset
         * by that list's indent would be a different object for a reason no reader can see.
         *
         * `100cqw` is this article's own inline size, so where the containing block is narrower
         * — inside a list item, at any depth — the alert takes the measure back and pulls itself
         * left by exactly the difference the browser computed. At the top level the difference is
         * zero and both declarations are inert, which is why there is no second selector for the
         * ordinary case and no number here that a nesting depth could make wrong.
         */
        width: 100cqw;
        margin-inline-start: calc(-1 * (100cqw - 100%));
    }

    .docs-topic :global(.jd-alert--note) {
        --jd-alert-colour: var(--jd-generated);
    }

    .docs-topic :global(.jd-alert--tip) {
        --jd-alert-colour: var(--jd-success);
    }

    .docs-topic :global(.jd-alert--important),
    .docs-topic :global(.jd-alert--warning) {
        --jd-alert-colour: var(--jd-accent);
    }

    .docs-topic :global(.jd-alert--caution) {
        --jd-alert-colour: var(--jd-error);
    }

    .docs-topic :global(.jd-alert-label) {
        margin: 0 0 var(--jd-space-2);
        color: var(--jd-alert-colour);
        font-weight: 600;
    }

    /* The box's own padding closes it; the last paragraph's margin would double that. */
    .docs-topic :global(.jd-alert > :last-child) {
        margin-bottom: 0;
    }

    /*
     * A rendered Mermaid diagram (scripts/lib/mermaid-render.mjs). It arrives with `width`
     * and `height` attributes and no CSS of its own — that is the whole point, since
     * `style-src 'self'` forbids the stylesheet mermaid would otherwise ship inside it — so
     * the sizing rules it needs live here, once, rather than 18 times in the content.
     *
     * `max-width: 100%` with `height: auto` lets the viewBox scale it down on a narrow
     * screen instead of widening the document, which is what tests/browser/layout.spec.ts
     * measures. The wrapper scrolls rather than shrinking past legibility on a phone.
     */
    .docs-topic :global(svg.jd-diagram) {
        display: block;
        max-width: 100%;
        height: auto;
        margin-block: var(--jd-space-6);
    }

    .docs-topic :global(table) {
        width: 100%;
        border-collapse: collapse;
        margin-block: var(--jd-space-4);
        font-size: var(--jd-text-sm);
    }

    .docs-topic :global(th),
    .docs-topic :global(td) {
        border: 1px solid var(--jd-border);
        padding: var(--jd-space-2) var(--jd-space-3);
        text-align: left;
    }

    .source {
        max-width: 44rem;
        margin-top: var(--jd-space-8);
        color: var(--jd-text-muted);
        font-size: var(--jd-text-sm);
    }

    .pager {
        max-width: 44rem;
        margin-top: var(--jd-space-6);
        padding-top: var(--jd-space-4);
        border-top: 1px solid var(--jd-border);
        display: flex;
        justify-content: space-between;
        gap: var(--jd-space-4);
    }

    .pager a {
        color: var(--jd-text-primary);
        font-weight: 600;
        /* Chrome around the prose, like `ApiPagination.astro`'s pair — the arrows and the
           rule above them say what these are. The links *inside* the prose keep their
           underline, which is where §13.4 wants it. */
        text-decoration: none;
    }

    .pager a:hover {
        color: var(--jd-accent);
    }

    .pager .next {
        margin-left: auto;
        text-align: right;
    }
</style>
