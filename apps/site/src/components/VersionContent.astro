---
/**
 * What the deployment says about itself, laid out for a reader, what its last release
 * changed, and the 5 releases before that one.
 *
 * TWO STATEMENTS UNDER ONE HEADING, THEN A SECOND HEADING. The table's three values state
 * what this build IS, and hold only facts the build itself stamped — they come from
 * `version.json`, the same file the site serves at /version.json, imported here at build
 * time rather than fetched. Nothing is fetched because nothing needs to be: the document and
 * the file are built together and shipped together, and the artefact's HTML is served
 * `must-revalidate`, so a reader cannot hold a cached page whose figures are older than the
 * file beside it. That also leaves this page with no script at all, which is the strongest
 * form of the rule that a page works without one.
 *
 * A null value prints `#null` rather than an empty cell or a sentence. Both of the two
 * that can be null mean something precise — `release: null` is a build that came from a
 * branch, `commit: null` is a build with no git behind it — and a reader who came to this
 * page came for the raw fact.
 *
 * THE RELEASE NOTE BELOW THE TABLE IS NOT A FOURTH ROW. It is the newest `## release/*`
 * section of RELEASE_NOTES-<locale>.md, which describes the last release this site published
 * — and that is a different fact from the one the table states. A build cut from a branch
 * belongs to no release at all and still displays this note, correctly: the table says what
 * this build is, the note says what shipped last. Folding the second into the first would
 * make a branch build claim to have published something. One heading covers both: a build
 * IS a release on this site, so a second heading here once said the same thing again in
 * different words. Each block keeps its own lead sentence, which is where the "IS" vs
 * "CHANGED" distinction still lives.
 *
 * THE SECOND HEADING'S 5 CARDS CARRY NO LINK OF THEIR OWN. A "Voir sur GitHub" repeated
 * identically five times would be five copies of the same fact, so one link closes the
 * section instead, anchored on the release right past the last one shown — a reader who keeps
 * going on GitHub picks up exactly where this page's own listing stops. That link's words
 * don't count what is past that point: this page shows exactly 5, but GitHub's own list keeps
 * going well beyond them, and a label promising "5 more" would be wrong the moment a reader
 * followed it.
 */
import ReleaseCard from './ReleaseCard.astro';
import { localeFromPath } from '../i18n/routing';
import { useTranslations } from '../i18n/ui';
import { previousSiteReleasesIn, releaseUrl, siteRelease, siteReleaseIn } from '../site-release';
import { commitUrl, version } from '../version';

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);

const latest = siteReleaseIn(locale);
const previous = previousSiteReleasesIn(locale);

/** What a missing value looks like, everywhere, so it cannot be mistaken for a blank. */
const NOTHING: string = '#null';
---

<section class="build" aria-labelledby="build-heading">
    <h2 id="build-heading">{t('version.heading')}</h2>
    <p class="lead">{t('version.lead')}</p>

    <table class="facts">
        <tbody>
            <tr>
                <th scope="row">{t('version.release')}</th>
                <td class="value" data-field="release">
                    {version.release === null ? <span class="nothing">{NOTHING}</span> : version.release}
                </td>
            </tr>
            <tr>
                <th scope="row">{t('version.commit')}</th>
                <td class="value" data-field="commit">
                    {
                        version.commit === null ? (
                            <span class="nothing">{NOTHING}</span>
                        ) : (
                            <a
                                href={commitUrl(version.commit)}
                                target="_blank"
                                rel="noopener noreferrer"
                                title={t('version.commitLink')}
                            >
                                {version.commit}
                            </a>
                        )
                    }
                </td>
            </tr>
            <tr>
                <th scope="row">{t('version.built')}</th>
                <td class="value" data-field="built">
                    <time datetime={version.built}>{version.built}</time>
                </td>
            </tr>
        </tbody>
    </table>
</section>

<section class="latest">
    <p class="lead">{t('version.latest.lead')}</p>

    <ReleaseCard
        locale={locale}
        name={latest.tag}
        date={latest.date}
        tagUrl={releaseUrl(latest.tag)}
        summaryHtml={latest.summaryHtml}
        sections={latest.sections}
    />
</section>

<section class="previous" aria-labelledby="previous-heading">
    <h2 id="previous-heading">{t('version.previous.heading')}</h2>
    <p class="lead">{t('version.previous.lead')}</p>

    <div class="cards">
        {
            previous.map((release) => (
                <ReleaseCard locale={locale} name={release.tag} date={release.date} summaryHtml={release.summaryHtml} sections={release.sections} />
            ))
        }
    </div>

    <p class="view-all">
        <a href={releaseUrl(siteRelease.moreTag)} target="_blank" rel="noopener noreferrer">
            {t('version.previous.viewMoreOnGithub')}
            <svg class="arrow" viewBox="0 0 12 12" width="10" height="10" aria-hidden="true" focusable="false">
                <path d="M3 9L9 3M4.5 3H9v4.5" />
            </svg>
            <span class="visually-hidden"> {t('state.newTab')}</span>
        </a>
    </p>
</section>

<style>
    .build,
    .latest,
    .previous {
        max-width: 56rem;
    }

    /* The table and the note are two statements, and this gap is what says so. A step wider
       than the --jd-space-6 that separates the rubrics inside the card, on purpose: at the
       same value the card would read as the table's last row rather than as its own claim,
       which is the one reading this page must not invite. */
    .latest {
        margin-top: var(--jd-space-12);
    }

    /* Same reasoning, one heading down: "Releases précédentes" is its own claim, not a
       continuation of the one above it. */
    .previous {
        margin-top: var(--jd-space-12);
    }

    .cards {
        display: grid;
        gap: var(--jd-space-6);
    }

    .view-all {
        margin-top: var(--jd-space-6);
        font-size: var(--jd-text-sm);
    }

    .view-all a {
        display: inline-flex;
        align-items: center;
        gap: var(--jd-space-1);
        color: var(--jd-text-muted);
    }

    .view-all a:hover {
        color: var(--jd-accent);
    }

    .arrow {
        fill: none;
        stroke: currentColor;
        stroke-width: 1.5;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    h2 {
        font-size: var(--jd-text-xl);
        line-height: var(--jd-line-tight);
        margin: 0;
    }

    .lead {
        color: var(--jd-text-muted);
        margin: var(--jd-space-2) 0 var(--jd-space-6);
    }

    .facts {
        border: 1px solid var(--jd-border);
        border-radius: var(--jd-radius-md);
        border-collapse: separate;
        border-spacing: 0;
        background: var(--jd-surface);
        /* The table is as wide as its content needs and no wider: three short labels and
           one long value, stretched to the measure, would put half a screen of nothing
           between the two. */
        width: 100%;
        text-align: left;
    }

    th,
    td {
        padding: var(--jd-space-3) var(--jd-space-4);
        vertical-align: baseline;
    }

    /* Between the rows, not around them: the outer border is the table's own, and doubling
       it at the edges is what makes a bordered table look like a spreadsheet. */
    tr + tr th,
    tr + tr td {
        border-top: 1px solid var(--jd-border);
    }

    th {
        color: var(--jd-text-muted);
        font-weight: 500;
        white-space: nowrap;
        width: 1%;
    }

    .value {
        font-family: var(--jd-font-mono);
        font-size: var(--jd-text-sm);
        /* A commit is forty characters with nowhere to break. Left alone it is what makes a
           phone scroll sideways, which the layout checks would catch — after it shipped. */
        overflow-wrap: anywhere;
    }

    .nothing {
        color: var(--jd-text-muted);
    }

    a {
        color: var(--jd-accent);
    }
</style>
