---
/**
 * The comparative positioning page (§11), read at four depths (§11.3).
 *
 * The order is the decision. The first version of this page opened on a coexistence
 * promise and a ten-axis matrix, and a reader who had not already met the library met the
 * comparison apparatus before the subject. So: what the problem is, which of four needs is
 * yours, then the criteria — each taught where it is used — then where the others win,
 * then where this one should not be used at all, then the way in, then the evidence.
 *
 * Every section below answers to a rule rather than to a taste:
 *
 *   #problem   §11.3's first depth — the page says what the library does before comparing it
 *   #choose    §11.3's second depth, §11.8 — a card per option, JustDummies included
 *   #compare   §11.4, §11.7 — the criteria, taught, then answered
 *   #instead   §11.8 — "when to choose it over JustDummies", never empty, never ironic
 *   #not-for   §11.8 — in its own section, case by case, not a paragraph
 *   #try-it    §11.9 — coexistence made into an action, after the reasons not to
 *   #sources   §11.10 — what was checked, where, when, and how to say we got it wrong
 */
import Comparison from './Comparison.astro';
import CopyableCommand from './CopyableCommand.astro';
import ToolCard from './ToolCard.astro';
import { localeFromPath, pathForLocale } from '../i18n/routing';
import { localeTags, useTranslations, type UiKey } from '../i18n/ui';
import { site } from '../site';
import {
    comparisonStaleAfterDays,
    comparisonVerifiedOn,
    competitors,
    mentioned,
    tools,
    type Competitor,
    type Tool,
} from '../comparison';

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);

/**
 * §11.10 — "a last-verified date is content, and past a declared delay the build warns."
 * Runs at build time, in Astro's own Node process, so a stale comparison shows up in
 * the build log rather than only in a reader noticing an old citation.
 *
 * `Date` does not reject an impossible day — `new Date('2026-02-31T00:00:00Z')` silently
 * normalizes to March 3rd rather than producing `NaN` — so parsing the components by hand
 * and reading them back off the constructed date is what actually catches that, rather than
 * a `Number.isNaN` check that a normalized date always passes.
 */
const verifiedOnParts = /^(\d{4})-(\d{2})-(\d{2})$/.exec(comparisonVerifiedOn);

if (verifiedOnParts === null) {
    throw new Error(`comparison.ts: comparisonVerifiedOn ("${comparisonVerifiedOn}") must be an ISO date (YYYY-MM-DD).`);
}

const [, verifiedOnYear, verifiedOnMonth, verifiedOnDay] = verifiedOnParts.map(Number);
const verifiedOnMs: number = Date.UTC(verifiedOnYear, verifiedOnMonth - 1, verifiedOnDay);
const verifiedOnRoundTrip = new Date(verifiedOnMs);

if (
    verifiedOnRoundTrip.getUTCFullYear() !== verifiedOnYear ||
    verifiedOnRoundTrip.getUTCMonth() !== verifiedOnMonth - 1 ||
    verifiedOnRoundTrip.getUTCDate() !== verifiedOnDay ||
    verifiedOnMs > Date.now()
) {
    throw new Error(
        `comparison.ts: comparisonVerifiedOn ("${comparisonVerifiedOn}") must be a real calendar date no later than the build date.`,
    );
}

const daysSinceVerified: number = Math.floor((Date.now() - verifiedOnMs) / 86_400_000);

if (daysSinceVerified > comparisonStaleAfterDays) {
    console.warn(
        `[why-justdummies] the comparison was last verified ${daysSinceVerified} days ago (past the ${comparisonStaleAfterDays}-day window). Re-check every claim against each library's own docs or repository, then update comparison.ts's comparisonVerifiedOn.`,
    );
}

/** Formatted from the one source date (§6.5), never a second hand-typed copy of it. */
const verifiedDate = new Intl.DateTimeFormat(localeTags[locale], { dateStyle: 'long', timeZone: 'UTC' }).format(verifiedOnMs);

/**
 * §11.10 — the correction issue the page invites every cited author to use.
 *
 * The body is prefilled, and that is not decoration: a blank form asks the person doing us
 * a favour to work out what we need. It stays English, like every other issue in this
 * repository (CONTRIBUTING's language rule), while the link that opens it is translated.
 */
const reportBody = [
    '**Which claim is wrong**',
    '',
    '**Where it appears** (criterion, tool, or the URL of the section)',
    '',
    '**What your own documentation says, and where**',
    '',
].join('\n');

const reportUrl =
    `${site.siteRepository}/issues/new` +
    `?title=${encodeURIComponent('why-justdummies: ')}` +
    `&body=${encodeURIComponent(reportBody)}`;

/**
 * The one "not for" case that is a state rather than a property, so it is read off the
 * state rather than asserted in prose (§2, §14.1). A version with no pre-release suffix
 * takes the paragraph off the page on the day it ships, instead of leaving a sentence that
 * was true when somebody typed it.
 */
const isPreRelease: boolean = site.library.version.includes('-');

/**
 * §7 of the why-justdummies rewrite: a case is a label and a body, rendered as one icon
 * list item rather than six near-identical `<div class="case">` blocks. The pre-release
 * case folds in here rather than branching in the template, so `isPreRelease` still governs
 * whether it exists at all (§2, §14.1) without a second conditional at the render site.
 */
const notForCases: ReadonlyArray<{ labelKey: UiKey; bodyKey: UiKey }> = [
    { labelKey: 'why.notFor.realism.label', bodyKey: 'why.notFor.realism.body' },
    { labelKey: 'why.notFor.noRules.label', bodyKey: 'why.notFor.noRules.body' },
    { labelKey: 'why.notFor.exploration.label', bodyKey: 'why.notFor.exploration.body' },
    { labelKey: 'why.notFor.secrets.label', bodyKey: 'why.notFor.secrets.body' },
    ...(isPreRelease
        ? [{ labelKey: 'why.notFor.preRelease.label' as UiKey, bodyKey: 'why.notFor.preRelease.body' as UiKey }]
        : []),
    { labelKey: 'why.notFor.solo.label', bodyKey: 'why.notFor.solo.body' },
];

/**
 * The libraries whose claims have a source to show. The hand-written literal has none to
 * have: its ratings follow from what a literal is, not from a project's documentation.
 */
type CitedLibrary = Extract<Tool, { kind: 'library' }>;

const cited: readonly CitedLibrary[] = tools.filter((entry: Tool): entry is CitedLibrary => entry.kind === 'library');

/** Named once here so the nav and the headings cannot drift apart. */
const sections: ReadonlyArray<{ id: string; key: UiKey }> = [
    { id: 'problem', key: 'why.problem.heading' },
    { id: 'choose', key: 'why.choose.heading' },
    { id: 'compare', key: 'why.compare.heading' },
    { id: 'instead', key: 'why.instead.heading' },
    { id: 'not-for', key: 'why.notFor.heading' },
    { id: 'try-it', key: 'why.tryIt.heading' },
    { id: 'sources', key: 'why.sources.heading' },
];
---

<div class="why">
    <h2 id="why-heading">{t('why.heading')}</h2>

    <p class="lede">{t('why.lede')}</p>

    <nav class="toc" aria-label={t('why.toc.label')}>
        <span class="toc-label">{t('why.toc.label')}</span>
        <ul>
            {sections.map((section) => (
                <li>
                    <a href={`#${section.id}`}>{t(section.key)}</a>
                </li>
            ))}
        </ul>
    </nav>

    <section id="problem" aria-labelledby="why-problem-heading">
        <h3 id="why-problem-heading">{t('why.problem.heading')}</h3>

        <p>{t('why.problem.body')}</p>

        <p class="home-link">
            <a href={pathForLocale('/', locale)}>{t('why.problem.homeLink')}</a>
        </p>
    </section>

    <section id="choose" aria-labelledby="why-choose-heading">
        <h3 id="why-choose-heading">{t('why.choose.heading')}</h3>

        <p>{t('why.choose.lede')}</p>

        <div class="cards">
            {tools.map((entry: Tool) => <ToolCard entry={entry} />)}
        </div>
    </section>

    <section id="compare" aria-labelledby="why-compare-heading">
        <h3 id="why-compare-heading">{t('why.compare.heading')}</h3>

        <p>{t('why.compare.lede')}</p>

        <Comparison />
    </section>

    <section id="instead" aria-labelledby="why-instead-heading">
        <h3 id="why-instead-heading">{t('why.instead.heading')}</h3>

        <p>{t('why.instead.lede')}</p>

        <div class="instead-cards">
            {
                competitors.map((entry: Competitor) => (
                    <article class="instead-card">
                        <h4>{entry.kind === 'manual' ? t(entry.nameKey) : entry.name}</h4>
                        <p>{t(entry.chooseInsteadKey)}</p>
                    </article>
                ))
            }
        </div>
    </section>

    <section id="not-for" aria-labelledby="why-notfor-heading">
        <h3 id="why-notfor-heading">{t('why.notFor.heading')}</h3>

        <p>{t('why.notFor.lede')}</p>

        <ul class="not-for-list">
            {
                notForCases.map((item) => (
                    <li class="not-for-item">
                        <svg class="not-for-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                            <path
                                d="m9 6 6 6-6 6"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            />
                        </svg>
                        <div>
                            <h4>{t(item.labelKey)}</h4>
                            <p>{t(item.bodyKey)}</p>
                        </div>
                    </li>
                ))
            }
        </ul>
    </section>

    <section id="try-it" aria-labelledby="why-tryit-heading">
        <h3 id="why-tryit-heading">{t('why.tryIt.heading')}</h3>

        <p>{t('why.tryIt.body')}</p>

        <p class="install-label">{t('why.tryIt.install')}</p>
        {/*
          `dotnet-cli` is the variant `InstallTabs` already gives this exact command, and
          reusing it is the point of §15.2's two dimensions: the placement says which moment
          convinced the reader, the variant says which door they took. The same door under a
          second name would split one number in two and answer neither question.
        */}
        <CopyableCommand command={site.library.installCommand} placement="why-try-one-test" variant="dotnet-cli" />
    </section>

    <section id="sources" aria-labelledby="why-sources-heading">
        <h3 id="why-sources-heading">{t('why.sources.heading')}</h3>

        <p>{t('why.sources.body')}</p>

        <p class="verified">
            <span class="verified-badge">
                {t('why.verified.label')} {verifiedDate}
            </span>
        </p>

        {
            cited.map((entry: CitedLibrary) => (
                <div class="source">
                    <h4>{entry.name}</h4>
                    <p>{t(entry.checkedKey)}</p>
                    <div class="source-links">
                        {entry.sources.map((url: string) => (
                            <a class="source-chip" href={url} target="_blank" rel="noopener noreferrer">
                                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                                    <path
                                        d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    />
                                    <polyline points="15 3 21 3 21 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                    <line x1="10" y1="14" x2="21" y2="3" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                                </svg>
                                {url.replace('https://', '')}
                                <span class="visually-hidden"> {t('state.newTab')}</span>
                            </a>
                        ))}
                    </div>
                </div>
            ))
        }

        <div class="source">
            <h4>{t('why.sources.mentioned')}</h4>
            <p>{t('why.sources.mentionedBody')}</p>
            <div class="source-links">
                {
                    mentioned.map((url: string) => (
                        <a class="source-chip" href={url} target="_blank" rel="noopener noreferrer">
                            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                                <path
                                    d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                />
                                <polyline points="15 3 21 3 21 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                <line x1="10" y1="14" x2="21" y2="3" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                            </svg>
                            {url.replace('https://', '')}
                            <span class="visually-hidden"> {t('state.newTab')}</span>
                        </a>
                    ))
                }
            </div>
        </div>

        <p class="report">
            {t('why.report.prompt')}{' '}
            <a href={reportUrl} target="_blank" rel="noopener noreferrer">
                {t('why.report.label')}
                <span class="visually-hidden"> {t('state.newTab')}</span>
            </a>
        </p>
    </section>
</div>

<style>
    .why {
        max-width: 60rem;
    }

    h2 {
        font-size: var(--jd-text-xl);
        line-height: var(--jd-line-tight);
        margin: 0 0 var(--jd-space-4);
    }

    /* The accent underline marks a *section* — this page's own top-level divisions — and
       nothing smaller: a sub-heading carrying the same mark would compete with the
       structure it sits inside, which is what the family headings in Comparison.astro used
       to do before this moved here. */
    h3 {
        font-size: var(--jd-text-lg);
        line-height: var(--jd-line-tight);
        margin: 0 0 var(--jd-space-3);
        padding-bottom: var(--jd-space-2);
        border-bottom: 2px solid var(--jd-accent);
    }

    h4 {
        font-size: var(--jd-text-base);
        font-weight: 600;
        margin: 0 0 var(--jd-space-1);
    }

    /*
     * Prose runs at a comfortable measure, not at the width of the widest thing on the page.
     * The section shell stays 60rem so a card grid and a table have room; a paragraph inside
     * it stops at 38rem, which is around seventy characters — and French, 15 to 20 % longer
     * than English (§6.5), is the case that decided the number.
     */
    p,
    dd {
        margin: 0 0 var(--jd-space-4);
        max-width: 38rem;
    }

    /* Full width by editorial decision — the one paragraph on the page meant to be read
       as a single confident line, not folded to the 38rem prose measure below it. */
    .lede {
        max-width: none;
        font-size: var(--jd-text-lg);
        line-height: var(--jd-line-body);
        color: var(--jd-text-primary);
    }

    section {
        border-top: 1px solid var(--jd-border);
        padding-top: var(--jd-space-8);
        margin-top: var(--jd-space-8);
    }

    /* --- where the page goes next ---------------------------------------------------- */

    .toc {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: var(--jd-space-1) var(--jd-space-3);
        margin: 0 0 var(--jd-space-4);
        font-size: var(--jd-text-sm);
    }

    .toc-label {
        color: var(--jd-text-muted);
    }

    .toc ul {
        display: flex;
        flex-wrap: wrap;
        gap: var(--jd-space-1) var(--jd-space-4);
        list-style: none;
        margin: 0;
        padding: 0;
    }

    /* --- the problem ------------------------------------------------------------------ */

    .home-link {
        margin: 0;
        font-size: var(--jd-text-sm);
    }

    /* --- the four needs --------------------------------------------------------------- */

    /*
     * Two by two, not three and a widow. The four are peers and the grid should say so;
     * 22rem is the smallest minimum that stops a third column fitting on the 60rem measure.
     *
     * `min(22rem, 100%)` and not `22rem`, and this is the trap that caught it: a track whose
     * *minimum* is wider than its container does not shrink to fit, it overflows — so a
     * phone at 320px got a 352px column and the whole document scrolled sideways. The
     * browser check found it at 320 and 360 and nowhere else, which is exactly the width
     * band a `minmax()` minimum goes wrong in.
     */
    /* `align-items: start` rather than the grid default (`stretch`): the hardcoded-value
       card carries no repository link, so stretching it to match a taller row-mate would
       leave dead space at its own bottom instead of just ending where its content ends. */
    .cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(22rem, 100%), 1fr));
        align-items: start;
        gap: var(--jd-space-4);
    }

    /* --- where another tool wins --------------------------------------------------------
       Deliberately quieter than ToolCard's own look (no accent border, no surface shadow):
       #choose is the structuring choice on this page, #instead only qualifies it, and the
       two should not compete for the same visual weight. */

    .instead-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
        gap: var(--jd-space-4);
    }

    .instead-card {
        border: 1px solid var(--jd-border);
        border-radius: var(--jd-radius-md);
        padding: var(--jd-space-3) var(--jd-space-4);
    }

    .instead-card h4 {
        color: var(--jd-text-muted);
    }

    .instead-card p {
        margin: 0;
        font-size: var(--jd-text-sm);
        color: var(--jd-text-muted);
    }

    /* --- where none of them do -----------------------------------------------------------
       A sober list rather than a card grid: this section tempers a claim rather than sells
       one, and a heavy border or a drop shadow here would read as another product pitch. */

    .not-for-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: var(--jd-space-4);
    }

    .not-for-item {
        display: flex;
        align-items: flex-start;
        gap: var(--jd-space-3);
    }

    .not-for-icon {
        flex: none;
        width: 1.1em;
        height: 1.1em;
        margin-top: 0.2em;
        color: var(--jd-text-muted);
    }

    .not-for-item h4 {
        margin: 0 0 var(--jd-space-1);
    }

    .not-for-item p {
        margin: 0;
    }

    /* --- the way in -------------------------------------------------------------------- */

    .install-label {
        font-size: var(--jd-text-sm);
        color: var(--jd-text-muted);
        margin-bottom: var(--jd-space-2);
    }

    /* --- what was checked, and where ---------------------------------------------------
       Deliberately the plainest section on the page: this is an annexe a reader checks,
       not editorial content, and dressing it up like the sections above it would trade
       credibility-by-rigour for the look of a pitch (§9). */

    /* A pill rather than a line of text lost in the flow — the freshness signal a reader
       skimming past should catch immediately. */
    .verified {
        margin: 0 0 var(--jd-space-4);
    }

    .verified-badge {
        display: inline-block;
        padding: var(--jd-space-1) var(--jd-space-3);
        border: 1px solid var(--jd-border);
        border-radius: 999px;
        font-size: var(--jd-text-sm);
        color: var(--jd-text-muted);
    }

    .source {
        margin: 0 0 var(--jd-space-4);
    }

    .source p {
        margin: 0 0 var(--jd-space-2);
        font-size: var(--jd-text-sm);
        color: var(--jd-text-muted);
    }

    /* Chips, not a bulleted list of raw URLs: denser, and each one scans as a single unit
       rather than as a line of text to read. A source is still just a URL, and the longest
       of them is wider than a phone left alone — `overflow-wrap` is what keeps a chip from
       taking the whole document sideways with it (§11.7). */
    .source-links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--jd-space-2);
    }

    .source-chip {
        display: inline-flex;
        align-items: center;
        gap: var(--jd-space-1);
        max-width: 100%;
        padding: var(--jd-space-1) var(--jd-space-2);
        border-radius: var(--jd-radius-sm);
        background: var(--jd-surface);
        color: var(--jd-text-muted);
        font-size: var(--jd-text-sm);
        overflow-wrap: anywhere;
    }

    .source-chip:hover {
        color: var(--jd-text-primary);
    }

    .source-chip svg {
        flex: none;
        width: 0.85em;
        height: 0.85em;
    }

    .report {
        margin-top: var(--jd-space-6);
        margin-bottom: 0;
    }
</style>
