---
/**
 * The shell a release notes page shares: the brand heading every page carries, the package
 * switcher, then a table of contents beside the notes themselves.
 *
 * A sibling layout on `Base` rather than a mode of `Page`: `Page` has no grid to give a
 * table of contents a column of its own, so this still has to lay one out. Its shell holds
 * `Page`'s 72rem measure rather than `ApiPage`'s 88rem, though — the notes are prose, read
 * start to end, not a reference table with a signature column that needs the room, and
 * 88rem's only argument lives on that page, not this one.
 *
 * The sidebar's own width still isn't this file's to pick: `--jd-reference-nav` (base.css)
 * is the one number both reference sections' first column reads, so a reader moving between
 * /api and here finds the same column even though the page around it is narrower.
 */
import BrandHeading from '../components/BrandHeading.astro';
import Base from './Base.astro';

interface Props {
    title: string;
    description: string;
}

const { title, description } = Astro.props;
---

<Base title={title} description={description}>
    <div class="notes-shell">
        <div class="shell">
            <BrandHeading />
        </div>
        {/* `<main>` opens before the heading and the lead, not after them. It used to start at
            the column below, which left this section's own title outside every landmark on a
            major-version page while the index one route away kept its title inside — two layouts
            in one section disagreeing about where the content begins. The inner box keeps its
            class and every rule that hangs off it; only the element name changes. */}
        <main>
            <div class="notes-head">
                <slot name="head" />
            </div>
            <div class="notes-layout">
                <slot name="contents" />
                <div class="notes-main">
                    <slot />
                </div>
            </div>
        </main>
    </div>
</Base>

<style>
    .notes-shell {
        padding-block: var(--jd-space-8) var(--jd-space-16);
    }

    .notes-head,
    .notes-layout {
        max-width: 72rem;
        margin-inline: auto;
        padding-inline: var(--jd-space-4);
    }

    .notes-head {
        margin-top: var(--jd-space-8);
    }

    .notes-layout {
        display: grid;
        grid-template-columns: var(--jd-reference-nav) minmax(0, 1fr);
        gap: var(--jd-space-8);
        margin-top: var(--jd-space-6);
    }

    .notes-main {
        min-width: 0;
    }

    @media (max-width: 56rem) {
        .notes-layout {
            grid-template-columns: 1fr;
            gap: 0;
        }
    }

    @media (max-width: 47.99rem), (max-height: 820px) {
        .notes-shell {
            padding-block-start: var(--jd-space-4);
        }
    }
</style>
