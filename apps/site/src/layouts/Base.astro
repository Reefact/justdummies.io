---
import '@justdummies/design-tokens/tokens.css';
import '../styles/base.css';

import LanguageSelector from '../components/LanguageSelector.astro';
import { site } from '../site';
import { localeFromPath, pathForLocale, translatedLocales } from '../i18n/routing';
import { defaultLocale, localeTags, openGraphLocales, useTranslations, type Locale } from '../i18n/ui';

interface Props {
    title: string;
    description: string;
    /**
     * Set on pages that answer for an address rather than owning one — the 404.
     * Such a page is served under whatever URL was mistyped, so declaring a
     * canonical would nominate that typo as a real page, and an `hreflang` would
     * announce a translation of it. It says `noindex` instead and claims nothing.
     */
    noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

const pathname: string = Astro.url.pathname;
const locale: Locale = localeFromPath(pathname);
const alternates: Locale[] = translatedLocales(pathname);

function absolute(path: string): string {
    return new URL(path, Astro.site).href;
}

/**
 * The canonical URL is the page's own, in its own locale, never the other one's
 * (§25.1). Two locales pointing at one canonical would ask search engines to drop
 * one of them.
 */
const canonical: string = absolute(pathForLocale(pathname, locale));

/**
 * `x-default` names the version to serve when no declared language matches, and
 * the specification points it at English (§7.6). It is only emitted when English
 * really exists for this route.
 */
const hasDefault: boolean = alternates.includes(defaultLocale);

const t = useTranslations(locale);
---

<!doctype html>
<html lang={localeTags[locale]}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />

        {/*
          Absolute, not locale-relative: both files sit at the root of the artefact, and
          an icon is a property of the site rather than of the page asking for it.

          The .ico alone would already answer the request every browser makes without being
          asked. The PNG is declared because nothing would otherwise reach it — the implicit
          request is for /favicon.ico and nothing else — and it is the half that stays sharp
          where the icon is drawn large: a pinned tab, a bookmark, a home screen.
        */}
        <link rel="icon" href="/favicon.ico" sizes="32x32" />
        <link rel="icon" type="image/png" href="/favicon.png" sizes="512x512" />

        {noindex && <meta name="robots" content="noindex" />}
        {!noindex && <link rel="canonical" href={canonical} />}
        {
            !noindex &&
                alternates.map((alternate: Locale) => (
                    <link
                        rel="alternate"
                        hreflang={localeTags[alternate]}
                        href={absolute(pathForLocale(pathname, alternate))}
                    />
                ))
        }
        {
            !noindex && hasDefault && (
                <link rel="alternate" hreflang="x-default" href={absolute(pathForLocale(pathname, defaultLocale))} />
            )
        }

        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:locale" content={openGraphLocales[locale]} />
        {
            alternates
                .filter((alternate: Locale) => alternate !== locale)
                .map((alternate: Locale) => (
                    <meta property="og:locale:alternate" content={openGraphLocales[alternate]} />
                ))
        }
        <meta name="twitter:card" content="summary_large_image" />

        {/*
          Arms the reveal, and it has to happen here rather than in the module below.
          A deferred script runs after first paint, so the page would render with every
          section already in place and then snatch them away to fade them back in. One
          attribute, set before anything is painted, is what makes the difference between
          a reveal and a flicker.

          Its counterpart is that nothing hides until this line runs: a reader with no
          scripting gets the whole page, laid out, unanimated. See base.css.
        */}
        <script is:inline>
            document.documentElement.dataset.revealArmed = '';
        </script>
    </head>
    <body>
        <header class="site-header">
            <a class="brand" href={pathForLocale('/', locale)}>JustDummies</a>

            {/*
              The two destinations that are not part of the story. They were in the hero,
              where they competed with the one thing that screen asks for; a link that is
              true on every page belongs in the bar that is on every page.

              The playground link deliberately leaves the current locale: the application is
              served in English only, and sending a French reader to a route that does not
              exist would be worse than sending them to one that does.
            */}
            <nav class="site-nav" aria-label={t('nav.primary')}>
                <a href="/playground/">{t('nav.playground')}</a>
                <a href={site.repository}>{t('nav.github')}</a>
                {/*
                  The language control is not a third destination and must not read as one.
                  The rule says so before the reader has parsed a word of it.
                */}
                <span class="divider" aria-hidden="true"></span>
                <LanguageSelector pathname={pathname} />
            </nav>
        </header>

        <slot />

        <script>
            /**
             * Reveals each marked group as it comes into view, once.
             *
             * One observer for the document rather than one per component: the things that
             * reveal belong to four components, they all reveal the same way, and a page
             * with four observers watching the same scroll is four times the work for one
             * effect.
             *
             * ONCE, NEVER AGAIN. `unobserve` on the way out is not an optimisation — a
             * group that faded back on the way up would make scrolling backwards a
             * different page from scrolling forwards, and re-reading something you have
             * already read is the most ordinary thing a reader does.
             *
             * If this never runs, the head's inline script has still armed the CSS, so the
             * page would stay hidden — which is why the arming is undone here on the way
             * in rather than trusted. `IntersectionObserver` has been everywhere for years;
             * the browser that lacks it gets the page unanimated instead of empty.
             */
            const groups: HTMLElement[] = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));

            function reveal(group: HTMLElement): void {
                group.dataset.revealed = '';
            }

            if (groups.length > 0) {
                if ('IntersectionObserver' in window) {
                    const observer: IntersectionObserver = new IntersectionObserver(
                        (entries: IntersectionObserverEntry[]) => {
                            for (const entry of entries) {
                                if (!entry.isIntersecting) {
                                    continue;
                                }

                                reveal(entry.target as HTMLElement);
                                observer.unobserve(entry.target);
                            }
                        },
                        // A group has arrived once any part of it is inside the top 85% of
                        // the viewport — early enough that the movement is over by the time
                        // the reader's eye gets there.
                        //
                        // Expressed as a margin rather than a `threshold`, because a
                        // threshold is a *fraction of the element*: a scene taller than the
                        // viewport can never be 15% visible, and would sit invisible
                        // forever. The recorded terminals are that tall.
                        { rootMargin: '0px 0px -15% 0px' },
                    );

                    for (const group of groups) {
                        observer.observe(group);
                    }

                    /**
                     * The backstop, and it is not belt-and-braces — without it the page has
                     * content nobody can ever read.
                     *
                     * That -15% shrinks the observer's root, so a group sitting in the last
                     * 15% of the *document* never enters it: the reader scrolls to the
                     * bottom, the page stops moving, and the group stays at zero opacity for
                     * good. Two of them did, and it took scrolling the built page to the end
                     * to find out — every one was revealed correctly on the way down.
                     *
                     * So the bottom of the document reveals whatever is left. Once, then it
                     * detaches.
                     */
                    const atBottom = (): void => {
                        if (window.scrollY + window.innerHeight < document.documentElement.scrollHeight - 2) {
                            return;
                        }

                        for (const group of groups) {
                            reveal(group);
                            observer.unobserve(group);
                        }

                        window.removeEventListener('scroll', atBottom);
                    };

                    window.addEventListener('scroll', atBottom, { passive: true });
                    atBottom();
                } else {
                    // No observer, no reveal — but the CSS is armed, so hand the page back
                    // rather than leaving it blank.
                    delete document.documentElement.dataset.revealArmed;
                }
            }
        </script>
    </body>
</html>

<style>
    .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--jd-space-4);
        max-width: 60rem;
        margin: 0 auto;
        padding: var(--jd-space-4);
    }

    .brand {
        color: var(--jd-text-primary);
        font-weight: 600;
        text-decoration: none;
    }

    .site-nav {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--jd-space-4);
        font-size: var(--jd-text-sm);
    }

    /* Tighter around the rule than between the links, so the rule reads as separating two
       groups rather than as a third item with space of its own. */
    .site-nav > a {
        margin-right: var(--jd-space-2);
    }

    .divider {
        width: 1px;
        align-self: stretch;
        min-height: 1rem;
        background: var(--jd-border);
    }

    /*
     * Below this width the bar cannot hold the brand and the three items on one line, and
     * what it does instead is wrap the nav to two — leaving the brand floating against the
     * middle of them. Stacking is both tidier and *shorter*: 82 pixels rather than 98, which
     * the first screen below gets back.
     *
     * The number is measured, not chosen: brand and nav together need 440 pixels of viewport,
     * so the query trips just above that. It is deliberately not the 48rem the rest of the
     * page uses — between 448 and 768 the bar fits on one line and has no reason to stack.
     */
    @media (max-width: 28rem) {
        .site-header {
            flex-direction: column;
            align-items: flex-start;
            gap: var(--jd-space-2);
        }

        .site-nav {
            gap: var(--jd-space-4);
        }
    }
</style>
