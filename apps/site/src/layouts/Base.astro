---
import '@justdummies/design-tokens/tokens.css';
import '../styles/base.css';

import Footer from '../components/Footer.astro';
import LanguageSelector from '../components/LanguageSelector.astro';
import { site } from '../site';
import { localeFromPath, pathForLocale, translatedLocales } from '../i18n/routing';
import { defaultLocale, localeTags, openGraphLocales, useTranslations, type Locale } from '../i18n/ui';

interface Props {
    title: string;
    description: string;
    /**
     * Set on pages that answer for an address rather than owning one — the 404.
     * Such a page is served under whatever URL was mistyped, so declaring a
     * canonical would nominate that typo as a real page, and an `hreflang` would
     * announce a translation of it. It says `noindex` instead and claims nothing.
     */
    noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

const pathname: string = Astro.url.pathname;
const locale: Locale = localeFromPath(pathname);
const alternates: Locale[] = translatedLocales(pathname);

function absolute(path: string): string {
    return new URL(path, Astro.site).href;
}

/**
 * The canonical URL is the page's own, in its own locale, never the other one's
 * (§25.1). Two locales pointing at one canonical would ask search engines to drop
 * one of them.
 */
const canonical: string = absolute(pathForLocale(pathname, locale));

/**
 * `x-default` names the version to serve when no declared language matches, and
 * the specification points it at English (§7.6). It is only emitted when English
 * really exists for this route.
 */
const hasDefault: boolean = alternates.includes(defaultLocale);

const t = useTranslations(locale);
---

<!doctype html>
<html lang={localeTags[locale]}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />

        {/*
          Absolute, not locale-relative: both files sit at the root of the artefact, and
          an icon is a property of the site rather than of the page asking for it.

          The .ico alone would already answer the request every browser makes without being
          asked. The PNGs are declared because nothing would otherwise reach them — the implicit
          request is for /favicon.ico and nothing else — and they are the half that stays sharp
          where the icon is drawn large: a pinned tab, a bookmark, a home screen.

          Three sizes rather than one, and none of them the 512. A browser takes the candidate
          nearest what it is about to draw, so declaring only the largest made every one of them
          fetch 173 KiB for an icon they were going to paint at 32 pixels. 256 is past anything a
          browser draws an icon at, which is where this stops.
        */}
        <link rel="icon" href="/favicon.ico" sizes="32x32" />
        <link rel="icon" type="image/png" href="/favicon-64.png" sizes="64x64" />
        <link rel="icon" type="image/png" href="/favicon-128.png" sizes="128x128" />
        <link rel="icon" type="image/png" href="/favicon-256.png" sizes="256x256" />

        {noindex && <meta name="robots" content="noindex" />}
        {!noindex && <link rel="canonical" href={canonical} />}
        {
            !noindex &&
                alternates.map((alternate: Locale) => (
                    <link
                        rel="alternate"
                        hreflang={localeTags[alternate]}
                        href={absolute(pathForLocale(pathname, alternate))}
                    />
                ))
        }
        {
            !noindex && hasDefault && (
                <link rel="alternate" hreflang="x-default" href={absolute(pathForLocale(pathname, defaultLocale))} />
            )
        }

        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:locale" content={openGraphLocales[locale]} />
        {
            alternates
                .filter((alternate: Locale) => alternate !== locale)
                .map((alternate: Locale) => (
                    <meta property="og:locale:alternate" content={openGraphLocales[alternate]} />
                ))
        }
        <meta name="twitter:card" content="summary_large_image" />

        {/*
          Arms the reveal, and it has to happen here rather than in the module below.
          A deferred script runs after first paint, so the page would render with every
          section already in place and then snatch them away to fade them back in. One
          attribute, set before anything is painted, is what makes the difference between
          a reveal and a flicker.

          Its counterpart is that nothing hides until this line runs: a reader with no
          scripting gets the whole page, laid out, unanimated. See base.css.
        */}
        <script is:inline>
            document.documentElement.dataset.revealArmed = '';
        </script>
    </head>
    <body>
        <header class="site-header">
            <a class="brand" href={pathForLocale('/', locale)}>JustDummies</a>

            {/*
              The two destinations that are not part of the story. They were in the hero,
              where they competed with the one thing that screen asks for; a link that is
              true on every page belongs in the bar that is on every page.

              The playground carries the current locale in `?lang=` (§6.4: its own interface
              now follows the site's i18n rules, not the exception that used to keep it
              English-only). There is still only one playground route in every locale — no
              `/fr/playground/` to send a reader to — so what travels is a query parameter
              the application reads at startup, not a different page.
            */}
            <nav class="site-nav" aria-label={t('nav.primary')}>
                <a href={pathForLocale('/why-justdummies', locale)}>{t('nav.why')}</a>
                <a href={`/playground/?lang=${locale}`}>{t('nav.playground')}</a>
                {/*
                  A new tab, because this one leaves the site. The playground beside it does
                  not and keeps the same tab. `noopener` is the half that matters: without it
                  the opened tab keeps a handle on this one through `window.opener`, and can
                  navigate it.
                */}
                <a href={site.repository} target="_blank" rel="noopener noreferrer">{t('nav.github')}</a>
                {/*
                  The language control is not a third destination and must not read as one.
                  The rule says so before the reader has parsed a word of it.
                */}
                <span class="divider" aria-hidden="true"></span>
                <LanguageSelector pathname={pathname} />
            </nav>
        </header>

        <slot />

        <Footer />

        <script>
            /**
             * Eases the jump to an in-page anchor, so following the chevron reads as
             * travelling rather than as the page being replaced.
             *
             * WHY NOT `scroll-behavior: smooth`. It smooths, but its curve is the
             * browser's and cannot be shaped: Chrome eases out only, which starts fast and
             * lands slowly — the opposite of the accelerate-then-settle a reader reads as
             * natural. The curve below is the same one the reveal uses, so the two
             * movements on this page belong to each other.
             *
             * The link keeps working if this never runs: the browser's own jump is what
             * happens, and `preventDefault` is only reached once a target is found. A
             * reader who asked for no motion is given the jump too — animating a scroll
             * for them would be the one thing they said not to do.
             */
            const still: MediaQueryList = window.matchMedia('(prefers-reduced-motion: reduce)');

            document.addEventListener('click', (event: MouseEvent) => {
                if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey) {
                    return;
                }

                const link: HTMLAnchorElement | null = (event.target as Element | null)?.closest?.('a[href^="#"]') ?? null;
                const id: string | undefined = link?.getAttribute('href')?.slice(1);
                const target: HTMLElement | null = id ? document.getElementById(id) : null;

                if (link === null || target === null || still.matches) {
                    return;
                }

                event.preventDefault();

                const start: number = window.scrollY;
                const end: number = start + target.getBoundingClientRect().top;
                const distance: number = end - start;
                // Long enough to read as travel, short enough not to be a wait. Scaled by
                // distance so a short hop is not given the same six hundred milliseconds
                // as a jump down the page.
                const duration: number = Math.min(900, Math.max(320, Math.abs(distance) * 0.6));
                const began: number = performance.now();

                // Accelerate, then settle: slow at both ends, quickest in the middle.
                const ease = (t: number): number => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

                const step = (now: number): void => {
                    const elapsed: number = Math.min(1, (now - began) / duration);

                    window.scrollTo(0, start + distance * ease(elapsed));

                    if (elapsed < 1) {
                        requestAnimationFrame(step);
                    } else {
                        // The address bar and the back button expect the anchor to have
                        // been followed; easing the scroll must not quietly cost that.
                        history.pushState(null, '', `#${id}`);
                    }
                };

                requestAnimationFrame(step);
            });
        </script>

        <script>
            /**
             * Reveals each marked group as it comes into view, once.
             *
             * One observer for the document rather than one per component: the things that
             * reveal belong to four components, they all reveal the same way, and a page
             * with four observers watching the same scroll is four times the work for one
             * effect.
             *
             * ONCE, NEVER AGAIN. `unobserve` on the way out is not an optimisation — a
             * group that faded back on the way up would make scrolling backwards a
             * different page from scrolling forwards, and re-reading something you have
             * already read is the most ordinary thing a reader does.
             *
             * If this never runs, the head's inline script has still armed the CSS, so the
             * page would stay hidden — which is why the arming is undone here on the way
             * in rather than trusted. `IntersectionObserver` has been everywhere for years;
             * the browser that lacks it gets the page unanimated instead of empty.
             */
            const groups: HTMLElement[] = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));

            function reveal(group: HTMLElement): void {
                group.dataset.revealed = '';
            }

            if (groups.length > 0) {
                if ('IntersectionObserver' in window) {
                    const observer: IntersectionObserver = new IntersectionObserver(
                        (entries: IntersectionObserverEntry[]) => {
                            for (const entry of entries) {
                                if (!entry.isIntersecting) {
                                    continue;
                                }

                                reveal(entry.target as HTMLElement);
                                observer.unobserve(entry.target);
                            }
                        },
                        // A group has arrived once any part of it is inside the top 85% of
                        // the viewport — early enough that the movement is over by the time
                        // the reader's eye gets there.
                        //
                        // Expressed as a margin rather than a `threshold`, because a
                        // threshold is a *fraction of the element*: a scene taller than the
                        // viewport can never be 15% visible, and would sit invisible
                        // forever. The recorded terminals are that tall.
                        { rootMargin: '0px 0px -15% 0px' },
                    );

                    for (const group of groups) {
                        observer.observe(group);
                    }

                    /**
                     * The backstop, and it is not belt-and-braces — without it the page has
                     * content nobody can ever read.
                     *
                     * That -15% shrinks the observer's root, so a group sitting in the last
                     * 15% of the *document* never enters it: the reader scrolls to the
                     * bottom, the page stops moving, and the group stays at zero opacity for
                     * good. Two of them did, and it took scrolling the built page to the end
                     * to find out — every one was revealed correctly on the way down.
                     *
                     * So the bottom of the document reveals whatever is left. Once, then it
                     * detaches.
                     */
                    const atBottom = (): void => {
                        if (window.scrollY + window.innerHeight < document.documentElement.scrollHeight - 2) {
                            return;
                        }

                        for (const group of groups) {
                            reveal(group);
                            observer.unobserve(group);
                        }

                        window.removeEventListener('scroll', atBottom);
                    };

                    window.addEventListener('scroll', atBottom, { passive: true });
                    atBottom();
                } else {
                    // No observer, no reveal — but the CSS is armed, so hand the page back
                    // rather than leaving it blank.
                    delete document.documentElement.dataset.revealArmed;
                }
            }
        </script>
    </body>
</html>

<style>
    .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--jd-space-4);
        max-width: 60rem;
        margin: 0 auto;
        padding: var(--jd-space-4);
    }

    .brand {
        color: var(--jd-text-primary);
        font-weight: 600;
        text-decoration: none;
    }

    .site-nav {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--jd-space-4);
        font-size: var(--jd-text-sm);
    }

    /* Tighter around the rule than between the links, so the rule reads as separating two
       groups rather than as a third item with space of its own. */
    .site-nav > a {
        margin-right: var(--jd-space-2);
    }

    .divider {
        width: 1px;
        align-self: stretch;
        min-height: 1rem;
        background: var(--jd-border);
    }

    /*
     * Below this width the bar cannot hold the brand and the four items — Why JustDummies,
     * Playground, GitHub, the language selector — on one line, and what it does instead is
     * wrap mid-row, dropping GitHub to a second line while the brand floats against the
     * middle of the rest. Stacking on purpose reads better than wrapping by accident.
     *
     * The number is measured, not chosen, and measured in French: §6.5 requires templates to
     * be validated against French, "the unfavourable case", and this bar is exactly that case
     * — "Pourquoi JustDummies" is wider than "Why JustDummies". Brand and nav together fit
     * down to 503 pixels of French and wrap below it (503 vs. 475 for English), so the query
     * trips a little above the wider of the two. It is deliberately not the 48rem the rest of
     * the page uses — between 512 and 768 the bar fits on one line and has no reason to stack.
     * Re-measure this — in French — the day a fifth item joins the bar.
     */
    @media (max-width: 32rem) {
        .site-header {
            flex-direction: column;
            align-items: flex-start;
            gap: var(--jd-space-2);
        }

        .site-nav {
            gap: var(--jd-space-4);
        }
    }
</style>
