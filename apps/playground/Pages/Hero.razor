@page "/hero"
@layout BareLayout
@inject IJSRuntime JS
@inject LocaleState LocaleState
@using System.Globalization
@using System.Reflection
@using JustDummies

@*
    The landing page's live hero (§9.8), which the site embeds once the visitor asks for it.

    WHAT IS EDITABLE, AND WHY THAT MUCH. The chain itself is compiled: the links are fixed,
    their arguments are not. §9.8 asks for a pre-filled expression the visitor can modify,
    and the modification that carries the demonstration is the one that changes what must be
    true of the value — a prefix, a fragment, a length.

    Changing *which* links are in the chain is the playground's job, and it needs what §10.4
    decides: a catalogue generated at build time from the assembly's metadata, and a parser
    over it. Neither exists yet. Faking it with a hand-written registry is the option §10.4
    rejects by name, so this page does not: it runs one real chain and lets its arguments
    move.

    WHAT MUST NOT BE NEUTRALISED (§9.9). Shorten the length below what the prefix and the
    fragment already require and the library refuses the declaration. That refusal is the
    demonstration defending itself, and it is displayed as the library worded it. Catching it
    to keep the home page tidy would remove the best argument on the page.

    THE TWO KINDS OF STOP. A length too short for the prefix and fragment is the library's own
    refusal, in Draw() below, and stays in its own words, untranslated (§6.4) — it names a
    JustDummies API contract, not this page's content, and it only ever appears at Generate,
    the moment the chain is declared. Typing past what this playground itself allows — 64
    characters, 10 in a fragment — is this page's own rule instead: it is enforced and
    explained the instant it is hit, in each field's setter below, because by the time Generate
    is next pressed the value has already been silently clamped and there would be nothing left
    to refuse.
*@

<div class="hero-widget">
    <div class="expression">
        <span class="fixed">Any.String()</span>
        <span class="link">.StartingWith(<input type="text" @bind:get="_prefix" @bind:set="SetPrefix" @bind:event="oninput" aria-label='@PlaygroundStrings.T(LocaleState.Current, "hero.aria.prefix")' aria-describedby="@(_capHintOwner == "prefix" ? "cap-hint" : null)" size="6" />)</span>
        <span class="link">.Containing(<input type="text" @bind:get="_fragment" @bind:set="SetFragment" @bind:event="oninput" aria-label='@PlaygroundStrings.T(LocaleState.Current, "hero.aria.contains")' aria-describedby="@(_capHintOwner == "fragment" ? "cap-hint" : null)" size="6" />)</span>
        <span class="link">.WithLength(<input type="number" @bind:get="_lengthText" @bind:set="SetLengthText" @bind:event="oninput" aria-label='@PlaygroundStrings.T(LocaleState.Current, "hero.aria.length")' aria-describedby="@(_capHintOwner == "length" ? "cap-hint" : null)" min="1" max="@MaxLength" />)</span>
        <span class="fixed">.Generate()</span>
    </div>

    <div class="controls">
        <button class="generate" @onclick="Draw">@PlaygroundStrings.T(LocaleState.Current, "hero.generate")</button>
        <span class="live">@PlaygroundStrings.T(LocaleState.Current, "hero.running", LibraryVersion)</span>
    </div>

    @*
        Always in the document, never inserted only once there is something to say: a live
        region a screen reader has not seen yet is a live region it has no reason to announce
        the first change to. Empty, it takes no visible space and every input already names it
        through aria-describedby, so it says nothing extra until a cap is actually hit.
    *@
    <p id="cap-hint" class="hint" role="status">@_capHint</p>

    @if (_refusal is null) {
        <output class="value">@_value</output>
    } else {
        <output class="refusal">@_refusal</output>
    }
</div>

@code {

    /// <summary>What this playground itself allows in <c>.WithLength(...)</c> — the library has no such limit.</summary>
    private const int MaxLength = 64;

    /// <summary>What this playground itself allows in <c>.StartingWith(...)</c>/<c>.Containing(...)</c>.</summary>
    private const int TextLimit = 10;

    private string _prefix     = "ORD-";
    private string _fragment   = "2026";
    private string _lengthText = "12";
    private int    _length     = 12;

    private string  _value   = string.Empty;
    private string? _refusal;

    /// <summary>
    ///     Set the instant a field's setter clamps or truncates a value, cleared once the field
    ///     that set it — <see cref="_capHintOwner" /> — is edited back within bounds. A
    ///     transient "you just hit a wall" cue, independent of <see cref="_refusal" />: this is
    ///     the playground's own rule, never the library's, and it is live rather than waiting
    ///     for Generate (see the comment at the top of this file for why it cannot wait).
    /// </summary>
    private string? _capHint;

    /// <summary>
    ///     Which field <see cref="_capHint" /> is currently about — <c>"prefix"</c>,
    ///     <c>"fragment"</c> or <c>"length"</c> — so only that field's <c>aria-describedby</c>
    ///     points at it. All three inputs pointing at one shared hint meant tabbing from an
    ///     over-length number straight to an untouched text field announced a 64-character
    ///     cap on a field that actually caps at 10.
    /// </summary>
    private string? _capHintOwner;

    private static string LibraryVersion { get; } = ReadLibraryVersion();

    protected override void OnInitialized() {
        Draw();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        // The frame around this page cannot know how tall it is; it is told. Reported after
        // every render because editing an argument can wrap a line or swap the value for a
        // refusal, and a frame that only measured once would clip the very message the
        // scene exists to show.
        await JS.InvokeVoidAsync("jdHeroReportHeight");
    }

    /// <summary>
    ///     Declares the chain, then draws from it.
    ///
    ///     The two are one call here, deliberately: the library refuses a contradictory
    ///     declaration when it is declared, not when it is drawn, and the whole point of the
    ///     scene is that the refusal arrives at that moment.
    ///
    ///     Nothing here checks this playground's own caps: by construction, <see cref="_prefix" />
    ///     and <see cref="_fragment" /> can never be longer than <see cref="TextLimit" />, and
    ///     <see cref="_length" /> can never exceed <see cref="MaxLength" /> — see the setters
    ///     below, which is where that limit is actually enforced and explained.
    /// </summary>
    private void Draw() {
        try {
            _value = Any.String()
                        .StartingWith(_prefix)
                        .Containing(_fragment)
                        .WithLength(_length)
                        .Generate();

            _refusal = null;
        } catch (Exception refused) when (refused is DummyException or ArgumentException) {
            // DummyException is the base of the library's own family, and catching it rather
            // than a list of framework types is the whole difference between this scene
            // working and not.
            //
            // The first version caught ArgumentException and InvalidOperationException, which
            // is what a contradiction *looks* like it should throw. The library throws
            // ConflictingAnyConstraintException, so the refusal escaped, Blazor's renderer
            // took it as an unhandled error, and the widget showed nothing at all — the
            // refusal neutralised by accident, which is exactly what §9.9 forbids. Found by
            // shortening the length in a browser rather than by reading the code.
            //
            // ArgumentException stays for the guards in front of the constraint layer, such
            // as a length below one.
            //
            // Displayed as the library worded it. A message rewritten here would be this
            // page's opinion of the library's diagnostics rather than the diagnostics.
            _refusal = refused.Message;
            _value   = string.Empty;
        }
    }

    private Task SetPrefix(string value) {
        _prefix = Cap(value, TextLimit, "prefix");

        return Task.CompletedTask;
    }

    private Task SetFragment(string value) {
        _fragment = Cap(value, TextLimit, "fragment");

        return Task.CompletedTask;
    }

    /// <summary>
    ///     Shared by <see cref="SetPrefix" /> and <see cref="SetFragment" />: truncates to
    ///     <paramref name="limit" /> characters and sets <see cref="_capHint" /> the moment a
    ///     keystroke or a paste would have gone past it.
    ///
    ///     Deliberately not paired with <c>maxlength</c> on the input, unlike a first version
    ///     of this method was. The browser enforces <c>maxlength</c> before the value ever
    ///     reaches Blazor's <c>oninput</c>, so this method never saw more than the limit and
    ///     never had anything to explain — the truncation worked, silently, which is exactly
    ///     the defect this method exists to fix. This is the sole enforcement now, the same
    ///     way <see cref="SetLengthText" /> already is the sole enforcement for the number field.
    /// </summary>
    private string Cap(string value, int limit, string owner) {
        if (value.Length > limit) {
            SetHint(owner, PlaygroundStrings.T(LocaleState.Current, "limit.text", limit));

            return value[..limit];
        }

        ClearHint(owner);

        return value;
    }

    /// <summary>
    ///     The number input's setter, bound to the raw text rather than to <c>int</c> directly.
    ///
    ///     A first version bound <c>int</c>, and Blazor's numeric binding only calls the setter
    ///     when the raw text parses as one: a pasted value outside <see cref="int" />'s range, or
    ///     valid <c>&lt;input type="number"&gt;</c> syntax an <c>int</c> cannot represent —
    ///     <c>1e3</c>, a decimal — never reached this method at all, so neither the cap nor its
    ///     explanation ever fired for exactly the values a plain keystroke cap could not catch
    ///     either. <see cref="double" /> parses everything the input's own syntax allows, so
    ///     there is somewhere left to enforce the limit against.
    ///
    ///     Every keystroke past 64 is clamped immediately, and the first one that goes too far
    ///     sets <see cref="_capHint" /> instead of silently substituting a value the visitor
    ///     never asked for. Typing a third digit past "64" changes nothing visible after that —
    ///     the value is already 64, and re-assigning 64 does not move the caret past it — which
    ///     is the whole of what "cannot type past the limit" means for a plain
    ///     <c>&lt;input type="number"&gt;</c>: its own `max` attribute only affects the spinner
    ///     arrows, never the keyboard.
    /// </summary>
    private Task SetLengthText(string value) {
        if (!double.TryParse(value, NumberStyles.Float, CultureInfo.InvariantCulture, out double parsed)) {
            // Not parseable at all — an empty field mid-edit, most often — so nothing this
            // playground enforces has anything to say about it, and the raw text is left
            // exactly as typed rather than fought.
            _lengthText = value;

            return Task.CompletedTask;
        }

        double truncated = Math.Truncate(parsed);

        if (truncated > MaxLength) {
            // The clamped value is what gets displayed back, not the raw text — otherwise a
            // paste or a third digit would still *show* past 64 even though _length itself
            // stayed capped, which is the visible half of "cannot type past the limit" this
            // setter exists to hold onto.
            SetHint("length", PlaygroundStrings.T(LocaleState.Current, "limit.length", MaxLength));
            _length     = MaxLength;
            _lengthText = MaxLength.ToString(CultureInfo.InvariantCulture);
        } else {
            ClearHint("length");
            _length     = (int)Math.Clamp(truncated, 0, MaxLength);
            _lengthText = value;
        }

        return Task.CompletedTask;
    }

    private void SetHint(string owner, string message) {
        _capHint      = message;
        _capHintOwner = owner;
    }

    /// <summary>
    ///     Only clears <see cref="_capHint" /> when <paramref name="owner" /> is the field that
    ///     set it — an edit to one field must not erase a still-true explanation of why
    ///     another one changed.
    /// </summary>
    private void ClearHint(string owner) {
        if (_capHintOwner != owner) {
            return;
        }

        _capHint      = null;
        _capHintOwner = null;
    }

    private static string ReadLibraryVersion() {
        Assembly assembly = typeof(Any).Assembly;
        string version = assembly.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion
                         ?? assembly.GetName().Version?.ToString()
                         ?? "unknown";

        int metadata = version.IndexOf('+');

        return metadata < 0 ? version : version.Substring(0, metadata);
    }

}
