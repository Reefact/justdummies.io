@page "/not-found"
@layout MainLayout
@inherits LocalizedComponent

<PageTitle>@PageTitleText</PageTitle>

<h2 class="page-title">@PlaygroundStrings.T(LocaleState.Current, "notFound.title")</h2>
<p class="lede">
    @((MarkupString)PlaygroundStrings.T(LocaleState.Current, "notFound.lede", RestartHref, SiteHomeHref))
</p>

@code {

    private string PageTitleText => $"{PlaygroundStrings.T(LocaleState.Current, "notFound.title")} — JustDummies";

    private string RestartHref => $"/playground/?lang={PlaygroundStrings.Tag(LocaleState.Current)}";

    private string SiteHomeHref => LocaleState.Current == Locale.Fr ? "/fr/" : "/";

}
