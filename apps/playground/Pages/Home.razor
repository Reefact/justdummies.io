@page "/"
@inherits LocalizedComponent
@using System.Reflection
@using JustDummies

<PageTitle>@PageTitleText</PageTitle>

<h2 class="page-title">@PlaygroundStrings.T(LocaleState.Current, "playground.title")</h2>

<p class="lede">
    @((MarkupString)PlaygroundStrings.T(LocaleState.Current, "playground.lede"))
</p>

<div class="expression">
    <span class="fixed">Any.</span><span class="editable">String().NonEmpty().StartingWith("ORD-").WithMaxLength(20)</span><span class="fixed">.Generate();</span>
</div>

<button class="generate" @onclick="Generate">@PlaygroundStrings.T(LocaleState.Current, "playground.generateAgain")</button>

<output class="value" id="generated-value">@_value</output>

<p class="version">@PlaygroundStrings.T(LocaleState.Current, "playground.generatedBy", LibraryVersion)</p>

@code {

    private string _value = string.Empty;

    private string PageTitleText => $"{PlaygroundStrings.T(LocaleState.Current, "playground.title")} — JustDummies";

    /// <summary>
    ///     The version of the library actually loaded, read from the assembly rather than written
    ///     beside it. The specification requires the playground to show which version it runs
    ///     (§11.9); reading it from the assembly is what stops that claim from going stale on the
    ///     day the package reference moves and a hard-coded string does not.
    /// </summary>
    private static string LibraryVersion { get; } = ReadLibraryVersion();

    protected override void OnInitialized() {
        base.OnInitialized();
        Generate();
    }

    private void Generate() {
        _value = Any.String()
                    .NonEmpty()
                    .StartingWith("ORD-")
                    .WithMaxLength(20)
                    .Generate();
    }

    private static string ReadLibraryVersion() {
        Assembly                             assembly     = typeof(Any).Assembly;
        AssemblyInformationalVersionAttribute? informational = assembly.GetCustomAttribute<AssemblyInformationalVersionAttribute>();
        string                               version      = informational?.InformationalVersion
                                                            ?? assembly.GetName().Version?.ToString()
                                                            ?? "unknown";

        // An informational version often carries a "+<commit sha>" suffix. The reader wants the
        // version, not the build it came from.
        int metadata = version.IndexOf('+');

        return metadata < 0 ? version : version.Substring(0, metadata);
    }

}
