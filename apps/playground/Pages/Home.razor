@page "/"
@inherits LocalizedComponent
@using System.Reflection
@using JustDummies.Playground.Catalogue
@using JustDummies.Playground.Localization

<PageTitle>@PageTitleText</PageTitle>

<h2 class="page-title">@PlaygroundStrings.T(LocaleState.Current, "playground.title")</h2>

<p class="lede">
    @((MarkupString)PlaygroundStrings.T(LocaleState.Current, "playground.lede"))
</p>

<div class="chain">
    <span class="any-prefix">Any.</span>
    @for (var i = 0; i < _links.Count; i++) {
        var index = i;
        <ChainLink @ref="_linkRefs[index]"
                   LinkIndex="index"
                   Prefix="@(index == 0 ? "" : ".")"
                   Options="@OptionsFor(index)"
                   State="_links[index]"
                   Error="@_links[index].Error"
                   OnMethodChosen="HandleMethodChosen"
                   OnArgumentChanged="HandleArgumentChanged"
                   OnDelete="HandleDelete" />
    }
</div>

<GenerateControls
    CanGenerate="_canGenerate"
    Value="@_generatedValue"
    Refusal="@_refusal"
    CodeText="@CodeText"
    OnGenerate="HandleGenerate" />

<p class="version">@PlaygroundStrings.T(LocaleState.Current, "playground.generatedBy", LibraryVersion)</p>

@code {

    private readonly List<ChainLinkState> _links = new() { new ChainLinkState() };
    private readonly Dictionary<int, ChainLink> _linkRefs = new();

    private int? _focusLinkIndex;

    private object? _currentValue;
    private string _currentTypeKey = PlaygroundCatalogue.EntryPointReceiver;
    private object? _generatedValue;
    private string? _refusal;
    private bool _canGenerate;

    private string PageTitleText => $"{PlaygroundStrings.T(LocaleState.Current, "playground.title")} — JustDummies";

    /// <summary>
    ///     The version of the library actually loaded, read from the assembly rather than written
    ///     beside it. The specification requires the playground to show which version it runs;
    ///     reading it from the assembly is what stops that claim from going stale on the day the
    ///     package reference moves and a hard-coded string does not.
    /// </summary>
    private static string LibraryVersion { get; } = ReadLibraryVersion();

    protected override void OnInitialized() {
        base.OnInitialized();

        // A step's own error, if any, was resolved in whatever locale was current when the
        // chain was last replayed — a language switch redraws every PlaygroundStrings.T(...)
        // call in this component's own markup for free, but link.Error is a plain string
        // captured at that moment, not a live lookup. ReplayChain() re-resolves it.
        LocaleState.Changed += HandleLocaleChanged;
    }

    protected override void OnDispose() {
        LocaleState.Changed -= HandleLocaleChanged;
    }

    private void HandleLocaleChanged() {
        ReplayChain();
        StateHasChanged();
    }

    private IReadOnlyList<MemberDescriptor> OptionsFor(int index) {
        if (index == 0) {
            return PlaygroundCatalogue.EntryPoints;
        }

        var previous = _links[index - 1].Chosen;
        if (previous is null) {
            return Array.Empty<MemberDescriptor>();
        }

        // Generate() is offered separately, by the persistent control below the chain
        // (specification §10.2's "regenerate immediately"), not as a chain link the visitor
        // picks from the same select as a constraint.
        return PlaygroundCatalogue.StepsFor(previous.ReturnTypeKey).Where(m => m.MethodName != "Generate").ToList();
    }

    private void HandleMethodChosen((int LinkIndex, MemberDescriptor Chosen) e) {
        _links[e.LinkIndex].ChooseMethod(e.Chosen);

        if (_links.Count > e.LinkIndex + 1) {
            _links.RemoveRange(e.LinkIndex + 1, _links.Count - e.LinkIndex - 1);
        }

        _links.Add(new ChainLinkState());
        Recompute();
    }

    private void HandleArgumentChanged((int LinkIndex, int ArgumentIndex, string Value) e) {
        _links[e.LinkIndex].SetArgument(e.ArgumentIndex, e.Value);
        Recompute();
    }

    private void HandleDelete(int linkIndex) {
        _links.RemoveRange(linkIndex, _links.Count - linkIndex);
        _links.Add(new ChainLinkState());

        // The button that was just clicked is about to leave the DOM along with the rest of
        // the truncated chain; without this, focus falls back to <body> and a keyboard user
        // has to renavigate the page from the top. OnAfterRenderAsync moves it once the fresh
        // empty step this deletion always leaves behind (at the same index) has rendered.
        _focusLinkIndex = linkIndex;
        Recompute();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (_focusLinkIndex is not { } index) {
            return;
        }

        _focusLinkIndex = null;
        if (_linkRefs.TryGetValue(index, out var link)) {
            await link.FocusAsync();
        }
    }

    private void HandleGenerate() {
        if (!_canGenerate) {
            return;
        }

        var result = PlaygroundDispatch.Invoke($"{_currentTypeKey}::Generate#0", _currentValue, Array.Empty<string>());
        if (result.HasError) {
            _refusal        = ResolveError(result);
            _generatedValue = null;
        } else {
            _generatedValue = result.Value;
            _refusal        = null;
        }
    }

    /// <summary>
    ///     Replays the chosen chain from the top after an actual change to it (a method chosen,
    ///     an argument edited, a step deleted) — the same pattern Pages/Hero.razor uses for its
    ///     fixed-shape chain, generalised to a variable-length one. Clears the last generated
    ///     value/refusal too, since a changed chain makes them stale.
    /// </summary>
    private void Recompute() {
        ReplayChain();
        _generatedValue = null;
        _refusal        = null;
        StateHasChanged();
    }

    /// <summary>
    ///     The chain-replay half of <see cref="Recompute" />, split out so a locale switch can
    ///     re-run it alone: each step's own error (an unparsable argument, or the library's own
    ///     refusal at that step) is attached to that step so it can be shown next to the field
    ///     that caused it (specification §13.4), and re-resolving it is exactly what a language
    ///     switch needs — but the chain itself, and therefore <see cref="_generatedValue" />/
    ///     <see cref="_refusal" />, has not changed, so unlike <see cref="Recompute" /> this
    ///     leaves them alone. (<see cref="_refusal" /> would not need re-resolving anyway — it
    ///     only ever holds the library's own untranslated wording, never a translated key — but
    ///     clearing it on every language switch would still make the drawn value disappear for
    ///     no reason.)
    /// </summary>
    private void ReplayChain() {
        object? current  = null;
        var     typeKey   = PlaygroundCatalogue.EntryPointReceiver;
        var     stopped   = false;

        foreach (var link in _links) {
            link.Error             = null;
            link.ErrorArgumentIndex = null;

            if (link.Chosen is null || stopped) {
                continue;
            }

            var result = PlaygroundDispatch.Invoke(link.Chosen.Key, current, link.Arguments);
            current  = result.Value;
            typeKey  = result.TypeKey;

            if (result.HasError) {
                link.Error             = ResolveError(result);
                link.ErrorArgumentIndex = result.ArgumentErrorIndex;
                stopped                = true;
            }
        }

        _currentValue   = current;
        _currentTypeKey = typeKey;
        _canGenerate    = !stopped && _links.Any(l => l.Chosen is not null);
    }

    /// <summary>
    ///     A step's failure is one of two distinct kinds (see <see cref="ChainResult" />): an
    ///     argument the visitor typed that this playground could not parse — the site's own
    ///     text, resolved through <c>PlaygroundStrings</c> in the current locale — or the
    ///     library's own refusal, shown exactly as it worded it, in every locale (specification
    ///     §6.4/§9.9).
    /// </summary>
    private string ResolveError(ChainResult result) =>
        result.ArgumentErrorKey is { } key
            ? PlaygroundStrings.T(LocaleState.Current, "argument.template", PlaygroundStrings.T(LocaleState.Current, key))
            : result.LibraryRefusalText!;

    private string CodeText {
        get {
            var chosen = _links.Where(l => l.Chosen is not null).ToList();
            if (chosen.Count == 0) {
                return "Any.Generate();";
            }

            var steps = chosen.Select(l => {
                var args = l.Chosen!.Parameters.Select((p, i) => FormatArgumentLiteral(p.TypeKey, l.Argument(i)));
                return $"{l.Chosen!.MethodName}({string.Join(", ", args)})";
            });

            return "Any." + string.Join(".", steps) + ".Generate();";
        }
    }

    /// <summary>Formats one argument the way it would need to read in real C#, so "Copy code"
    /// produces code that actually compiles rather than the raw text an input held. Only
    /// <c>string</c> (quoted), <c>char</c> (quoted) and <c>int</c> (a bare literal is already
    /// valid C#) get special forms; every other supported type is emitted as
    /// <c>TypeName.Parse("raw", CultureInfo.InvariantCulture)</c> rather than as a bare literal,
    /// since several of them (Guid, the date/time family, decimal, float, Half,
    /// Int128/UInt128, large unsigned values) have no bare-literal form, or one that needs a
    /// type-specific suffix — Parse is correct and uniform for all of them at once. The
    /// explicit invariant-culture argument matters because ArgumentParsing itself always
    /// parses in that same culture (specification-adjacent: what the playground accepted must
    /// still parse the same way once copied out) — a parameterless Parse() would instead use
    /// whatever culture the pasted code happens to run under.</summary>
    private static string FormatArgumentLiteral(string typeKey, string raw) => typeKey switch {
        ArgumentParsing.TypeKeyString  => $"\"{EscapeForStringLiteral(raw)}\"",
        ArgumentParsing.TypeKeyChar    => $"'{EscapeForCharLiteral(raw)}'",
        ArgumentParsing.TypeKeyInt32   => raw,
        // bool.Parse has no Parse(string, IFormatProvider) overload — the uniform Parse(...)
        // fallback below doesn't compile for it. A bare "true"/"false" literal is valid C#,
        // but the raw input itself might not be lowercase (bool.TryParse accepts "True"), so
        // this re-derives the canonical literal rather than trusting the raw text verbatim.
        // CodeText is rebuilt on every render regardless of whether the chain is complete —
        // GenerateControls only chooses not to display it while CanGenerate is false — so an
        // empty or not-yet-valid argument must format to something rather than throw; TryParse
        // rather than Parse is what keeps this a pure, non-throwing formatting function.
        ArgumentParsing.TypeKeyBoolean => bool.TryParse(raw, out var b) && b ? "true" : "false",
        // decimal.Parse(string, IFormatProvider) alone defaults to NumberStyles.Number, which
        // excludes AllowExponent — unlike float/double/Half, whose 2-argument Parse already
        // defaults to NumberStyles.Float. ArgumentParsing itself always parses with
        // NumberStyles.Float, so a decimal typed in exponent notation (e.g. "1e2") would
        // generate fine in the playground but throw FormatException in the copied code without
        // this explicit style.
        ArgumentParsing.TypeKeyDecimal => $"decimal.Parse(\"{EscapeForStringLiteral(raw)}\", System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture)",
        _                              => $"{ClrTypeNameFor(typeKey)}.Parse(\"{EscapeForStringLiteral(raw)}\", System.Globalization.CultureInfo.InvariantCulture)",
    };

    /// <summary>Escapes <paramref name="raw" /> for embedding in a regular (non-verbatim) C#
    /// string literal. Beyond backslash and the enclosing quote, this must also escape every
    /// character C# treats as a line terminator inside such a literal — CR, LF, NEL (U+0085),
    /// LS (U+2028), PS (U+2029) — since the playground's own parsers accept these as ordinary
    /// characters (e.g. in a <c>WithChars</c> character pool) but a physical line break between
    /// the quotes does not compile.</summary>
    private static string EscapeForStringLiteral(string raw) =>
        string.Concat(raw.Select(c => EscapeForLiteral(c) ?? (c == '"' ? "\\\"" : c.ToString())));

    private static string EscapeForCharLiteral(string raw) =>
        string.Concat(raw.Select(c => EscapeForLiteral(c) ?? (c == '\'' ? "\\'" : c.ToString())));

    /// <summary>The escape sequence for a character every C# string/char literal must escape
    /// regardless of which quote encloses it, or <c>null</c> if <paramref name="c" /> needs no
    /// such escaping (the caller still handles the enclosing quote character itself).</summary>
    private static string? EscapeForLiteral(char c) => c switch {
        '\\'     => "\\\\",
        '\r'     => "\\r",
        '\n'     => "\\n",
        '\u0085' => "\\u0085",
        '\u2028' => "\\u2028",
        '\u2029' => "\\u2029",
        _        => null,
    };

    private static string ClrTypeNameFor(string typeKey) => typeKey switch {
        ArgumentParsing.TypeKeyBoolean        => "bool",
        ArgumentParsing.TypeKeyByte           => "byte",
        ArgumentParsing.TypeKeySByte          => "sbyte",
        ArgumentParsing.TypeKeyInt16          => "short",
        ArgumentParsing.TypeKeyUInt16         => "ushort",
        ArgumentParsing.TypeKeyUInt32         => "uint",
        ArgumentParsing.TypeKeyInt64          => "long",
        ArgumentParsing.TypeKeyUInt64         => "ulong",
        ArgumentParsing.TypeKeyInt128         => "System.Int128",
        ArgumentParsing.TypeKeyUInt128        => "System.UInt128",
        ArgumentParsing.TypeKeySingle         => "float",
        ArgumentParsing.TypeKeyDouble         => "double",
        ArgumentParsing.TypeKeyHalf           => "System.Half",
        ArgumentParsing.TypeKeyDecimal        => "decimal",
        ArgumentParsing.TypeKeyGuid           => "System.Guid",
        ArgumentParsing.TypeKeyDateOnly       => "System.DateOnly",
        ArgumentParsing.TypeKeyDateTime       => "System.DateTime",
        ArgumentParsing.TypeKeyDateTimeOffset => "System.DateTimeOffset",
        ArgumentParsing.TypeKeyTimeOnly       => "System.TimeOnly",
        ArgumentParsing.TypeKeyTimeSpan       => "System.TimeSpan",
        _                                     => throw new InvalidOperationException($"no C# type name registered for '{typeKey}'"),
    };

    private static string ReadLibraryVersion() {
        Assembly                              assembly      = typeof(JustDummies.Any).Assembly;
        AssemblyInformationalVersionAttribute? informational = assembly.GetCustomAttribute<AssemblyInformationalVersionAttribute>();
        string                                version       = informational?.InformationalVersion
                                                              ?? assembly.GetName().Version?.ToString()
                                                              ?? "unknown";

        int metadata = version.IndexOf('+');
        return metadata < 0 ? version : version.Substring(0, metadata);
    }

}
