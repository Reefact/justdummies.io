@inherits LocalizedComponent
@inject IJSRuntime JS

@*
    The strip every playground page carries above .page, mirroring the site's own Base.astro:
    a way back to the site, on the left, and the language switch, on the right (§6.4 — the
    playground's own interface follows the site's i18n rules now, only the library's runtime
    messages stay in English).

    The brand link leaves this app rather than routing inside it — there is nowhere inside the
    playground that "JustDummies" would point to other than where the reader already is — so it
    goes back to the site's home page, in whichever locale this playground is currently showing
    itself in.
*@

<header class="site-header">
    <a class="brand" href="@SiteHomeHref">JustDummies</a>

    <nav>
        <a href="@WhyJustDummiesHref">@PlaygroundStrings.T(LocaleState.Current, "nav.why")</a>
        <a href="@RepositoryUrl" target="_blank" rel="noopener noreferrer">@PlaygroundStrings.T(LocaleState.Current, "nav.github")</a>

        <nav class="language-selector" aria-label='@PlaygroundStrings.T(LocaleState.Current, "language.label")'>
            <details open="@_open">
                <summary @ref="_summaryRef" @onclick="ToggleMenu" @onclick:preventDefault="true">
                    <span lang="@PlaygroundStrings.Tag(LocaleState.Current)">@PlaygroundStrings.Name(LocaleState.Current)</span>
                    <svg class="caret" viewBox="0 0 10 6" width="10" height="6" aria-hidden="true" focusable="false">
                        <path d="M1 1l4 4 4-4" />
                    </svg>
                </summary>
                <ul>
                    @foreach (Locale locale in AvailableLocales) {
                        <li>
                            @if (locale == LocaleState.Current) {
                                <span aria-current="true" lang="@PlaygroundStrings.Tag(locale)">@PlaygroundStrings.Name(locale)</span>
                            } else {
                                <button type="button" lang="@PlaygroundStrings.Tag(locale)" @onclick="() => Select(locale)">@PlaygroundStrings.Name(locale)</button>
                            }
                        </li>
                    }
                </ul>
            </details>
        </nav>
    </nav>
</header>

@code {

    /// <summary>Mirrors <c>site.repository</c> in <c>apps/site/src/site.ts</c> — the same fact, kept in the one other place a .NET project can read it from.</summary>
    private const string RepositoryUrl = "https://github.com/Reefact/just-dummies";

    private static readonly Locale[] AvailableLocales = Enum.GetValues<Locale>();

    private bool _open;

    private DotNetObjectReference<SiteHeader>? _selfReference;

    private ElementReference _summaryRef;

    /// <summary>
    ///     Set by <see cref="Select" />, consumed by the next <see cref="OnAfterRenderAsync" />.
    ///     Selecting a locale closes the menu and swaps the clicked <c>&lt;button&gt;</c> for a
    ///     non-focusable <c>&lt;span&gt;</c> in the same render — the element that had focus is
    ///     simply gone — so without this, focus falls back to the document body at the exact
    ///     moment the whole page's language changes. The Escape path already restores it (in
    ///     site-header.js, which still has a real element to hand focus back to); this is the
    ///     other way the menu closes, and needs its own way back.
    /// </summary>
    private bool _restoreFocusToSummary;

    private string SiteHomeHref => LocaleState.Current == Locale.Fr ? "/fr/" : "/";

    private string WhyJustDummiesHref => LocaleState.Current == Locale.Fr ? "/fr/why-justdummies/" : "/why-justdummies/";

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            // One listener for the document's whole lifetime, not one per open — the header
            // itself never unmounts (it lives above @Body in MainLayout), so there is exactly
            // one of these to make.
            _selfReference = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("jdSiteHeaderInit", _selfReference);
        }

        if (_restoreFocusToSummary) {
            _restoreFocusToSummary = false;
            await _summaryRef.FocusAsync();
        }
    }

    private void ToggleMenu() {
        _open = !_open;
    }

    private void Select(Locale locale) {
        _open                  = false;
        _restoreFocusToSummary = true;
        LocaleState.Set(locale);
    }

    /// <summary>
    ///     Called from site-header.js when the reader clicks away from the open menu or
    ///     presses Escape. The DOM's own `open` attribute is never touched directly by that
    ///     script — only this method is, so `_open` stays the one source of truth and a later
    ///     render can never disagree with what the reader just saw happen.
    /// </summary>
    [JSInvokable]
    public void CloseLanguageMenu() {
        if (!_open) {
            return;
        }

        _open = false;
        StateHasChanged();
    }

    protected override void OnDispose() {
        _selfReference?.Dispose();
    }

}
