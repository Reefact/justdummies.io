@inherits LocalizedComponent
@using JustDummies.Playground.Catalogue
@using JustDummies.Playground.Localization

@*
    One line of the chain the visitor is building (specification §10.2/§10.4): a native
    `<select>` offering every method valid at this point (§11.5 — never a custom widget),
    the chosen method rendered with its arguments as real inputs, a doc string that stays
    visible without hover or focus (§5.7 — no hover on mobile), a help link, and a delete
    control that truncates the chain from here on (confirmed behaviour, not a cascade
    recompute).

    The method name, its summary and its help link come from the catalogue — the library is
    their source, so they are never translated (§6.4 as corrected: content the library
    produces, at build time or at runtime, stays in the language it was written in). Every
    other piece of text here — the placeholder option, the delete/select labels, "docs" —
    is this component's own, and is translated like the rest of the playground's chrome.
*@

<div class="chain-link">
    <span class="prefix">@Prefix</span>

    <select @ref="_select" @onchange="HandleMethodChosen" value="@(State.Chosen?.Key ?? "")" aria-label="@SelectLabel">
        <option value="" disabled selected="@(State.Chosen is null)">@PlaygroundStrings.T(LocaleState.Current, "playground.chooseMethod")</option>
        @foreach (var option in Options) {
            <option value="@option.Key" selected="@(State.Chosen?.Key == option.Key)">@DisplayName(option)</option>
        }
    </select>

    @if (State.Chosen is { } chosen) {
        <span class="call">
            <span class="method-name">@chosen.MethodName</span><span class="paren">(</span>
            @for (var i = 0; i < chosen.Parameters.Count; i++) {
                var index = i;
                var parameter = chosen.Parameters[i];
                @if (i > 0) {
                    <span class="comma">, </span>
                }
                <input
                    type="@InputTypeFor(parameter.TypeKey)"
                    step="@StepFor(parameter.TypeKey)"
                    placeholder="@parameter.Placeholder"
                    aria-label="@($"{chosen.MethodName} {parameter.Name}")"
                    aria-describedby="@(DescribesInput(index) ? ErrorId : null)"
                    aria-invalid="@(DescribesInput(index) ? "true" : null)"
                    value="@State.Argument(index)"
                    @oninput="e => HandleArgumentChanged(index, e)" />
            }
            <span class="paren">)</span>
        </span>

        <button type="button" class="delete" aria-label="@PlaygroundStrings.T(LocaleState.Current, "playground.deleteStep")" @onclick="HandleDelete">−</button>

        <p class="doc">
            @chosen.Summary
            <a class="help" href="@chosen.HelpUrl" target="_blank" rel="noopener noreferrer">
                @PlaygroundStrings.T(LocaleState.Current, "playground.docs")
                <svg class="arrow" viewBox="0 0 12 12" width="10" height="10" aria-hidden="true" focusable="false">
                    <path d="M3 9L9 3M4.5 3H9v4.5" />
                </svg>
                <span class="visually-hidden">@PlaygroundStrings.T(LocaleState.Current, "state.newTab")</span>
            </a>
        </p>

        @if (HasError) {
            <p class="error" id="@ErrorId" role="status">@Error</p>
        }
    }
</div>

@code {

    [Parameter, EditorRequired] public int LinkIndex { get; set; }
    [Parameter, EditorRequired] public string Prefix { get; set; } = "Any.";
    [Parameter, EditorRequired] public IReadOnlyList<MemberDescriptor> Options { get; set; } = Array.Empty<MemberDescriptor>();
    [Parameter, EditorRequired] public ChainLinkState State { get; set; } = null!;
    [Parameter, EditorRequired] public string? Error { get; set; }

    [Parameter, EditorRequired] public EventCallback<(int LinkIndex, MemberDescriptor Chosen)> OnMethodChosen { get; set; }
    [Parameter, EditorRequired] public EventCallback<(int LinkIndex, int ArgumentIndex, string Value)> OnArgumentChanged { get; set; }
    [Parameter, EditorRequired] public EventCallback<int> OnDelete { get; set; }

    private ElementReference _select;

    /// <summary>Lets Home.razor put keyboard focus back on this link's own <c>&lt;select&gt;</c>
    /// after a deletion replaces the chain from here on with a fresh empty step — otherwise the
    /// button that triggered the deletion is gone from the DOM and focus silently falls back to
    /// &lt;body&gt;, forcing a keyboard user to renavigate the page from the top.</summary>
    public ValueTask FocusAsync() => _select.FocusAsync();

    private bool HasError => !string.IsNullOrEmpty(Error);
    private string ErrorId => $"chain-link-{LinkIndex}-error";

    /// <summary>Whether the error message should be associated with the argument at
    /// <paramref name="index" />: the offending one specifically, when the failure names one
    /// (a parse error — <see cref="ChainLinkState.ErrorArgumentIndex" />), or every argument in
    /// the step, when it does not (a library refusal, about the whole call rather than one
    /// value) — the same fallback the UI used before per-argument targeting existed.</summary>
    private bool DescribesInput(int index) =>
        HasError && (State.ErrorArgumentIndex is { } errorIndex ? errorIndex == index : true);
    private string SelectLabel => PlaygroundStrings.T(LocaleState.Current, "playground.selectAria", LinkIndex + 1);

    private static string DisplayName(MemberDescriptor member) =>
        member.Parameters.Count == 0
            ? $"{member.MethodName}()"
            : $"{member.MethodName}({string.Join(", ", member.Parameters.Select(p => p.Name))})";

    private static string InputTypeFor(string typeKey) => typeKey switch {
        "System.Int16" or "System.UInt16" or "System.Int32" or "System.UInt32" or
        "System.Int64" or "System.UInt64" or "System.Int128" or "System.UInt128" or
        "System.Byte" or "System.SByte" or
        "System.Single" or "System.Double" or "System.Half" or "System.Decimal" => "number",
        _ => "text",
    };

    /// <summary>The HTML default <c>step</c> is 1 — without overriding it, a fractional value
    /// like "1.5" parses fine but the browser still flags the control as a step mismatch.
    /// Integer type keys are left with the (correct) default.</summary>
    private static string? StepFor(string typeKey) => typeKey switch {
        "System.Single" or "System.Double" or "System.Half" or "System.Decimal" => "any",
        _ => null,
    };

    private Task HandleMethodChosen(ChangeEventArgs e) {
        var key = e.Value as string;
        var chosen = Options.FirstOrDefault(o => o.Key == key);
        return chosen is null ? Task.CompletedTask : OnMethodChosen.InvokeAsync((LinkIndex, chosen));
    }

    /// <summary>Truncates any argument's raw text to <see cref="ArgumentParsing.SandboxTextLengthHardCeiling" />
    /// before it ever reaches <see cref="ChainLinkState" /> — a pasted multi-megabyte value
    /// would otherwise be re-parsed, replayed through the library and re-embedded into
    /// <c>CodeText</c> on every keystroke. Applied regardless of the parameter's own type, not
    /// only <c>string</c>: every non-numeric type key (<c>Guid</c>, <c>Char</c>, the
    /// date/time family) renders as a plain <c>type="text"</c> input too (see
    /// <see cref="InputTypeFor" />) and is just as pasteable. A legitimate value of any of
    /// those types is always far under this ceiling, so this never touches one. This is
    /// deliberately a much higher ceiling than the visible <see cref="ArgumentParsing.SandboxTextLengthLimit" />
    /// that <see cref="ArgumentParsing.TryParse" /> itself enforces — truncating to that lower,
    /// visible limit here would mean every over-limit paste always arrives at
    /// <c>TryParse</c> already exactly at the limit, so its "too long" error could never
    /// actually fire.</summary>
    private Task HandleArgumentChanged(int argumentIndex, ChangeEventArgs e) {
        var raw = e.Value as string ?? "";
        if (raw.Length > ArgumentParsing.SandboxTextLengthHardCeiling) {
            raw = raw[..ArgumentParsing.SandboxTextLengthHardCeiling];
        }

        return OnArgumentChanged.InvokeAsync((LinkIndex, argumentIndex, raw));
    }

    private Task HandleDelete() => OnDelete.InvokeAsync(LinkIndex);

}
