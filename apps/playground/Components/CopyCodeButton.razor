@inherits LocalizedComponent
@inject IJSRuntime JS
@using JustDummies.Playground.Localization

@*
    "Copy the complete code" (specification §10.2), sitting on the bar that prints the very line
    it copies.

    WHERE IT IS NOT: on the code block above that bar. It hung off the block's top-right corner
    for a while, and that was the wrong corner — the block shows the chain the way it is built,
    wrapped over lines with its arguments in fields and its documentation in comments, while this
    hands over the one line that compiles. A control whose whole promise is "you get exactly what
    you see" must not be attached to the one thing showing something else. Home.razor's CodeSegments
    is what makes that promise literal: the bar draws the runs, this copies them concatenated.

    Never disabled, because it is never offered when there is nothing to copy — the bar it lives on
    is not drawn at all until the chain has a step in it (ADR-0004: a control appears only when it
    can act).

    §13.4 asks copy buttons for accessible feedback, and there are two halves of it here: the live
    region below, and the glyph swapping to a tick for anyone who is watching rather than listening.
*@

<button type="button"
        class="copy"
        data-copied="@(_copyStatus == CopyStatus.Copied ? "" : null)"
        @onclick="HandleCopy">
    @if (_copyStatus == CopyStatus.Copied) {
        <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" focusable="false">
            <path d="M3 8.5 6.5 12 13 4.5" />
        </svg>
    } else {
        <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" focusable="false">
            <rect x="5.75" y="5.75" width="8.5" height="8.5" rx="1.5" />
            <path d="M11 3.75V3.25A1.5 1.5 0 0 0 9.5 1.75h-6A1.5 1.5 0 0 0 2 3.25v6a1.5 1.5 0 0 0 1.5 1.5H4" />
        </svg>
    }
    <span>@PlaygroundStrings.T(LocaleState.Current, "playground.copyCode")</span>
</button>

<span class="visually-hidden" role="status" aria-live="polite">@CopyStatusText</span>

@code {

    [Parameter, EditorRequired] public string CodeText { get; set; } = "";

    private enum CopyStatus { None, Copied, Failed }

    private CopyStatus _copyStatus;
    private string?    _lastCopiedCodeText;

    /// <summary>The chain the visitor last copied can change under them — an edited argument or a
    /// newly chosen method both rewrite <see cref="CodeText" /> without the button being touched.
    /// Without this, the tick and the "copied to clipboard" announcement would outlive the
    /// clipboard contents they are about.</summary>
    protected override void OnParametersSet() {
        if (_copyStatus == CopyStatus.Copied && CodeText != _lastCopiedCodeText) {
            _copyStatus = CopyStatus.None;
        }
    }

    private string CopyStatusText => _copyStatus switch {
        CopyStatus.Copied => PlaygroundStrings.T(LocaleState.Current, "playground.copied"),
        CopyStatus.Failed => PlaygroundStrings.T(LocaleState.Current, "playground.copyFailed"),
        _                 => "",
    };

    /// <summary>Clears the live region before writing, so a repeated copy — success or failure —
    /// is still a DOM change a screen reader announces, not a no-op update to text that already
    /// reads the same. Also catches a rejected clipboard write (denied permission, insecure
    /// context, ...): otherwise the awaited interop call throws and the visitor sees Blazor's own
    /// error banner instead of a usable status.</summary>
    private async Task HandleCopy() {
        _copyStatus = CopyStatus.None;
        StateHasChanged();

        try {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", CodeText);
            _copyStatus         = CopyStatus.Copied;
            _lastCopiedCodeText = CodeText;
        } catch (JSException) {
            _copyStatus = CopyStatus.Failed;
        }
    }

}
