@inherits LocalizedComponent
@inject IJSRuntime JS
@using JustDummies.Playground.Localization

@*
    Generate/regenerate, copy the full code, and show the result — the value or the
    library's own refusal, displayed verbatim and never neutralised (specification §9.9).
    The refusal text itself (Refusal) is the library's own wording and is never translated;
    every other string here is this component's own and follows the site's i18n rules.
*@

<div class="generate-controls">
    <button type="button" class="generate" disabled="@(!CanGenerate)" @onclick="HandleGenerate">
        @(HasResult ? PlaygroundStrings.T(LocaleState.Current, "playground.generateAgain") : PlaygroundStrings.T(LocaleState.Current, "playground.generate"))
    </button>

    @if (CanGenerate) {
        <div class="code-row">
            <code class="code-text">@CodeText</code>
            <button type="button" class="copy" @onclick="HandleCopy">
                @PlaygroundStrings.T(LocaleState.Current, "playground.copyCode")
            </button>
        </div>
    }

    <span class="visually-hidden" role="status" aria-live="polite">@CopyStatusText</span>

    <div class="result" role="status" aria-live="polite">
        @if (Refusal is not null) {
            <output class="refusal">@Refusal</output>
        } else if (HasResult) {
            <output class="value">@DisplayValue(Value)</output>
        }
    </div>
</div>

@code {

    [Parameter, EditorRequired] public bool CanGenerate { get; set; }
    [Parameter] public object? Value { get; set; }
    [Parameter] public string? Refusal { get; set; }
    [Parameter, EditorRequired] public string CodeText { get; set; } = "";
    [Parameter, EditorRequired] public EventCallback OnGenerate { get; set; }

    private enum CopyStatus { None, Copied, Failed }

    private CopyStatus _copyStatus;
    private string? _lastCopyStatusCodeText;

    private bool HasResult => Value is not null || Refusal is not null;

    /// <summary>The chain the visitor last copied can change under them — an edited argument or
    /// a newly chosen method both rewrite <see cref="CodeText" /> without the visitor touching
    /// Copy again. Without this, "copied to clipboard" would keep being announced/displayed
    /// after the clipboard's actual contents have gone stale.</summary>
    protected override void OnParametersSet() {
        if (_copyStatus == CopyStatus.Copied && CodeText != _lastCopyStatusCodeText) {
            _copyStatus = CopyStatus.None;
        }
    }

    private string CopyStatusText => _copyStatus switch {
        CopyStatus.Copied => PlaygroundStrings.T(LocaleState.Current, "playground.copied"),
        CopyStatus.Failed => PlaygroundStrings.T(LocaleState.Current, "playground.copyFailed"),
        _                  => "",
    };

    private Task HandleGenerate() => OnGenerate.InvokeAsync();

    /// <summary>Clears the live region before writing, so a repeated copy — success or
    /// failure — is still a DOM change a screen reader announces, not a no-op update to text
    /// that already reads the same. Also catches a rejected clipboard write (denied
    /// permission, insecure context, ...): otherwise the awaited JS interop call throws and
    /// the visitor sees Blazor's own error banner instead of a usable status.</summary>
    private async Task HandleCopy() {
        _copyStatus = CopyStatus.None;
        StateHasChanged();

        try {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", CodeText);
            _copyStatus             = CopyStatus.Copied;
            _lastCopyStatusCodeText = CodeText;
        } catch (JSException) {
            _copyStatus = CopyStatus.Failed;
        }
    }

    /// <summary>A generated <c>string</c>/<c>char</c> can legitimately be empty or made only of
    /// control characters, which would otherwise render as nothing at all inside &lt;output&gt;.
    /// Quoting mirrors how Home.razor already formats these two types for the copied code.</summary>
    private static string DisplayValue(object? value) => value switch {
        string s => $"\"{s}\"",
        char c   => $"'{c}'",
        _        => value?.ToString() ?? "",
    };

}
