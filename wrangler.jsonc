{
    "$schema": "./node_modules/wrangler/config-schema.json",

    "name": "justdummies-site",
    "compatibility_date": "2026-07-01",

    // The site answers on justdummies.io and nowhere else.
    //
    // Left at its default, this Worker also answers on
    // justdummies-site.<subdomain>.workers.dev — the same bytes under a second
    // hostname, which search engines index, visitors bookmark and links point at,
    // none of it intended. Turning it off is the only way to make the custom domain
    // the site's address rather than one of its addresses.
    //
    // The cost is real and lands on the deployment guide: a first deployment then
    // has no hostname at all until step 8 attaches the domain. Step 5 says what to
    // do about that.
    //
    // This does NOT govern preview URLs. Those are <version>-<name>.<subdomain>
    // .workers.dev, controlled by the separate "preview_urls" field, which is why
    // `pnpm preview` is not what this line switches off. Whether a preview URL still
    // resolves once the production hostname is gone is stated in ADR-0002 as
    // unverified, and the check that settles it is written there.
    "workers_dev": false,

    // There IS a script now, and it took an ADR to put it here — ADR-0010.
    //
    // What this file said until then, and why it was right to say it: requests served
    // as static assets are free and unmetered, requests that invoke a Worker script
    // count against the plan's request quota, and exhausting that quota answers 429.
    // The difference between a script and no script was the difference between a site
    // that degrades and a site that goes down.
    //
    // What changed is not the appetite for a script, it is what a script costs when it
    // is kept off the path. A request matching a static asset is served from the asset
    // store WITHOUT invoking the script; a request matching none is answered by
    // "not_found_handling", also without invoking it. Only the paths named in
    // "run_worker_first" below reach the script at all. So the quota this script can
    // exhaust is its own, and exhausting it stops the measurement — not a page, not an
    // asset, not the 404.
    //
    // That confinement is the whole basis of the decision. Widening
    // "run_worker_first", or dropping it, puts the site back in front of the quota and
    // is not a change to make without reopening ADR-0010.
    //
    // The other case that will tempt a script is still shareable playground URLs, and
    // the answer there is still no: encoding the state in the URL fragment costs
    // nothing on the server.
    "main": "worker/index.ts",

    // Where the dimensioned events land (§15.2). Free-plan allowance is 100,000 data
    // points a day, and a data point here is one visitor copying one install command.
    "analytics_engine_datasets": [
        {
            "binding": "MEASUREMENT",
            "dataset": "justdummies_measurement"
        }
    ],

    "assets": {
        "directory": "./dist/",

        // The one path that reaches the Worker. Everything absent from this list keeps
        // the asset-first behaviour described above, which is what makes the script
        // unable to affect the site. An exact path, not a glob: the collector answers
        // on one address and has no second one to grow into.
        "run_worker_first": ["/_event"],

        // "404-page" serves the nearest 404.html for a request that matches no
        // asset. "Nearest" is what makes it right here: /fr/... falls back to
        // /fr/404.html and gets a French page, while everything else gets /404.html.
        //
        // Not "single-page-application": this site is many pages, and that mode
        // would answer 200 with the home page for every mistyped URL, which is
        // invisible to a visitor and poison to a search engine. The playground is
        // the one part that does need a shell fallback, and it gets it from the
        // rewrite in _redirects rather than from a mode that would apply site-wide.
        "not_found_handling": "404-page"
    }
}
