<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Reflects over the referenced JustDummies assembly and its shipped XML documentation,
    and emits the two files packages/playground-catalogue/Generated depends on
    (specification §10.4). This project is the only place in the repository that reflects
    over the library — it runs at build time, on the .NET SDK, never in the browser, so
    §10.8's "no reflection in the playground's own code" never applies to it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>JustDummies.PlaygroundCatalogueGenerator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- System.Text.Json ships in the net10.0 shared framework; no separate package needed.
         NuGet does not copy a package's .xml doc file to a consuming project's output by
         default, only its .dll — CopyJustDummiesXmlDoc below copies it from wherever the
         resolved reference itself actually lives. -->
    <PackageReference Include="JustDummies" />
  </ItemGroup>

  <!-- Makes JustDummies.xml resolvable next to JustDummies.dll at runtime (typeof(Any).Assembly.Location's
       directory), the same way Program.cs expects to find it. Reads the doc file from beside the
       .dll NuGet actually resolved for this project's TFM (@(ReferencePath), populated by
       ResolveAssemblyReferences before Build), rather than guessing a TFM folder name under the
       package's NuGet cache — the library ships more than one target (net8.0, netstandard2.0,
       and potentially others in a future release), and a hard-coded preference would silently
       drift from whichever one NuGet actually picked. -->
  <Target Name="CopyJustDummiesXmlDoc" AfterTargets="ResolveAssemblyReferences" BeforeTargets="Build">
    <ItemGroup>
      <_JustDummiesReference Include="@(ReferencePath)" Condition="'%(ReferencePath.NuGetPackageId)' == 'JustDummies'" />
      <_JustDummiesXmlDoc Include="$([System.IO.Path]::ChangeExtension('%(_JustDummiesReference.Identity)', '.xml'))" />
    </ItemGroup>
    <Copy SourceFiles="@(_JustDummiesXmlDoc)" DestinationFolder="$(OutDir)" Condition="Exists('%(_JustDummiesXmlDoc.Identity)')" />
  </Target>

  <ItemGroup>
    <!-- The -core project only, never packages/playground-catalogue itself: that project's
         Generated/ is this generator's own output, and referencing it here would mean a stale
         committed dispatch file (e.g. after a JustDummies release removes a method it still
         calls) has to compile before the generator can run to replace it — the exact bootstrap
         deadlock this split exists to avoid. Reused so the generator's notion of "a parameter
         type it can emit" never drifts from the playground's own parser
         (ArgumentParsing.KnownTypeKeys). MemberDescriptor/ChainStep/ChainResult are never
         referenced as compiled types here — the emitters below write them out as text. -->
    <ProjectReference Include="..\..\packages\playground-catalogue-core\JustDummies.Playground.Catalogue.Core.csproj" />
  </ItemGroup>

</Project>
