<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The build-time bridge between the playground and the library it demonstrates
    (specification §10.4). `Generated/` holds two files produced by
    tools/playground-catalogue from the referenced JustDummies assembly's metadata:
    plain descriptors that drive the UI, and a dispatch table of ordinary, statically
    typed call sites that execute a chosen chain. Nothing here reflects at runtime —
    the trimmer sees real call sites and keeps them (§10.8).

    This project is never published on its own; it exists to be referenced by
    apps/playground. Core.cs (MemberDescriptor, ChainStep, ChainResult, and the partial
    PlaygroundCatalogue/PlaygroundDispatch declarations the Generated/ files complete)
    stays here rather than in the sibling -core project: C# partial class parts must share
    one assembly, and Generated/ is exactly the other half of those same partial classes.
    ArgumentParsing lives in -core instead, since it has no such constraint and the
    generator needs to reference it directly (see that project's own comment).
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>JustDummies.Playground.Catalogue</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JustDummies" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\playground-catalogue-core\JustDummies.Playground.Catalogue.Core.csproj" />
  </ItemGroup>

</Project>
